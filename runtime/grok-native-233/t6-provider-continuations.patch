+
+pub(crate) fn ancestors(thread: ThreadId) -> Vec<ThreadId> {
+    let values = registry()
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    let mut result = Vec::new();
+    let mut next = Some(thread);
