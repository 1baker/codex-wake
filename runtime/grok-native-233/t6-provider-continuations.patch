diff --git a/codex-rs/tui/src/app_server_session.rs b/codex-rs/tui/src/app_server_session.rs
index 511e9716b8..9db812e24a 100644
--- a/codex-rs/tui/src/app_server_session.rs
+++ b/codex-rs/tui/src/app_server_session.rs
@@ -1384,0 +1385,92 @@ impl AppServerSession {
+    pub(crate) fn inference_default_model(&self) -> Option<String> {
+        self.available_models
+            .iter()
+            .find(|model| model.is_default && model.inference_selection.is_none())
+            .map(|model| model.model.clone())
+    }
+
+    pub(crate) fn stage_inference_continuation(
+        &mut self,
+        source: ThreadId,
+        config: Config,
+        events: AppEventSender,
+    ) {
+        let read_id = self.next_request_id();
+        let request_id = self.next_request_id();
+        let handle = self.request_handle.clone();
+        let params = ThreadForkParams {
+            thread_id: source.to_string(),
+            provider_continuation: true,
+            model: config.model.clone(),
+            model_provider: Some(config.model_provider_id.clone()),
+            config: config.inference_selection.as_ref().map(|selection| {
+                HashMap::from([(
+                    "inference_selection".to_owned(),
+                    serde_json::json!(selection),
+                )])
+            }),
+            exclude_turns: true,
+            ..Default::default()
+        };
+        tokio::spawn(async move {
+            let result = async {
+                let before = handle
+                    .request_typed::<ThreadReadResponse>(ClientRequest::ThreadRead {
+                        request_id: read_id,
+                        params: ThreadReadParams {
+                            thread_id: source.to_string(),
+                            include_turns: false,
+                        },
+                    })
+                    .await
+                    .map_err(|error| error.to_string())?;
+                let response = handle
+                    .request_typed::<ThreadForkResponse>(ClientRequest::ThreadFork {
+                        request_id,
+                        params,
+                    })
+                    .await
+                    .map_err(|error| error.to_string())?;
+                provider_selection::validate_continuation(
+                    source,
+                    &before.thread,
+                    &response,
+                    &config,
+                )?;
+                Ok(response)
+            }
+            .await;
+            events.send(crate::app_event::AppEvent::InferenceContinuationReady {
+                source_thread_id: source,
+                config: Box::new(config),
+                result,
+            });
+        });
+    }
+
+    pub(crate) async fn finish_inference_continuation(
+        &mut self,
+        response: ThreadForkResponse,
+        local_settings: &LocalSettings,
+        config: &Config,
+    ) -> Result<AppServerStartedThread> {
+        let parent = response.thread.parent_thread_id.clone();
+        let mut started = started_thread_from_fork_response(
+            response,
+            local_settings,
+            config,
+            self.thread_params_mode(),
+        )
+        .await?;
+        if let Some(parent) = parent.and_then(|id| ThreadId::from_string(&id).ok()) {
+            started.session.fork_parent_title = self
+                .fork_parent_title_from_app_server(Some(&parent.to_string()))
+                .await;
+            if self.task_tools_available(parent) {
+                started.task_tools_available = true;
+                self.remember_task_tool_thread(started.session.thread_id);
+            }
+        }
+        Ok(started)
+    }
+
diff --git a/codex-rs/tui/src/app_server_session/provider_selection.rs b/codex-rs/tui/src/app_server_session/provider_selection.rs
index e5a0c9082b..f7cf95fc8b 100644
--- a/codex-rs/tui/src/app_server_session/provider_selection.rs
+++ b/codex-rs/tui/src/app_server_session/provider_selection.rs
@@ -66,0 +67,23 @@ impl AppServerSession {
+
+/// Reject an older server's ordinary independent fork before the UI can adopt it.
+pub(super) fn validate_continuation(
+    source: codex_protocol::ThreadId,
+    before: &codex_app_server_protocol::Thread,
+    response: &codex_app_server_protocol::ThreadForkResponse,
+    config: &Config,
+) -> Result<(), String> {
+    let source = source.to_string();
+    if before.id != source
+        || response.thread.parent_thread_id.as_deref() != Some(source.as_str())
+        || response.thread.forked_from_id.as_deref() != Some(source.as_str())
+        || response.thread.session_id != before.session_id
+        || response.model_provider != config.model_provider_id
+        || Some(response.model.as_str()) != config.model.as_deref()
+    {
+        return Err(format!(
+            "Server did not preserve continuation identity; successor {} remains unadopted",
+            response.thread.id
+        ));
+    }
+    Ok(())
+}
diff --git a/codex-rs/tui/src/app_server_session/provider_selection_tests.rs b/codex-rs/tui/src/app_server_session/provider_selection_tests.rs
index 1322067ff1..eb00be2d18 100644
--- a/codex-rs/tui/src/app_server_session/provider_selection_tests.rs
+++ b/codex-rs/tui/src/app_server_session/provider_selection_tests.rs
@@ -275,0 +276,50 @@ async fn resume_discovers_other_providers_but_rejects_mismatched_resume() -> Res
+
+#[tokio::test]
+async fn staged_selection_keeps_native_lineage_and_rejects_independent_fork() -> Result<()> {
+    let home = tempfile::tempdir()?;
+    write_provider_config(home.path())?;
+    let config = ConfigBuilder::default()
+        .codex_home(home.path().to_path_buf())
+        .build()
+        .await?;
+    let mut server = crate::start_embedded_app_server_for_picker(&config).await?;
+    let started = server.start_thread(&config).await?;
+    let source = started.session.thread_id;
+    let before = server.thread_read(source, false).await?;
+    let (sender, mut events) = tokio::sync::mpsc::unbounded_channel();
+    server.stage_inference_continuation(source, config.clone(), AppEventSender::new(sender));
+    let event = tokio::time::timeout(std::time::Duration::from_secs(10), events.recv())
+        .await?
+        .expect("selection result");
+    let crate::app_event::AppEvent::InferenceContinuationReady {
+        source_thread_id,
+        result,
+        ..
+    } = event
+    else {
+        panic!("expected selection response")
+    };
+    assert_eq!(source_thread_id, source);
+    let response = result.map_err(color_eyre::eyre::Error::msg)?;
+    assert_eq!(
+        response.thread.parent_thread_id.as_deref(),
+        Some(before.id.as_str())
+    );
+    assert_eq!(response.thread.session_id, before.session_id);
+    for alteration in 0..5 {
+        let mut legacy = response.clone();
+        match alteration {
+            0 => legacy.thread.parent_thread_id = None,
+            1 => legacy.thread.session_id = codex_protocol::ThreadId::new().to_string(),
+            2 => legacy.thread.forked_from_id = None,
+            3 => legacy.model_provider = "other-provider".into(),
+            _ => legacy.model = "other-model".into(),
+        }
+        assert!(
+            provider_selection::validate_continuation(source, &before, &legacy, &config).is_err()
+        );
+    }
+    assert!(provider_selection::validate_continuation(source, &before, &response, &config).is_ok());
+    server.shutdown().await?;
+    Ok(())
+}
