new file mode 100644
index 0000000000..7bc516da26
--- /dev/null
+++ b/codex-rs/core/src/thread_manager/provider_continuation.rs
@@ -0,0 +1,989 @@
+//! Portable provider handoffs and their native admission fence.
+//!
+//! This journal records lifecycle/identity, never credentials or spending. The
+//! original controller remains the only owner of the cumulative allowance.
+use super::*;
+use crate::agent::control::LocalAgentRuntime;
+use codex_protocol::inference_selection::InferenceSelectionSnapshot;
+use codex_protocol::models::{ContentItem, ResponseItem};
+use serde::{Deserialize, Serialize};
+use sha2::{Digest, Sha256};
+use std::collections::{BTreeMap, HashSet};
+use std::io::{Read, Write};
+use std::sync::{Mutex, OnceLock};
+
+#[derive(Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Record {
+    version: u32,
+    source: ThreadId,
+    successor: ThreadId,
+    session_id: String,
+    source_provider: String,
+    source_selection: Option<InferenceSelectionSnapshot>,
+    target_provider: String,
+    target_model: String,
+    target_selection: Option<InferenceSelectionSnapshot>,
+    state: String,
+    authority_revision: Option<String>,
+    context_revision: Option<String>,
+    #[serde(default)]
+    held_reason: Option<String>,
+}
+
+fn held(message: &str) -> CodexErr {
+    CodexErr::InvalidRequest(format!("Provider continuation held: {message}"))
+}
+
+fn controllers() -> &'static Mutex<HashMap<ThreadId, LocalAgentRuntime>> {
+    static VALUE: OnceLock<Mutex<HashMap<ThreadId, LocalAgentRuntime>>> = OnceLock::new();
+    VALUE.get_or_init(Mutex::default)
+}
+
+fn path(config: &Config, source: ThreadId) -> PathBuf {
+    config
+        .codex_home
+        .join("provider_continuations")
+        .join(format!("{source}.json"))
+        .to_path_buf()
+}
+
+fn read(config: &Config, source: ThreadId) -> CodexResult<Option<Record>> {
+    let path = path(config, source);
+    let mut options = std::fs::OpenOptions::new();
+    options.read(true);
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::OpenOptionsExt;
+        options.custom_flags(libc::O_NOFOLLOW);
+    }
+    let file = match options.open(path) {
+        Ok(file) => file,
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => return Ok(None),
+        Err(_) => return Err(held("cannot read native handoff record")),
+    };
+    let meta = file
+        .metadata()
+        .map_err(|_| held("cannot inspect native handoff record"))?;
+    if !meta.is_file() || meta.len() > 65536 {
+        return Err(held("invalid native handoff record"));
+    }
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::MetadataExt;
+        if meta.uid() != unsafe { libc::geteuid() } || meta.mode() & 0o077 != 0 {
+            return Err(held("native handoff record is not private and owned"));
+        }
+    }
+    let mut bytes = Vec::new();
+    file.take(65537)
+        .read_to_end(&mut bytes)
+        .map_err(|_| held("cannot read native handoff record"))?;
+    let record: Record =
+        serde_json::from_slice(&bytes).map_err(|_| held("malformed native handoff record"))?;
+    if record.version != 1
+        || record.source != source
+        || !matches!(
+            record.state.as_str(),
+            "staged" | "preparing" | "ready" | "held"
+        )
+    {
+        return Err(held("unsupported native handoff record"));
+    }
+    Ok(Some(record))
+}
+
+fn write(config: &Config, record: &Record, create: bool) -> CodexResult<()> {
+    let path = path(config, record.source);
+    let directory = path.parent().ok_or_else(|| held("invalid journal path"))?;
+    std::fs::create_dir_all(directory)
+        .map_err(|_| held("cannot create native handoff directory"))?;
+    let meta = std::fs::symlink_metadata(directory)
+        .map_err(|_| held("cannot inspect native handoff directory"))?;
+    if !meta.is_dir() || meta.file_type().is_symlink() {
+        return Err(held("invalid native handoff directory"));
+    }
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::{MetadataExt, PermissionsExt};
+        if meta.uid() != unsafe { libc::geteuid() } {
+            return Err(held("native handoff directory is not owned"));
+        }
+        std::fs::set_permissions(directory, std::fs::Permissions::from_mode(0o700))
+            .map_err(|_| held("cannot protect native handoff directory"))?;
+    }
+    let mut file = tempfile::NamedTempFile::new_in(directory)
+        .map_err(|_| held("cannot stage native handoff record"))?;
+    serde_json::to_writer(file.as_file_mut(), record)
+        .map_err(|_| held("cannot encode native handoff record"))?;
+    file.flush()
+        .and_then(|_| file.as_file().sync_all())
+        .map_err(|_| held("cannot sync native handoff record"))?;
+    if create {
+        file.persist_noclobber(&path)
+            .map_err(|_| held("source already has a handoff; inspect its successor"))?;
+    } else {
+        file.persist(&path)
+            .map_err(|_| held("cannot commit native handoff record"))?;
+    }
+    #[cfg(unix)]
+    std::fs::File::open(directory)
+        .and_then(|file| file.sync_all())
+        .map_err(|_| held("cannot sync native handoff directory"))?;
+    Ok(())
+}
+
+/// Runs in the source submission queue, ordered with all native turn starts.
+pub(crate) async fn stage(
+    session: &Session,
+    successor: ThreadId,
+    target_provider: String,
+    target_model: String,
+    target_selection: Option<InferenceSelectionSnapshot>,
+) -> CodexResult<()> {
+    let config = session.get_config().await;
+    let record = Record {
+        version: 1,
+        source: session.thread_id,
+        successor,
+        session_id: session.services.agent_control.identity().to_string(),
+        source_provider: config.model_provider_id.clone(),
+        source_selection: config.inference_selection.clone(),
+        target_provider,
+        target_model,
+        target_selection,
+        state: "staged".into(),
+        authority_revision: None,
+        context_revision: None,
+        held_reason: None,
+    };
+    {
+        let mut values = controllers()
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if values.len() >= 8192 {
+            return Err(held("live handoff capacity reached"));
+        }
+        write(&config, &record, true)?;
+        values.insert(
+            session.thread_id,
+            session.services.local_agent_runtime.clone(),
+        );
+    }
+    Ok(())
+}
+
+/// A persisted transition without its original live allowance is a hold, not
+/// permission to construct a new zero-spend controller after restart/unload.
+pub(crate) async fn check_admission(session: &Session) -> CodexResult<()> {
+    let config = session.get_config().await;
+    let mut ancestors = crate::governor_guard::ancestors(session.thread_id);
+    let root = ThreadId::from_string(&session.services.agent_control.identity().to_string())
+        .map_err(|_| held("original session identity unavailable"))?;
+    if !ancestors.contains(&root) {
+        ancestors.push(root);
+    }
+    for source in ancestors {
+        let Some(record) = read(&config, source)? else {
+            continue;
+        };
+        let original = controllers()
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .get(&source)
+            .cloned();
+        if original.as_ref().is_none_or(|original| {
+            !original.shares_task_authority(&session.services.local_agent_runtime)
+        }) || record.session_id != session.services.agent_control.identity().to_string()
+        {
+            return Err(held(
+                "original cumulative allowance is not live; recovery authority required",
+            ));
+        }
+        if session.thread_id == source {
+            return Err(held(&format!(
+                "source history is retained; successor {} is {}",
+                record.successor, record.state
+            )));
+        }
+        if record.state == "staged" {
+            continue;
+        }
+        if record.state != "ready"
+            || !crate::governor_guard::is_descendant(session.thread_id, record.successor)
+        {
+            return Err(held("source branch has reached its handoff boundary"));
+        }
+    }
+    Ok(())
+}
+
+/// A native-owned, ready continuation is a per-thread route, not a global
+/// profile mutation. Cold or unresolved authority still fails admission.
+pub(crate) async fn ready_openai_route(session: &Session) -> CodexResult<bool> {
+    let config = session.get_config().await;
+    if config.model_provider_id != "openai"
+        || config.inference_selection.is_some()
+        || config.model_provider.wire_api != codex_model_provider_info::WireApi::Responses
+    {
+        return Ok(false);
+    }
+    for source in crate::governor_guard::ancestors(session.thread_id) {
+        if source == session.thread_id {
+            continue;
+        }
+        if let Some(record) = read(&config, source)?
+            && record.successor == session.thread_id
+            && record.state == "ready"
+            && record.target_provider == "openai"
+            && record.target_selection.is_none()
+            && record.context_revision.is_some()
+            && record.authority_revision.is_some()
+        {
+            check_admission(session).await?;
+            return Ok(true);
+        }
+    }
+    Ok(false)
+}
+
+fn digest(value: &impl Serialize) -> CodexResult<String> {
+    let bytes = serde_json::to_vec(value).map_err(|_| held("cannot attribute portable context"))?;
+    Ok(format!("{:x}", Sha256::digest(bytes)))
+}
+
+const PORTABLE_PREFIX: &str = "Portable continuation from source thread ";
+
+#[derive(Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+struct PortableToolResult {
+    call_id: String,
+    tool: String,
+    result: String,
+    result_revision: String,
+    truncated: bool,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    source_thread_id: Option<ThreadId>,
+}
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+struct PortableCheckpoint {
+    source_thread_id: ThreadId,
+    objective_and_constraints: Vec<String>,
+    recent_public_context: Vec<String>,
+    completed_tool_results: Vec<PortableToolResult>,
+}
+
+fn portable_header(source: ThreadId) -> String {
+    format!(
+        "Portable continuation from source thread {source}. Preserve the objective and constraints below. Completed tool results are historical records: do not replay their actions. Opaque provider state and older public commentary remain in the source history."
+    )
+}
+
+fn credential_bearing(text: &str) -> bool {
+    let lower = text.to_ascii_lowercase();
+    [
+        "bearer ",
+        "\"access_token\":",
+        "\"refresh_token\":",
+        "-----begin private key",
+    ]
+    .iter()
+    .any(|marker| lower.contains(marker))
+}
+
+fn push_portable_result(
+    results: &mut Vec<PortableToolResult>,
+    result: PortableToolResult,
+) -> CodexResult<()> {
+    if result.source_thread_id.is_none()
+        || result.call_id.is_empty()
+        || result.call_id.len() > 256
+        || result.tool.is_empty()
+        || result.tool.len() > 256
+        || result.result.len() > 2048
+        || result.result_revision.len() != 64
+        || !result
+            .result_revision
+            .bytes()
+            .all(|b| b.is_ascii_hexdigit())
+        || credential_bearing(&result.result)
+    {
+        return Err(held("completed tool checkpoint is not portable"));
+    }
+    if let Some(previous) = results.iter().find(|previous| {
+        previous.source_thread_id == result.source_thread_id && previous.call_id == result.call_id
+    }) {
+        return if previous == &result {
+            Ok(())
+        } else {
+            Err(held("conflicting completed tool checkpoint"))
+        };
+    }
+    if results.len() >= 128 {
+        return Err(held(
+            "completed context requires a smaller explicit checkpoint",
+        ));
+    }
+    results.push(result);
+    Ok(())
+}
+
+fn restore_portable_checkpoint(
+    source: ThreadId,
+    text: &str,
+    user: &mut Vec<String>,
+    user_bytes: &mut usize,
+    assistant: &mut Vec<String>,
+    completed: &mut Vec<PortableToolResult>,
+) -> CodexResult<()> {
+    if text.len() > 65536 {
+        return Err(held("portable checkpoint exceeds the bound"));
+    }
+    let (header, json) = text
+        .split_once('\n')
+        .ok_or_else(|| held("portable checkpoint is incomplete"))?;
+    let checkpoint: PortableCheckpoint =
+        serde_json::from_str(json).map_err(|_| held("portable checkpoint cannot be attributed"))?;
+    if header != portable_header(checkpoint.source_thread_id)
+        || checkpoint.source_thread_id == source
+        || checkpoint.recent_public_context.len() > 8
+        || checkpoint.completed_tool_results.len() > 128
+        || checkpoint
+            .objective_and_constraints
+            .iter()
+            .map(String::len)
+            .sum::<usize>()
+            > 32768
+    {
+        return Err(held("portable checkpoint identity/context is invalid"));
+    }
+    for objective in checkpoint.objective_and_constraints {
+        if !user.contains(&objective) {
+            *user_bytes += objective.len();
+            if *user_bytes > 32768 {
+                return Err(held("objective/constraints exceed the portable bound"));
+            }
+            user.push(objective);
+        }
+    }
+    for context in checkpoint.recent_public_context {
+        if context.len() > 2048 {
+            return Err(held("public checkpoint context exceeds the bound"));
+        }
+        assistant.push(context);
+        if assistant.len() > 8 {
+            assistant.remove(0);
+        }
+    }
+    for mut result in checkpoint.completed_tool_results {
+        result
+            .source_thread_id
+            .get_or_insert(checkpoint.source_thread_id);
+        push_portable_result(completed, result)?;
+    }
+    Ok(())
+}
+
+/// Tool invocations become inert result records, never executable history.
+fn portable(
+    source: ThreadId,
+    items: impl Iterator<Item = ResponseItem>,
+) -> CodexResult<Vec<ResponseItem>> {
+    let mut user = Vec::new();
+    let mut assistant = Vec::new();
+    let mut calls = BTreeMap::new();
+    let mut completed = Vec::new();
+    let mut seen = HashSet::new();
+    let mut user_bytes = 0;
+    for item in items {
+        match item {
+            ResponseItem::Message { role, content, .. }
+                if role == "user" || role == "assistant" =>
+            {
+                let mut text = String::new();
+                for part in content {
+                    match part {
+                        ContentItem::InputText { text: part }
+                        | ContentItem::OutputText { text: part, .. } => text.push_str(&part),
+                        _ => {
+                            return Err(held(
+                                "non-text context requires an explicit portable checkpoint",
+                            ));
+                        }
+                    }
+                }
+                if role == "user" {
+                    user_bytes += text.len();
+                    if user_bytes > 32768 {
+                        return Err(held("objective/constraints exceed the portable bound"));
+                    }
+                    user.push(text);
+                } else {
+                    text.truncate(text.floor_char_boundary(2048));
+                    assistant.push(text);
+                    if assistant.len() > 8 {
+                        assistant.remove(0);
+                    }
+                }
+            }
+            ResponseItem::Message {
+                role,
+                content,
+                encrypted_content,
+                ..
+            } if role == "developer" => {
+                let mut text = String::new();
+                let mut text_only = true;
+                for part in content {
+                    match part {
+                        ContentItem::InputText { text: part }
+                        | ContentItem::OutputText { text: part, .. } => text.push_str(&part),
+                        _ => text_only = false,
+                    }
+                }
+                if text.starts_with(PORTABLE_PREFIX) {
+                    if !text_only || encrypted_content.is_some() {
+                        return Err(held(
+                            "portable checkpoint contains private or non-text state",
+                        ));
+                    }
+                    restore_portable_checkpoint(
+                        source,
+                        &text,
+                        &mut user,
+                        &mut user_bytes,
+                        &mut assistant,
+                        &mut completed,
+                    )?;
+                }
+            }
+            ResponseItem::Message { .. }
+            | ResponseItem::Reasoning { .. }
+            | ResponseItem::AdditionalTools { .. } => {}
+            ResponseItem::FunctionCall { call_id, name, .. }
+            | ResponseItem::CustomToolCall { call_id, name, .. } => {
+                if !seen.insert(call_id.clone()) || calls.insert(call_id, name).is_some() {
+                    return Err(held("ambiguous tool identity"));
+                }
+            }
+            ResponseItem::FunctionCallOutput {
+                call_id, output, ..
+            } => {
+                let id = call_id.ok_or_else(|| held("unattributed tool result"))?;
+                let name = calls
+                    .remove(&id)
+                    .ok_or_else(|| held("tool completion cannot be established"))?;
+                let text = output
+                    .body
+                    .to_text()
+                    .ok_or_else(|| held("tool result is not portable text"))?;
+                push_portable_result(&mut completed, portable_result(source, id, name, text)?)?;
+            }
+            ResponseItem::CustomToolCallOutput {
+                call_id, output, ..
+            } => {
+                let name = calls
+                    .remove(&call_id)
+                    .ok_or_else(|| held("tool completion cannot be established"))?;
+                let text = output
+                    .body
+                    .to_text()
+                    .ok_or_else(|| held("tool result is not portable text"))?;
+                push_portable_result(
+                    &mut completed,
+                    portable_result(source, call_id, name, text)?,
+                )?;
+            }
+            _ => {
+                return Err(held(
+                    "history contains an action or checkpoint without portable completion proof",
+                ));
+            }
+        }
+        if completed.len() > 128 {
+            return Err(held(
+                "completed context requires a smaller explicit checkpoint",
+            ));
+        }
+    }
+    if !calls.is_empty() {
+        return Err(held("unfinished tool actions are not replayable"));
+    }
+    let context = serde_json::json!({"sourceThreadId":source,"objectiveAndConstraints":&user,
+        "recentPublicContext":assistant,"completedToolResults":completed});
+    let text = format!(
+        "{}\n{}",
+        portable_header(source),
+        serde_json::to_string(&context).map_err(|_| held("cannot encode portable context"))?
+    );
+    if text.len() > 65536 {
+        return Err(held("portable context exceeds the bound"));
+    }
+    let mut messages = user
+        .into_iter()
+        .map(|text| ResponseItem::Message {
+            id: None,
+            encrypted_content: None,
+            status: None,
+            role: "user".into(),
+            content: vec![ContentItem::InputText { text }],
+            phase: None,
+            internal_chat_message_metadata_passthrough: None,
+        })
+        .collect::<Vec<_>>();
+    messages.push(ResponseItem::Message {
+        id: None,
+        encrypted_content: None,
+        status: None,
+        role: "developer".into(),
+        content: vec![ContentItem::InputText { text }],
+        phase: None,
+        internal_chat_message_metadata_passthrough: None,
+    });
+    Ok(messages)
+}
+
+fn portable_result(
+    source: ThreadId,
+    id: String,
+    name: String,
+    mut text: String,
+) -> CodexResult<PortableToolResult> {
+    if credential_bearing(&text) {
+        return Err(held(
+            "credential-bearing tool result cannot cross providers",
+        ));
+    }
+    let revision = digest(&text)?;
+    let truncated = text.len() > 2048;
+    text.truncate(text.floor_char_boundary(2048));
+    Ok(PortableToolResult {
+        call_id: id,
+        tool: name,
+        result: text,
+        result_revision: revision,
+        truncated,
+        source_thread_id: Some(source),
+    })
+}
+
+async fn fence(parent: &CodexThread, successor: ThreadId, target: &Config) -> CodexResult<()> {
+    let (reply, accepted) = tokio::sync::oneshot::channel();
+    parent
+        .submit(Op::StageProviderContinuation {
+            successor,
+            provider_id: target.model_provider_id.clone(),
+            model: target
+                .model
+                .clone()
+                .ok_or_else(|| held("target model unavailable"))?,
+            selection: target.inference_selection.clone(),
+            reply,
+        })
+        .await?;
+    accepted
+        .await
+        .map_err(|_| held("source staging acknowledgment lost"))?
+}
+
+async fn wait_for_boundary(parent: &CodexThread) {
+    loop {
+        let active = parent.session.active_turn.lock().await;
+        if active.is_none() {
+            return;
+        }
+        if let Some(task) = active.as_ref().and_then(|turn| turn.task.as_ref()) {
+            let mut done = Box::pin(task.done.clone().notified_owned());
+            done.as_mut().enable();
+            drop(active);
+            done.await;
+        } else {
+            drop(active);
+            tokio::time::sleep(std::time::Duration::from_millis(10)).await;
+        }
+    }
+}
+
+/// Ordinary same-provider forks keep their established semantics. Explicit
+/// picker handoffs and all Grok provider/account transitions use this path.
+pub(super) struct Intent {
+    config: Config,
+    provider_continuation: bool,
+    attached_thread: bool,
+    reserved_thread_id: Option<ThreadId>,
+    thread_source: Option<ThreadSource>,
+    parent_trace: Option<W3cTraceContext>,
+}
+
+impl From<&StartThreadOptions> for Intent {
+    fn from(options: &StartThreadOptions) -> Self {
+        Self {
+            config: options.config.clone(),
+            provider_continuation: options.provider_continuation,
+            attached_thread: options.attached_thread,
+            reserved_thread_id: options.reserved_thread_id,
+            thread_source: options.thread_source.clone(),
+            parent_trace: options.parent_trace.clone(),
+        }
+    }
+}
+
+pub(super) async fn try_continue(
+    manager: &ThreadManager,
+    requested: Intent,
+    history: &InitialHistory,
+    source: ThreadId,
+) -> CodexResult<Option<NewThread>> {
+    // Keep preparation state on the heap: embedded clients poll this path on
+    // the UI runtime alongside the ordinary fork handler.
+    let result = Box::pin(try_continue_inner(manager, requested, history, source)).await;
+    if result.is_err()
+        && let Ok(parent) = manager.get_thread(source).await
+    {
+        let config = parent.config().await;
+        if let Ok(Some(mut record)) = read(&config, source)
+            && record.state != "ready"
+        {
+            record.state = "held".into();
+            record.held_reason = Some("preparation_unverified".into());
+            let _ = write(&config, &record, false);
+        }
+    }
+    result
+}
+
+fn requires_live_source(requested: &Intent, history: &InitialHistory, source: ThreadId) -> bool {
+    if requested.provider_continuation
+        || requested.config.model_provider.wire_api == codex_model_provider_info::WireApi::Grok
+    {
+        return true;
+    }
+    let items: &[RolloutItem] = match history {
+        InitialHistory::Resumed(history) => &history.history,
+        InitialHistory::Forked(items) => items,
+        _ => &[],
+    };
+    items.iter().any(|item| {
+        let RolloutItem::SessionMeta(meta) = item else {
+            return false;
+        };
+        meta.meta.id == source
+            && meta.meta.model_provider.as_deref().is_some_and(|provider| {
+                provider == "grok"
+                    || provider.starts_with("grok__")
+                    || requested
+                        .config
+                        .model_providers
+                        .get(provider)
+                        .is_some_and(|info| {
+                            info.wire_api == codex_model_provider_info::WireApi::Grok
+                        })
+            })
+    })
+}
+
+async fn try_continue_inner(
+    manager: &ThreadManager,
+    requested: Intent,
+    history: &InitialHistory,
+    source: ThreadId,
+) -> CodexResult<Option<NewThread>> {
+    let parent = match manager.get_thread(source).await {
+        Ok(parent) => parent,
+        Err(_) if requires_live_source(&requested, history, source) => {
+            return Err(held(
+                "a live source is required to preserve the original allowance",
+            ));
+        }
+        Err(_) => return Ok(None),
+    };
+    let original = parent.config().await;
+    let target = &requested.config;
+    let grok_transition = (original.model_provider.wire_api
+        == codex_model_provider_info::WireApi::Grok
+        || target.model_provider.wire_api == codex_model_provider_info::WireApi::Grok)
+        && (original.model_provider_id != target.model_provider_id
+            || original
+                .inference_selection
+                .as_ref()
+                .map(|s| &s.selection.account_revision)
+                != target
+                    .inference_selection
+                    .as_ref()
+                    .map(|s| &s.selection.account_revision));
+    if !requested.provider_continuation && !grok_transition {
+        return Ok(None);
+    }
+    if original.model_provider.wire_api == codex_model_provider_info::WireApi::Grok
+        && original.inference_selection.is_none()
+    {
+        return Err(held("source account selection cannot be attributed"));
+    }
+    if parent.rollout_path().is_none() || target.ephemeral || requested.attached_thread {
+        return Err(held("a persisted independent successor is required"));
+    }
+    if target.model_provider_id != "openai"
+        && target.model_provider_id != original.model_provider_id
+        && target.inference_selection.is_none()
+    {
+        return Err(held("target requires an exact qualified account selection"));
+    }
+    check_admission(&parent.session).await?;
+    let successor = requested
+        .reserved_thread_id
+        .unwrap_or_else(|| manager.reserve_thread_id());
+    fence(&parent, successor, target).await?;
+    wait_for_boundary(&parent).await;
+    let mut record = read(&original, source)?.ok_or_else(|| held("source fence disappeared"))?;
+    record.state = "preparing".into();
+    write(&original, &record, false)?;
+    if !matches!(
+        parent.agent_status().await,
+        AgentStatus::PendingInit | AgentStatus::Completed(_)
+    ) {
+        return Err(held(
+            "source completion is uncertain; source history retained",
+        ));
+    }
+
+    // Order descendant fences with their own input queues before establishing
+    // that the old branch has no outstanding actions. Never cancel a child.
+    for child_id in manager.list_agent_subtree_thread_ids(source).await? {
+        if child_id == source {
+            continue;
+        }
+        let child = manager
+            .get_thread(child_id)
+            .await
+            .map_err(|_| held("descendant completion cannot be established"))?;
+        fence(&child, successor, target).await?;
+        if child.active_turn_id().await.is_some()
+            || !matches!(
+                child.agent_status().await,
+                AgentStatus::Completed(_) | AgentStatus::Shutdown
+            )
+        {
+            return Err(held(
+                "descendant work is unfinished or uncertain; source history retained",
+            ));
+        }
+    }
+    if !parent.list_background_terminals().await.is_empty() {
+        return Err(held("background terminal actions have not completed"));
+    }
+
+    let (mut options, settings) = manager.fork_options_from_parent(source).await?;
+    let config = &mut options.config;
+    // Only inference changes. The live parent's permissions, workspace bindings,
+    // instruction sources, feature policy and cumulative controller survive.
+    if let Some(selection) = target.inference_selection.as_ref() {
+        let catalog =
+            crate::inference_selection::load_catalog(config.inference_catalog_command.as_ref())
+                .await
+                .map_err(|_| held("selection source unavailable at the boundary"))?;
+        let (selection, provider) = crate::inference_selection::resolve(&catalog, Some(selection))
+            .map_err(|_| held("selection became stale at the boundary"))?
+            .ok_or_else(|| held("selection missing at the boundary"))?;
+        config.model_provider_id = selection.selection.provider_id.clone();
+        config.model = Some(selection.selection.model_id.clone());
+        config.model_context_window = Some(selection.selection.context_window);
+        config
+            .model_providers
+            .insert(config.model_provider_id.clone(), provider.clone());
+        config.model_provider = provider;
+        config.inference_selection = Some(selection);
+    } else {
+        config.model_provider = config
+            .model_providers
+            .get(&target.model_provider_id)
+            .cloned()
+            .ok_or_else(|| held("original OpenAI routing is unavailable"))?;
+        config.model_provider_id = target.model_provider_id.clone();
+        config.model = target.model.clone();
+        config.model_context_window = None;
+        config.inference_selection = None;
+    }
+    config.model_catalog = target.model_catalog.clone();
+    config.service_tier = None;
+    config.model_reasoning_effort = None;
+    config.model_reasoning_summary = None;
+    options.reserved_thread_id = Some(successor);
+    options.session_source = Some(parent.session_source.clone());
+    options.thread_source = requested.thread_source.clone();
+    options.parent_trace = requested.parent_trace.clone();
+    options.dynamic_tools = parent.session.dynamic_tools().await.to_vec();
+    // Keep the source's settings-owned next-turn guards in turn_extension_init.
+    // Snapshot active/pending thread leases separately; normal admission combines
+    // the two scopes rather than replacing either original authority.
+    let mut inherited_guards = Vec::new();
+    if let Some(current) = parent
+        .thread_extension_data()
+        .get::<crate::governor_guard::GovernorTurnGuards>()
+    {
+        inherited_guards.extend(current.guards.clone());
+    }
+    if let Some(next) = parent
+        .thread_extension_data()
+        .get::<crate::governor_guard::NextGovernorTurnGuards>()
+    {
+        inherited_guards.extend(next.0.clone());
+    }
+    // A causal root can own only one lease per scope. Detect an incompatible
+    // pending lease before spawning, rather than letting registration cancel it.
+    let mut lease_owners = std::collections::HashMap::new();
+    let pending_guards = options
+        .turn_extension_init
+        .get::<crate::governor_guard::NextGovernorTurnGuards>();
+    for guard in inherited_guards
+        .iter()
+        .chain(pending_guards.iter().flat_map(|pending| pending.0.iter()))
+    {
+        if let Some(owner) = lease_owners.insert(guard.scope, &guard.id)
+            && owner != &guard.id
+        {
+            return Err(held(
+                "conflicting lease ownership requires explicit reassignment",
+            ));
+        }
+    }
+    if !inherited_guards.is_empty() {
+        options
+            .thread_extension_init
+            .insert(crate::governor_guard::NextGovernorTurnGuards(
+                crate::governor_guard::combine(inherited_guards),
+            ));
+    }
+    let snapshot = parent.conversation_history_snapshot().await;
+    let mut public_history = snapshot.review_items().cloned().collect::<Vec<_>>();
+    if let Some(db) = parent.state_db()
+        && let Some(goal) = db
+            .thread_goals()
+            .get_thread_goal(source)
+            .await
+            .map_err(|_| held("source goal cannot be attributed"))?
+    {
+        public_history.push(ResponseItem::Message {
+            id: None,
+            encrypted_content: None,
+            status: None,
+            role: "user".into(),
+            content: vec![ContentItem::InputText {
+                text: goal.objective,
+            }],
+            phase: None,
+            internal_chat_message_metadata_passthrough: None,
+        });
+    }
+    let message = portable(source, public_history.into_iter())?;
+    record.context_revision = Some(digest(&message)?);
+    let authority = parent.config_snapshot().await;
+    record.authority_revision = Some(digest(&(
+        &authority.approval_policy,
+        &authority.approvals_reviewer,
+        &authority.permission_profile,
+        &authority.workspace_roots,
+        &options.config.rollout_budget,
+    ))?);
+    let meta = match history {
+        InitialHistory::Resumed(history) => history.history.iter().find_map(|item| match item {
+            RolloutItem::SessionMeta(meta) if meta.meta.id == source => {
+                Some(RolloutItem::SessionMeta(meta.clone()))
+            }
+            _ => None,
+        }),
+        InitialHistory::Forked(items) => items.iter().find_map(|item| match item {
+            RolloutItem::SessionMeta(meta) if meta.meta.id == source => {
+                Some(RolloutItem::SessionMeta(meta.clone()))
+            }
+            _ => None,
+        }),
+        _ => None,
+    }
+    .ok_or_else(|| held("source canonical identity is unavailable"))?;
+    let mut portable_history = vec![meta];
+    portable_history.extend(
+        message
+            .into_iter()
+            .map(|item| RolloutItem::ResponseItem(item.into())),
+    );
+    options.initial_history = InitialHistory::Forked(portable_history);
+    let mut request = ThreadSpawnRequest::new(
+        options,
+        Arc::clone(&parent.session.services.auth_manager),
+        AgentControlInit::Provided {
+            control: Arc::clone(&parent.session.services.agent_control),
+            runtime: parent.session.services.local_agent_runtime.clone(),
+        },
+    );
+    request.parent_thread_id = Some(source);
+    request.parent_originator = Some(authority.originator.clone());
+    request.forked_from_thread_id = Some(source);
+    request.inherited_exec_policy = Some(Arc::clone(&parent.session.services.exec_policy));
+    request.inherited_instructions = Some(parent.session.inherited_instructions().await);
+    let continued = Box::pin(manager.state.spawn_thread(request)).await?;
+    continued
+        .thread
+        .restore_thread_settings(CodexThreadSettingsOverrides {
+            windows_sandbox_level: settings.windows_sandbox_level,
+            ..Default::default()
+        })
+        .await
+        .map_err(|_| held("inherited Windows permission policy is incompatible"))?;
+    continued
+        .thread
+        .flush_rollout()
+        .await
+        .map_err(CodexErr::Io)?;
+    // Host goal/accounting transfer must finish before the successor can admit work.
+    write(&original, &record, false)?;
+    Ok(Some(continued))
+}
+
+impl ThreadManager {
+    /// Complete the host goal transfer before admitting the successor's work.
+    pub async fn complete_provider_continuation(
+        &self,
+        source: ThreadId,
+        successor: ThreadId,
+    ) -> CodexResult<()> {
+        let parent = self.get_thread(source).await?;
+        let child = self.get_thread(successor).await?;
+        let config = parent.config().await;
+        let mut record = read(&config, source)?.ok_or_else(|| held("source fence unavailable"))?;
+        if record.successor != successor
+            || record.state != "preparing"
+            || record.authority_revision.is_none()
+            || record.context_revision.is_none()
+            || !parent
+                .session
+                .services
+                .local_agent_runtime
+                .shares_task_authority(&child.session.services.local_agent_runtime)
+            || child.startup_metadata().session_id.to_string() != record.session_id
+        {
+            return Err(held("successor authority is incomplete"));
+        }
+        if let Some(db) = parent.state_db() {
+            let mut original = db
+                .thread_goals()
+                .get_thread_goal(source)
+                .await
+                .map_err(|_| held("original goal cannot be read"))?;
+            let inherited = db
+                .thread_goals()
+                .get_thread_goal(successor)
+                .await
+                .map_err(|_| held("inherited goal cannot be read"))?;
+            if let Some(goal) = original.as_mut() {
+                goal.thread_id = successor;
+            }
+            if original != inherited {
+                return Err(held("original goal allowance/context was not preserved"));
+            }
+        }
+        record.state = "ready".into();
+        write(&config, &record, false)
+    }
+}
