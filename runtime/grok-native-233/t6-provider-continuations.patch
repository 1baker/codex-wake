diff --git a/codex-rs/tui/src/app/provider_continuation.rs b/codex-rs/tui/src/app/provider_continuation.rs
new file mode 100644
index 0000000000..5f7bd6fe29
--- /dev/null
+++ b/codex-rs/tui/src/app/provider_continuation.rs
@@ -0,0 +1,128 @@
+//! Keep selection staging off the drawing loop while native Codex owns the fence.
+use super::session_lifecycle::{PreparedFreshSession, ThreadAttachPresentation};
+use super::*;
+use codex_protocol::inference_selection::InferenceSelectionSnapshot;
+
+impl App {
+    pub(super) async fn select_inference_at_boundary(
+        &mut self,
+        tui: &mut tui::Tui,
+        app_server: &mut AppServerSession,
+        source: Option<ThreadId>,
+        model: String,
+        selection: Option<InferenceSelectionSnapshot>,
+    ) {
+        if app_server.thread_params_mode().settings_owner()
+            == crate::app_server_session::ThreadSettingsOwner::Server
+        {
+            self.chat_widget.add_error_message("This hosted session owns model settings; account selection is unavailable on this transport.".into());
+            return;
+        }
+        if source != self.current_displayed_thread_id() {
+            self.chat_widget.add_error_message(
+                "The selection belongs to another conversation; select its model there.".into(),
+            );
+            return;
+        }
+        let Some(source) = source else {
+            self.start_fresh_session_with_inference(tui, app_server, None, None, None, selection)
+                .await;
+            return;
+        };
+        if self.pending_server_profiles.contains_key(&source)
+            || self.reject_pending_permission_root_switch()
+        {
+            self.chat_widget.add_error_message(
+                "Wait for the accepted permission change before changing inference selection."
+                    .into(),
+            );
+            return;
+        }
+        let mut config = self.chat_widget.config_ref().clone();
+        if config.inference_selection == selection && self.chat_widget.current_model() == model {
+            return;
+        }
+        config.model = Some(model);
+        config.model_provider_id = selection
+            .as_ref()
+            .map(|s| s.selection.provider_id.clone())
+            .unwrap_or_else(|| "openai".into());
+        config.model_context_window = selection
+            .as_ref()
+            .map(|choice| choice.selection.context_window);
+        if selection.is_none() {
+            let Some(provider) = config.model_providers.get("openai").cloned() else {
+                self.chat_widget.add_error_message(
+                    "Continuation held: original OpenAI routing is unavailable.".into(),
+                );
+                return;
+            };
+            config.model_provider = provider;
+        }
+        config.inference_selection = selection;
+        config.service_tier = None;
+        config.model_reasoning_effort = None;
+        config.model_reasoning_summary = None;
+        app_server.stage_inference_continuation(source, config, self.app_event_tx.clone());
+        self.chat_widget.add_info_message(
+            "Selection staged for the next safe turn boundary. Current work continues.".into(),
+            None,
+        );
+    }
+
+    pub(super) async fn finish_inference_continuation(
+        &mut self,
+        tui: &mut tui::Tui,
+        app_server: &mut AppServerSession,
+        source: ThreadId,
+        config: Config,
+        result: Result<codex_app_server_protocol::ThreadForkResponse, String>,
+    ) {
+        let response = match result {
+            Ok(response) => response,
+            Err(error) => {
+                self.chat_widget
+                    .add_error_message(format!("Selection handoff held: {error}"));
+                return;
+            }
+        };
+        if self.current_displayed_thread_id() != Some(source) {
+            // The durable successor remains discoverable; never move a different
+            // conversation or replay the selection against it.
+            self.chat_widget.add_info_message(
+                format!(
+                    "Continuation created: {} (source {source}).",
+                    response.thread.id
+                ),
+                None,
+            );
+            return;
+        }
+        match app_server
+            .finish_inference_continuation(response, &self.local_settings, &config)
+            .await
+        {
+            Ok(started) => {
+                let input = self.chat_widget.capture_thread_input_state();
+                self.retain_subscriptions_for_fork();
+                self.adopt_fresh_session(
+                    tui,
+                    app_server,
+                    PreparedFreshSession {
+                        started,
+                        config,
+                        local_settings: self.local_settings.clone(),
+                    },
+                    ThreadAttachPresentation::SessionLineage,
+                    None,
+                    None,
+                )
+                .await;
+                self.chat_widget.restore_reconnected_input(input, &[]);
+            }
+            Err(error) => self.chat_widget.add_error_message(format!(
+                "Continuation exists but could not be attached: {error}"
+            )),
+        }
+    }
+}
