diff --git a/codex-rs/codex-api/tests/clients.rs b/codex-rs/codex-api/tests/clients.rs
index 10774c64d3f6b7ccb6e8bb57fb4eee3273d494b7..0355a6b2f2c861d5dfc1e9f30f78bc80418982b7 100644
--- a/codex-rs/codex-api/tests/clients.rs
+++ b/codex-rs/codex-api/tests/clients.rs
@@ -984,0 +985,67 @@ async fn grok_http_failure_retains_only_status_without_replay() -> Result<()> {
+
+#[tokio::test]
+async fn grok_usage_contract_preserves_reasoning_cache_and_unknown_holds() -> Result<()> {
+    use codex_api::{GrokClient, ResponseEvent};
+    use futures::StreamExt;
+    use serde_json::json;
+    use wiremock::matchers::{method, path};
+    use wiremock::{Mock, MockServer, ResponseTemplate};
+    // Independent expected counts: xAI's published Chat Completions example.
+    // https://docs.x.ai/developers/rest-api-reference/inference/chat-completions
+    for (completion, total, cached, expected_output) in [
+        (9, 135, 6, Some(103)),
+        (103, 135, 6, Some(103)),
+        (9, 134, 6, None),
+        (9, 135, 33, None),
+    ] {
+        let server = MockServer::start().await;
+        let chunk = json!({"id":"usage-contract","model":"grok-observed",
+            "choices":[{"index":0,"delta":{"content":"done"},"finish_reason":"stop"}],
+            "usage":{"prompt_tokens":32,"completion_tokens":completion,"total_tokens":total,
+                "prompt_tokens_details":{"cached_tokens":cached},
+                "completion_tokens_details":{"reasoning_tokens":94},
+                "provider_private_blob":"must-not-leak"}});
+        Mock::given(method("POST"))
+            .and(path("/v1/chat/completions"))
+            .respond_with(ResponseTemplate::new(200)
+                .insert_header("content-type", "text/event-stream")
+                .set_body_string(format!("data: {chunk}\n\ndata: [DONE]\n\n")))
+            .expect(1)
+            .mount(&server).await;
+        let mut p = provider("grok");
+        p.base_url = format!("{}/v1", server.uri());
+        let mut stream = GrokClient::new(
+            codex_client::ReqwestTransport::new(reqwest::Client::new()), p,
+            Arc::new(StaticAuth::new("secret", "account")),
+        ).stream_request(grok_request(vec![])).await?;
+        let mut observed = None;
+        let mut error = None;
+        let mut committed = false;
+        while let Some(event) = stream.next().await {
+            match event {
+                Ok(ResponseEvent::Completed { token_usage, .. }) => observed = token_usage,
+                Ok(ResponseEvent::OutputItemDone(_)) => committed = true,
+                Err(failure) => error = Some(failure),
+                _ => {}
+            }
+        }
+        if let Some(output) = expected_output {
+            let usage = observed.expect("documented usage must produce canonical completion");
+            assert!(error.is_none());
+            assert_eq!(usage.input_tokens, 32);
+            assert_eq!(usage.cached_input_tokens, 6);
+            assert_eq!(usage.output_tokens, output);
+            assert_eq!(usage.reasoning_output_tokens, 94);
+            assert_eq!(usage.total_tokens, 135);
+            assert!(committed);
+        } else {
+            assert!(observed.is_none());
+            assert!(!committed);
+            let failure = error.expect("unreconciled counts must hold");
+            assert!(!failure.to_string().contains("must-not-leak"));
+            assert!(codex_api::map_api_error(failure).retry_delay(0).is_none());
+        }
+        server.verify().await;
+    }
+    Ok(())
+}
