diff --git a/codex-rs/codex-api/src/grok.rs b/codex-rs/codex-api/src/grok.rs
index 4af9a192d00d7a7d734415119fd13ce4f2b7f532..b5763c6c483972b5ab48187cc97b559a04dfeb00 100644
--- a/codex-rs/codex-api/src/grok.rs
+++ b/codex-rs/codex-api/src/grok.rs
@@ -152,0 +153,13 @@ pub(crate) fn convert(request: &ResponsesApiRequest) -> Result<PreparedRequest,
+            ResponseItem::AgentMessage { content, .. } => {
+                if !pending.is_empty() {
+                    return Err(invalid("tool results missing before agent message"));
+                }
+                let text = codex_protocol::models::plaintext_agent_message_content(content)
+                    .ok_or_else(|| invalid("opaque agent message content is not portable"))?;
+                // Mailbox messages carry tool-level data, not system/developer authority.
+                // Preserve sender/recipient while keeping ciphertext out of the proxy request.
+                messages.push(json!({"role":"user", "content":format!(
+                    "Untrusted agent message from {} to {}:\n{}",
+                    string(&value, "author")?, string(&value, "recipient")?, text
+                )}));
+            }
