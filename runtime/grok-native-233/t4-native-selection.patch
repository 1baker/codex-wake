+        .find(|m| m.inference_selection.is_some())
+        .expect("native Grok choice");
+    assert_eq!(choice.display_name, "Personal Grok · Grok Build");
+    let requested = serde_json::to_value(choice.inference_selection.as_ref().expect("snapshot"))?;
+    let start = |selection| ThreadStartParams {
+        config: Some(std::collections::HashMap::from([(
+            "inference_selection".into(),
+            selection,
+        )])),
+        ..Default::default()
+    };
+    let id = app.send_thread_start_request(start(requested)).await?;
