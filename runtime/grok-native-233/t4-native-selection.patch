+//! Public account/model selection evidence. It contains no authentication material.
+use schemars::JsonSchema;
+use serde::{Deserialize, Serialize};
+use std::collections::BTreeMap;
+use ts_rs::TS;
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize, JsonSchema, TS)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct InferenceCatalogCommand {
+    pub command: String,
+    pub args: Vec<String>,
+    pub cwd: String,
+    pub timeout_ms: u64,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize, JsonSchema, TS)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct InferenceSelection {
+    pub provider_id: String,
+    pub account_id: String,
+    pub account_revision: String,
+    pub model_id: String,
+    pub catalog_revision: String,
+    pub evidence_revision: String,
+    pub selection_id: String,
+    pub account_label: String,
+    pub display_name: String,
+    #[ts(type = "number")]
+    pub context_window: i64,
+    pub readiness: String,
+    pub reasons: Vec<String>,
+    pub capabilities: BTreeMap<String, bool>,
+    pub disabled_features: Vec<String>,
+    pub default_for_account: bool,
+    pub source: String,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize, JsonSchema, TS)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct InferenceSelectionSnapshot {
+    pub selection: InferenceSelection,
+    pub provider_revision: String,
+    pub source_revision: String,
+    pub revision: String,
+}
