diff --git a/codex-rs/core/src/inference_selection.rs b/codex-rs/core/src/inference_selection.rs
new file mode 100644
index 0000000000000000000000000000000000000000..0c5afb26841017f77150843f8fb5e36ecd39538a
--- /dev/null
+++ b/codex-rs/core/src/inference_selection.rs
@@ -0,0 +1,309 @@
+//! Native admission of independently qualified account/model selections.
+use codex_model_provider_info::{ModelProviderInfo, WireApi};
+use codex_protocol::inference_selection::{
+    InferenceCatalogCommand, InferenceSelection, InferenceSelectionSnapshot,
+};
+use codex_protocol::openai_models::{ModelInfo, ModelPreset};
+use serde::Deserialize;
+use sha2::{Digest, Sha256};
+use std::collections::BTreeMap;
+use std::io;
+use std::process::Stdio;
+use std::time::Duration;
+use tokio::io::AsyncReadExt;
+
+const REQUIRED: [&str; 5] = ["text", "streaming", "terminal", "file_editing", "mcp"];
+
+#[derive(Default, Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct InferenceCatalog {
+    schema_version: u32,
+    source_revision: String,
+    #[serde(skip)]
+    command_revision: String,
+    selections: Vec<InferenceSelection>,
+    providers: BTreeMap<String, ModelProviderInfo>,
+}
+
+fn held() -> io::Error {
+    io::Error::new(
+        io::ErrorKind::InvalidData,
+        "inference selection unavailable, stale or unqualified",
+    )
+}
+fn revision(value: &impl serde::Serialize) -> io::Result<String> {
+    fn canonical(value: serde_json::Value) -> serde_json::Value {
+        match value {
+            serde_json::Value::Object(values) => {
+                let sorted: BTreeMap<_, _> = values
+                    .into_iter()
+                    .map(|(key, value)| (key, canonical(value)))
+                    .collect();
+                serde_json::Value::Object(sorted.into_iter().collect())
+            }
+            serde_json::Value::Array(values) => {
+                serde_json::Value::Array(values.into_iter().map(canonical).collect())
+            }
+            value => value,
+        }
+    }
+    let bytes = serde_json::to_vec(&canonical(serde_json::to_value(value).map_err(|_| held())?))
+        .map_err(|_| held())?;
+    Ok(format!("{:x}", Sha256::digest(bytes)))
+}
+
+/// Only this explicitly configured local command can supply a catalog. Its private
+/// auth command is a different protocol. Arbitrary diagnostics are discarded.
+pub async fn load_catalog(
+    command: Option<&InferenceCatalogCommand>,
+) -> io::Result<InferenceCatalog> {
+    let Some(command) = command else {
+        return Ok(InferenceCatalog::default());
+    };
+    if !std::path::Path::new(&command.command).is_absolute()
+        || !std::path::Path::new(&command.cwd).is_absolute()
+        || !(1..=5000).contains(&command.timeout_ms)
+    {
+        return Err(held());
+    }
+    let mut process = tokio::process::Command::new(&command.command);
+    process
+        .args(&command.args)
+        .current_dir(&command.cwd)
+        .env_clear();
+    for key in [
+        "HOME",
+        "PATH",
+        "XDG_CONFIG_HOME",
+        "XDG_STATE_HOME",
+        "XDG_DATA_HOME",
+    ] {
+        if let Some(value) = std::env::var_os(key) {
+            process.env(key, value);
+        }
+    }
+    let mut child = process
+        .stdin(Stdio::null())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::null())
+        .kill_on_drop(true)
+        .spawn()
+        .map_err(|_| held())?;
+    let stdout = child.stdout.take().ok_or_else(held)?;
+    let work = async {
+        let mut bytes = Vec::new();
+        stdout
+            .take(1024 * 1024 + 1)
+            .read_to_end(&mut bytes)
+            .await
+            .map_err(|_| held())?;
+        if bytes.len() > 1024 * 1024 {
+            return Err(held());
+        }
+        if !child.wait().await.map_err(|_| held())?.success() {
+            return Err(held());
+        }
+        let mut catalog: InferenceCatalog = serde_json::from_slice(&bytes).map_err(|_| held())?;
+        if catalog.schema_version != 1
+            || catalog.selections.len() > 200
+            || catalog.source_revision.is_empty()
+        {
+            return Err(held());
+        }
+        catalog.command_revision = revision(command)?;
+        Ok(catalog)
+    };
+    tokio::time::timeout(Duration::from_millis(command.timeout_ms), work)
+        .await
+        .map_err(|_| held())?
+}
+
+pub fn snapshots(catalog: &InferenceCatalog) -> io::Result<Vec<InferenceSelectionSnapshot>> {
+    let mut seen = std::collections::HashSet::new();
+    catalog
+        .selections
+        .iter()
+        .map(|selection| {
+            if !seen.insert(&selection.selection_id)
+                || selection.provider_id != format!("grok__{}", selection.account_id)
+                || selection.account_id.len() > 64
+                || selection.account_id.is_empty()
+                || !selection
+                    .account_id
+                    .bytes()
+                    .all(|c| c.is_ascii_lowercase() || c.is_ascii_digit() || c == b'_' || c == b'-')
+                || [
+                    &selection.account_label,
+                    &selection.display_name,
+                    &selection.model_id,
+                ]
+                .iter()
+                .any(|s| s.is_empty() || s.len() > 256 || s.chars().any(char::is_control))
+                || selection.account_label.is_empty()
+                || selection.model_id.is_empty()
+                || !(8192..=2_000_000).contains(&selection.context_window)
+            {
+                return Err(held());
+            }
+            let provider = catalog
+                .providers
+                .get(&selection.provider_id)
+                .ok_or_else(held)?;
+            provider.validate().map_err(|_| held())?;
+            if provider.wire_api != WireApi::Grok
+                || provider.base_url.as_ref().map(|url| url.as_str())
+                    != Some("https://cli-chat-proxy.grok.com/v1")
+                || provider
+                    .env_http_headers
+                    .as_ref()
+                    .is_some_and(|headers| !headers.is_empty())
+                || provider
+                    .http_headers
+                    .as_ref()
+                    .is_some_and(|headers| !headers.is_empty())
+                || provider
+                    .query_params
+                    .as_ref()
+                    .is_some_and(|params| !params.is_empty())
+                || !matches!(
+                    selection.readiness.as_str(),
+                    "qualified" | "unverified" | "unavailable" | "stale"
+                )
+            {
+                return Err(held());
+            }
+            let auth = provider.auth.as_ref().ok_or_else(held)?;
+            let tail: Vec<_> = auth
+                .args
+                .iter()
+                .rev()
+                .take(4)
+                .map(|arg| arg.as_str())
+                .collect();
+            if tail != [selection.account_id.as_str(), "token", "auth", "grok"]
+                || !std::path::Path::new(&auth.command).is_absolute()
+                || !auth.cwd.as_path().is_absolute()
+            {
+                return Err(held());
+            }
+            // Public readiness is an upper bound: a source cannot advertise ready
+            // while omitting a required capability or independent evidence.
+            let mut normalized = selection.clone();
+            if normalized.readiness == "qualified" {
+                let missing: Vec<_> = REQUIRED
+                    .iter()
+                    .filter(|key| normalized.capabilities.get(**key) != Some(&true))
+                    .map(|key| format!("required_capability_missing:{key}"))
+                    .collect();
+                if !missing.is_empty() {
+                    normalized.readiness = "unavailable".into();
+                    normalized.reasons = missing;
+                } else if normalized.evidence_revision.is_empty()
+                    || normalized.evidence_revision == "unverified"
+                {
+                    normalized.readiness = "unverified".into();
+                    normalized.reasons = vec!["entitlement_and_inference_unverified".into()];
+                }
+            }
+            let provider_revision = revision(provider)?;
+            let source_revision = revision(&(&catalog.source_revision, &catalog.command_revision))?;
+            let revision = revision(&(&normalized, &provider_revision, &source_revision))?;
+            Ok(InferenceSelectionSnapshot {
+                selection: normalized,
+                provider_revision,
+                source_revision,
+                revision,
+            })
+        })
+        .collect()
+}
+
+pub fn resolve(
+    catalog: &InferenceCatalog,
+    requested: Option<&InferenceSelectionSnapshot>,
+) -> io::Result<Option<(InferenceSelectionSnapshot, ModelProviderInfo)>> {
+    let Some(requested) = requested else {
+        return Ok(None);
+    };
+    let current = snapshots(catalog)?
+        .into_iter()
+        .find(|s| s == requested)
+        .ok_or_else(held)?;
+    if current.selection.readiness != "qualified"
+        || current.selection.evidence_revision == "unverified"
+        || !REQUIRED
+            .iter()
+            .all(|key| current.selection.capabilities.get(*key) == Some(&true))
+    {
+        return Err(held());
+    }
+    let provider = catalog
+        .providers
+        .get(&current.selection.provider_id)
+        .ok_or_else(held)?
+        .clone();
+    Ok(Some((current, provider)))
+}
+
+pub fn model_info(snapshot: &InferenceSelectionSnapshot) -> io::Result<ModelInfo> {
+    let mut info = codex_models_manager::bundled_models_response()
+        .map_err(|_| held())?
+        .models
+        .into_iter()
+        .next()
+        .ok_or_else(held)?;
+    info.shell_type = codex_protocol::openai_models::ConfigShellToolType::UnifiedExec;
+    info.apply_patch_tool_type = Some(codex_protocol::openai_models::ApplyPatchToolType::Freeform);
+    info.tool_mode = Some(codex_protocol::openai_models::ToolMode::Direct);
+    info.slug = snapshot.selection.model_id.clone();
+    info.display_name = format!(
+        "{} · {}",
+        snapshot.selection.account_label, snapshot.selection.display_name
+    );
+    info.description = Some(format!(
+        "{}: {}",
+        snapshot.selection.readiness,
+        snapshot.selection.reasons.join(", ")
+    ));
+    info.inference_selection = Some(snapshot.clone());
+    info.context_window = Some(snapshot.selection.context_window);
+    info.max_context_window = info.context_window;
+    info.auto_compact_token_limit = None;
+    info.default_reasoning_level = None;
+    info.supported_reasoning_levels.clear();
+    info.guardian = None;
+    info.supports_image_detail_original = false;
+    info.supports_reasoning_summary_parameter = false;
+    info.supports_reasoning_effort_updates = false;
+    info.supports_search_tool = false;
+    info.supports_experimental_context = false;
+    info.use_responses_lite = false;
+    info.support_verbosity = false;
+    info.input_modalities = vec![codex_protocol::openai_models::InputModality::Text];
+    info.service_tiers.clear();
+    info.additional_speed_tiers.clear();
+    info.default_service_tier = None;
+    info.available_access_programs = None;
+    info.upgrade = None;
+    info.availability_nux = None;
+    info.model_specialty = None;
+    info.auto_review_model_override = None;
+    info.experimental_supported_tools.clear();
+    Ok(info)
+}
+
+pub async fn list_models(
+    command: Option<&InferenceCatalogCommand>,
+) -> io::Result<Vec<ModelPreset>> {
+    let catalog = load_catalog(command).await?;
+    snapshots(&catalog)?
+        .iter()
+        .map(|snapshot| {
+            let mut preset: ModelPreset = model_info(snapshot)?.into();
+            preset.id = snapshot.selection.selection_id.clone();
+            preset.is_default = false; // Per-account preference never replaces the OpenAI default.
+            preset.show_in_picker = true;
+            Ok(preset)
+        })
+        .collect()
+}
