+        DEFAULT_TIMEOUT,
+        app.read_stream_until_error_message(RequestId::Integer(id)),
+    )
+    .await??;
+    catalog["selections"][0]["readiness"] = json!("qualified");
+    catalog["selections"][0]["reasons"] = json!([]);
+    catalog["selections"][0]["evidenceRevision"] = json!("independent-coding-receipt-v1");
+    std::fs::write(&source, serde_json::to_vec(&catalog)?)?;
+    let qualified: ModelListResponse = app
+        .request(|request_id| ClientRequest::ModelList {
+            request_id,
+            params: ModelListParams {
+                include_hidden: Some(true),
+                ..Default::default()
+            },
+        })
+        .await?;
+    let snapshot = qualified
+        .data
+        .into_iter()
+        .find_map(|m| m.inference_selection)
+        .expect("qualified snapshot");
+    assert_eq!(snapshot.selection.readiness, "qualified");
+    catalog["selections"][0]["capabilities"]["terminal"] = json!(false);
+    std::fs::write(&source, serde_json::to_vec(&catalog)?)?;
+    let incomplete: ModelListResponse = app
+        .request(|request_id| ClientRequest::ModelList {
+            request_id,
+            params: ModelListParams {
+                include_hidden: Some(true),
+                ..Default::default()
+            },
+        })
+        .await?;
+    let incomplete = incomplete
+        .data
+        .into_iter()
+        .find_map(|m| m.inference_selection)
+        .expect("incomplete capability snapshot");
+    assert_eq!(incomplete.selection.readiness, "unavailable");
+    assert!(
+        incomplete
+            .selection
+            .reasons
+            .contains(&"required_capability_missing:terminal".to_string())
+    );
+    let id = app
+        .send_thread_start_request(start(serde_json::to_value(incomplete)?))
+        .await?;
+    let _: JSONRPCError = timeout(
+        DEFAULT_TIMEOUT,
+        app.read_stream_until_error_message(RequestId::Integer(id)),
+    )
+    .await??;
+    catalog["selections"][0]["capabilities"]["terminal"] = json!(true);
+    std::fs::write(&source, serde_json::to_vec(&catalog)?)?;
+    let started: ThreadStartResponse = app
+        .start_thread(start(serde_json::to_value(&snapshot)?))
+        .await?;
+    assert_eq!(started.model_provider, "grok__personal");
+    assert_eq!(started.model, "grok-build");
+    catalog["selections"][0]["evidenceRevision"] = json!("changed-evidence");
+    std::fs::write(&source, serde_json::to_vec(&catalog)?)?;
+    let id = app
+        .send_thread_start_request(start(serde_json::to_value(snapshot)?))
+        .await?;
+    let _: JSONRPCError = timeout(
+        DEFAULT_TIMEOUT,
+        app.read_stream_until_error_message(RequestId::Integer(id)),
+    )
+    .await??;
+    Ok(())
+}
