+#[tokio::test]
+async fn grok_picker_keeps_account_identity_and_holds_unqualified_choices() {
+    let (mut chat, mut events, _ops) = make_chatwidget_manual(Some("gpt-5.5")).await;
+    let snapshot: codex_protocol::inference_selection::InferenceSelectionSnapshot = serde_json::from_value(serde_json::json!({
+        "providerRevision":"provider-v1","sourceRevision":"source-v1","revision":"snapshot-v1",
+        "selection":{"providerId":"grok__personal","accountId":"personal","accountRevision":"account-v1",
+        "modelId":"grok-build","catalogRevision":"catalog-v1","evidenceRevision":"unverified","selectionId":"choice-v1",
+        "accountLabel":"Personal Grok","displayName":"Grok Build","contextWindow":32000,
+        "readiness":"unverified","reasons":["entitlement_and_inference_unverified"],
+        "capabilities":{},"disabledFeatures":["web_search","image_generation","reasoning_summary"],
+        "defaultForAccount":false,"source":"operator-model-metadata"}})).unwrap();
+    let mut preset = get_available_model(&chat, "gpt-5.5");
+    preset.id = "choice-v1".into();
+    preset.model = "grok-build".into();
+    preset.display_name = "Personal Grok · Grok Build".into();
+    preset.description = "entitlement_and_inference_unverified".into();
+    preset.inference_selection = Some(snapshot.clone());
+    chat.open_model_popup_with_presets(vec![preset.clone()]);
+    let rendered = render_bottom_popup(&chat, 120);
+    assert!(rendered.contains("Personal Grok"));
+    assert!(rendered.contains("unverified"));
+    chat.handle_key_event(KeyEvent::from(KeyCode::Enter));
+    assert!(
+        !std::iter::from_fn(|| events.try_recv().ok())
+            .any(|event| matches!(event, AppEvent::NewInferenceSession(_)))
+    );
+    chat.handle_key_event(KeyEvent::from(KeyCode::Esc));
+    let mut qualified = snapshot;
+    qualified.selection.readiness = "qualified".into();
+    qualified.selection.reasons.clear();
+    qualified.selection.evidence_revision = "independent-coding-proof".into();
+    qualified.selection.capabilities = ["text", "streaming", "terminal", "file_editing", "mcp"]
+        .into_iter()
+        .map(|key| (key.to_string(), true))
+        .collect();
+    preset.inference_selection = Some(qualified.clone());
+    chat.open_model_popup_with_presets(vec![preset]);
+    chat.handle_key_event(KeyEvent::from(KeyCode::Enter));
+    assert!(std::iter::from_fn(|| events.try_recv().ok()).any(
+        |event| matches!(event, AppEvent::NewInferenceSession(selected) if selected == qualified)
+    ));
+    assert_eq!(chat.current_model(), "gpt-5.5"); // Existing conversation is unchanged by the queued new-session request.
+    chat.config.inference_selection = Some(qualified);
+    chat.config.inference_catalog_command = Some(
+        codex_protocol::inference_selection::InferenceCatalogCommand {
+            command: "/operator/bin/codex-wake".into(),
+            args: Vec::new(),
+            cwd: "/".into(),
+            timeout_ms: 1000,
+        },
+    );
+    for mode in [
+        crate::app_server_session::ThreadParamsMode::Embedded,
+        crate::app_server_session::ThreadParamsMode::Remote,
+    ] {
+        let params = crate::app_server_session::thread_start_params_from_config(
+            &chat.config,
+            mode,
+            None,
+            None,
+        );
+        let overrides = params.config.expect("selection config overrides");
+        assert!(overrides.contains_key("inference_selection"));
+        assert_eq!(
+            overrides.contains_key("inference_catalog_command"),
+            mode == crate::app_server_session::ThreadParamsMode::Embedded
+        );
+    }
+}
