+        "contextWindow":32000,"readiness":"unverified","reasons":["entitlement_and_inference_unverified"],
+        "capabilities":{"text":true,"streaming":true,"terminal":true,"file_editing":true,"mcp":true},
+        "disabledFeatures":["image_generation","web_search","reasoning_summary"],
+        "defaultForAccount":false,"source":"operator-model-metadata"}]});
