+            ResponseItem::AgentMessage {
+                author,
+                recipient,
+                content,
+                ..
+            } => {
+                let text = codex_protocol::models::plaintext_agent_message_content(&content)
+                    .ok_or_else(|| held("opaque worker notification is not portable"))?;
+                if credential_bearing(&text) {
+                    return Err(held(
