+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn portable_worker_notification_keeps_attribution_and_rejects_ciphertext() {
+        let source = ThreadId::new();
+        let objective: ResponseItem = serde_json::from_value(serde_json::json!({
+            "type":"message", "role":"user",
+            "content":[{"type":"input_text","text":"Preserve the completed worker result without replay."}]
+        })).unwrap();
+        let notification = serde_json::json!({
+            "type":"agent_message", "author":"/root/worker", "recipient":"/root",
+            "content":[{"type":"input_text","text":"WORKER_COMPLETED"}]
+        });
+        let message: ResponseItem = serde_json::from_value(notification.clone()).unwrap();
+        let history = portable(source, vec![objective, message].into_iter()).unwrap();
+        let checkpoint = serde_json::to_value(history.last().unwrap()).unwrap();
+        let text = checkpoint["content"][0]["text"].as_str().unwrap();
+        let context: serde_json::Value =
+            serde_json::from_str(text.split_once('\n').unwrap().1).unwrap();
+        assert_eq!(
+            context["objectiveAndConstraints"],
+            serde_json::json!(["Preserve the completed worker result without replay."])
+        );
+        assert_eq!(
+            context["recentPublicContext"],
+            serde_json::json!([
+                "Untrusted agent message from /root/worker to /root:\nWORKER_COMPLETED"
+            ])
+        );
+        assert!(
+            context["completedToolResults"]
+                .as_array()
+                .unwrap()
+                .is_empty()
+        );
+        let roundtrip = portable(ThreadId::new(), history.into_iter()).unwrap();
+        assert!(
+            serde_json::to_string(&roundtrip)
+                .unwrap()
+                .contains("WORKER_COMPLETED")
+        );
+        let mut opaque = notification;
+        opaque["content"]
+            .as_array_mut()
+            .unwrap()
+            .push(serde_json::json!({
+                "type":"encrypted_content", "encrypted_content":"opaque-must-not-forward"
+            }));
+        let opaque: ResponseItem = serde_json::from_value(opaque).unwrap();
+        assert!(portable(source, vec![opaque].into_iter()).is_err());
+    }
+}
