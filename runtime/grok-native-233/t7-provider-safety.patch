index 0000000000000000000000000000000000000000..e32f0a56c10175c7e28b32f99cef666475cfcb90
--- /dev/null
+++ b/codex-rs/core/src/session/provider_safety.rs
@@ -0,0 +1,489 @@
+//! Durable Grok request intent and local scheduling fences. Numeric usage remains
+//! owned by the canonical rollout and the original shared allowance.
+use super::{Session, TurnContext};
+use crate::agent::control::LocalAgentRuntime;
+use crate::config::Config;
+use codex_model_provider_info::WireApi;
+use codex_protocol::ThreadId;
+use codex_protocol::error::{CodexErr, Result as CodexResult};
+use codex_protocol::inference_selection::InferenceSelectionSnapshot;
+use serde::{Deserialize, Serialize};
+use std::collections::HashMap;
+use std::io::{Read, Write};
+use std::path::PathBuf;
+use std::sync::{Arc, Mutex, OnceLock, Weak};
+use tokio::sync::Notify;
+use tokio_util::sync::CancellationToken;
+
+#[derive(Default)]
+struct LiveRequest {
+    turn: Mutex<Option<String>>,
+    changed: Arc<Notify>,
+}
+#[derive(Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Intent {
+    schema: u32,
+    kind: String,
+    thread_id: ThreadId,
+    original_session_id: String,
+    turn_id: String,
+    selection: Option<InferenceSelectionSnapshot>,
+    state: String,
+    reason: String,
+    strict_accounting: bool,
+    usage_unknown: bool,
+    provider_completion: String,
+    action_replay: String,
+}
+// Retain the existing controller, never a second token balance. A recovered
+// history cannot turn a new controller's zero spend into authority over old work.
+fn authorities() -> &'static Mutex<HashMap<String, LocalAgentRuntime>> {
+    static VALUE: OnceLock<Mutex<HashMap<String, LocalAgentRuntime>>> = OnceLock::new();
+    VALUE.get_or_init(Mutex::default)
+}
+fn retain_authority(session: &Session) -> CodexResult<()> {
+    if !session
+        .services
+        .local_agent_runtime
+        .rollout_budget_enforced()
+    {
+        return Ok(());
+    }
+    let root = session.services.agent_control.identity().to_string();
+    let mut values = authorities()
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    if let Some(original) = values.get(&root) {
+        if !original.shares_task_authority(&session.services.local_agent_runtime) {
+            return Err(held(
+                "original cumulative allowance authority is unavailable",
+            ));
+        }
+    } else {
+        if values.len() >= 8192 {
+            return Err(held("live allowance authority capacity reached"));
+        }
+        values.insert(root, session.services.local_agent_runtime.clone());
+    }
+    Ok(())
+}
+fn held(reason: &str) -> CodexErr {
+    CodexErr::Fatal(format!(
+        "Grok work held: {reason}; reconciliation and explicit reassignment required. Provider completion/usage are not confirmed by local Stop; uncertain actions will not be replayed."
+    ))
+}
+fn live(session: &Session) -> Arc<LiveRequest> {
+    session
+        .services
+        .thread_extension_data
+        .get_or_init(LiveRequest::default)
+}
+fn directory(config: &Config, create: bool) -> CodexResult<Option<PathBuf>> {
+    let path = config.codex_home.join("provider_safety").to_path_buf();
+    if create {
+        let mut builder = std::fs::DirBuilder::new();
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::DirBuilderExt;
+            builder.mode(0o700);
+        }
+        match builder.create(&path) {
+            Ok(()) => {}
+            Err(e) if e.kind() == std::io::ErrorKind::AlreadyExists => {}
+            Err(_) => return Err(held("cannot persist request intent before submission")),
+        }
+    }
+    let metadata = match std::fs::symlink_metadata(&path) {
+        Ok(value) => value,
+        Err(e) if e.kind() == std::io::ErrorKind::NotFound => return Ok(None),
+        Err(_) => return Err(held("cannot inspect request intent directory")),
+    };
+    if !metadata.is_dir() || metadata.file_type().is_symlink() {
+        return Err(held("invalid request intent directory"));
+    }
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::MetadataExt;
+        if metadata.uid() != unsafe { libc::geteuid() } || metadata.mode() & 0o077 != 0 {
+            return Err(held("request intent directory is not private and owned"));
+        }
+    }
+    Ok(Some(path))
+}
+fn read(config: &Config, name: &str) -> CodexResult<Option<Intent>> {
+    let Some(dir) = directory(config, false)? else {
+        return Ok(None);
+    };
+    let path = dir.join(name);
+    let metadata = match std::fs::symlink_metadata(&path) {
+        Ok(value) => value,
+        Err(e) if e.kind() == std::io::ErrorKind::NotFound => return Ok(None),
+        Err(_) => return Err(held("cannot inspect request intent")),
+    };
+    if !metadata.is_file() || metadata.file_type().is_symlink() || metadata.len() > 65536 {
+        return Err(held("invalid request intent"));
+    }
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::MetadataExt;
+        if metadata.uid() != unsafe { libc::geteuid() } || metadata.mode() & 0o077 != 0 {
+            return Err(held("request intent is not private and owned"));
+        }
+    }
+    let mut options = std::fs::OpenOptions::new();
+    options.read(true);
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::OpenOptionsExt;
+        options.custom_flags(libc::O_NOFOLLOW | libc::O_NONBLOCK);
+    }
+    let file = options
+        .open(&path)
+        .map_err(|_| held("cannot read request intent"))?;
+    let mut bytes = Vec::new();
+    file.take(65537)
+        .read_to_end(&mut bytes)
+        .map_err(|_| held("cannot read request intent"))?;
+    let record: Intent =
+        serde_json::from_slice(&bytes).map_err(|_| held("malformed request intent"))?;
+    if bytes.len() > 65536
+        || record.schema != 1
+        || record.action_replay != "forbidden"
+        || !matches!(
+            record.state.as_str(),
+            "request_pending" | "tools" | "held" | "completed"
+        )
+        || record.turn_id.len() > 128
+        || record.reason.len() > 128
+    {
+        return Err(held("unsupported request intent"));
+    }
+    Ok(Some(record))
+}
+fn save(config: &Config, name: &str, record: &Intent, first_only: bool) -> CodexResult<()> {
+    let dir =
+        directory(config, true)?.ok_or_else(|| held("request intent directory unavailable"))?;
+    let path = dir.join(name);
+    if first_only && read(config, name)?.is_some() {
+        return Ok(());
+    }
+    let mut temporary =
+        tempfile::NamedTempFile::new_in(&dir).map_err(|_| held("cannot stage request intent"))?;
+    serde_json::to_writer(temporary.as_file_mut(), record)
+        .map_err(|_| held("cannot encode request intent"))?;
+    temporary
+        .flush()
+        .map_err(|_| held("cannot flush request intent"))?;
+    temporary
+        .as_file()
+        .sync_all()
+        .map_err(|_| held("cannot sync request intent"))?;
+    if first_only {
+        match temporary.persist_noclobber(&path) {
+            Ok(_) => {}
+            Err(e) if e.error.kind() == std::io::ErrorKind::AlreadyExists => {}
+            Err(_) => return Err(held("cannot commit unknown accounting fence")),
+        }
+    } else {
+        temporary
+            .persist(&path)
+            .map_err(|_| held("cannot commit request intent"))?;
+    }
+    std::fs::File::open(&dir)
+        .and_then(|f| f.sync_all())
+        .map_err(|_| held("cannot sync request intent directory"))?;
+    Ok(())
+}
+fn own_name(session: &Session) -> String {
+    format!("{}.json", session.thread_id)
+}
+fn root_name(session: &Session) -> String {
+    format!(
+        "accounting-{}.json",
+        session.services.agent_control.identity()
+    )
+}
+fn unknown_accounting(session: &Session, config: &Config, record: &Intent) -> CodexResult<()> {
+    if record.strict_accounting && record.usage_unknown {
+        let mut marker = record.clone();
+        marker.kind = "accounting_unknown".into();
+        save(config, &root_name(session), &marker, true)?;
+    }
+    Ok(())
+}
+pub(crate) async fn check_admission(session: &Session) -> CodexResult<()> {
+    let config = session.get_config().await;
+    let root = session.services.agent_control.identity().to_string();
+    if let Some(marker) = read(&config, &root_name(session))? {
+        if marker.original_session_id != root || marker.kind != "accounting_unknown" {
+            return Err(held("unknown allowance attribution"));
+        }
+        return Err(held("original shared allowance accounting is unknown"));
+    }
+    let Some(record) = read(&config, &own_name(session))? else {
+        return Ok(());
+    };
+    if record.thread_id != session.thread_id
+        || record.original_session_id != root
+        || record.kind != "thread"
+    {
+        return Err(held("request ownership cannot be attributed"));
+    }
+    if record.state == "completed" {
+        if record.strict_accounting {
+            let values = authorities()
+                .lock()
+                .unwrap_or_else(std::sync::PoisonError::into_inner);
+            if !values.get(&root).is_some_and(|original| {
+                original.shares_task_authority(&session.services.local_agent_runtime)
+            }) {
+                return Err(held(
+                    "original cumulative allowance authority is unavailable",
+                ));
+            }
+        }
+        return Ok(());
+    }
+    if record.state != "held" {
+        let active = session.active_turn.lock().await;
+        let same = active
+            .as_ref()
+            .and_then(|t| t.task.as_ref())
+            .is_some_and(|t| t.turn_context.sub_id == record.turn_id);
+        if same
+            && live(session)
+                .turn
+                .lock()
+                .unwrap_or_else(std::sync::PoisonError::into_inner)
+                .as_deref()
+                == Some(record.turn_id.as_str())
+        {
+            return Ok(());
+        }
+    }
+    Err(held(&record.reason))
+}
+pub(crate) async fn begin_request(
+    session: &Arc<Session>,
+    turn: &Arc<TurnContext>,
+) -> CodexResult<()> {
+    check_admission(session).await?;
+    check_account_config(&turn.config).await?;
+    if turn.config.model_provider.wire_api != WireApi::Grok {
+        return Ok(());
+    }
+    retain_authority(session)?;
+    let state = live(session);
+    let mut active = state
+        .turn
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    if read(&turn.config, &own_name(session))?.is_some_and(|r| r.state == "request_pending") {
+        return Err(held("previous provider request completion is unknown"));
+    }
+    let record = Intent {
+        schema: 1,
+        kind: "thread".into(),
+        thread_id: session.thread_id,
+        original_session_id: session.services.agent_control.identity().to_string(),
+        turn_id: turn.sub_id.clone(),
+        selection: turn.config.inference_selection.clone(),
+        state: "request_pending".into(),
+        reason: "provider_request_unobserved".into(),
+        strict_accounting: session
+            .services
+            .local_agent_runtime
+            .rollout_budget_enforced(),
+        usage_unknown: true,
+        provider_completion: "unconfirmed".into(),
+        action_replay: "forbidden".into(),
+    };
+    save(&turn.config, &own_name(session), &record, false)?;
+    let start_monitor = active.as_deref() != Some(turn.sub_id.as_str());
+    *active = Some(turn.sub_id.clone());
+    drop(active);
+    if start_monitor && turn.config.inference_catalog_command.is_some() {
+        start_account_monitor(Arc::downgrade(session), Arc::clone(turn), state);
+    }
+    Ok(())
+}
+pub(crate) fn hold(session: &Session, turn: &TurnContext, reason: &str) -> CodexResult<bool> {
+    if turn.config.model_provider.wire_api != WireApi::Grok {
+        return Ok(false);
+    }
+    let state = live(session);
+    let mut active = state
+        .turn
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    let Some(mut record) = read(&turn.config, &own_name(session))? else {
+        return Ok(false);
+    };
+    if record.turn_id != turn.sub_id || record.state == "completed" {
+        return Ok(false);
+    }
+    if record.state != "held" {
+        record.state = "held".into();
+        record.reason = reason.into();
+    }
+    unknown_accounting(session, &turn.config, &record)?;
+    save(&turn.config, &own_name(session), &record, false)?;
+    *active = None;
+    state.changed.notify_waiters();
+    Ok(true)
+}
+pub(crate) fn response_completed(
+    session: &Session,
+    turn: &TurnContext,
+    usage_known: bool,
+    budget_admitted: bool,
+) -> CodexResult<()> {
+    if turn.config.model_provider.wire_api != WireApi::Grok {
+        return Ok(());
+    }
+    let state = live(session);
+    let _active = state
+        .turn
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    let Some(mut record) = read(&turn.config, &own_name(session))? else {
+        return Err(held("response intent missing"));
+    };
+    if record.turn_id != turn.sub_id || record.state == "held" {
+        return Err(held("response is no longer admitted"));
+    }
+    record.provider_completion = "observed".into();
+    record.usage_unknown = !usage_known;
+    record.state = "tools".into();
+    if !budget_admitted {
+        record.state = "held".into();
+        record.reason = "original_allowance_exhausted".into();
+    }
+    if !usage_known && record.strict_accounting {
+        record.state = "held".into();
+        record.reason = "response_accounting_missing".into();
+        unknown_accounting(session, &turn.config, &record)?;
+    }
+    save(&turn.config, &own_name(session), &record, false)?;
+    state.changed.notify_waiters();
+    if record.state == "held" {
+        return Err(held(&record.reason));
+    }
+    Ok(())
+}
+pub(crate) async fn finish_turn(session: &Session, turn: &TurnContext) -> CodexResult<()> {
+    if turn.config.model_provider.wire_api != WireApi::Grok {
+        return Ok(());
+    }
+    session.flush_rollout().await.map_err(CodexErr::Io)?;
+    let state = live(session);
+    let mut active = state
+        .turn
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    if let Some(mut record) = read(&turn.config, &own_name(session))? {
+        if record.turn_id != turn.sub_id {
+            return Ok(());
+        }
+        if record.state != "tools" {
+            return Err(held(&record.reason));
+        }
+        record.state = "completed".into();
+        record.reason = "completed".into();
+        save(&turn.config, &own_name(session), &record, false)?;
+    }
+    if active.as_deref() == Some(turn.sub_id.as_str()) {
+        *active = None;
+    }
+    state.changed.notify_waiters();
+    Ok(())
+}
+pub(crate) async fn admit_tool(
+    session: &Session,
+    turn: &TurnContext,
+    cancellation: &CancellationToken,
+) -> CodexResult<()> {
+    let state = live(session);
+    loop {
+        let changed = state.changed.clone().notified_owned();
+        tokio::pin!(changed);
+        changed.as_mut().enable();
+        check_admission(session).await?;
+        check_account_config(&turn.config).await?;
+        let wait = turn.config.model_provider.wire_api == WireApi::Grok
+            && read(&turn.config, &own_name(session))?
+                .is_some_and(|r| r.strict_accounting && r.state == "request_pending");
+        if !wait {
+            return Ok(());
+        }
+        tokio::select! { biased;
+            _ = cancellation.cancelled() => return Err(CodexErr::TurnAborted),
+            _ = &mut changed => {},
+        }
+    }
+}
+
+async fn revocation_observed(config: &Config) -> CodexResult<bool> {
+    if config.model_provider.wire_api != WireApi::Grok {
+        return Ok(false);
+    }
+    let Some(command) = config.inference_catalog_command.as_ref() else {
+        return Ok(false);
+    };
+    let accepted = config
+        .inference_selection
+        .as_ref()
+        .ok_or_else(|| held("selected account identity unavailable"))?;
+    let catalog = crate::inference_selection::load_catalog(Some(command))
+        .await
+        .map_err(|_| held("selected account authorization unavailable"))?;
+    crate::inference_selection::account_revoked(&catalog, accepted)
+        .map_err(|_| held("selected account authorization unverified"))
+}
+async fn check_account_config(config: &Config) -> CodexResult<()> {
+    if revocation_observed(config).await? {
+        return Err(held("selected account revoked or registration replaced"));
+    }
+    Ok(())
+}
+pub(crate) async fn check_account(session: &Session) -> CodexResult<()> {
+    let config = session.get_config().await;
+    check_account_config(&config).await
+}
+fn start_account_monitor(session: Weak<Session>, turn: Arc<TurnContext>, state: Arc<LiveRequest>) {
+    tokio::spawn(async move {
+        loop {
+            tokio::time::sleep(std::time::Duration::from_secs(1)).await;
+            if state
+                .turn
+                .lock()
+                .unwrap_or_else(std::sync::PoisonError::into_inner)
+                .as_deref()
+                != Some(turn.sub_id.as_str())
+            {
+                break;
+            }
+            let Some(session) = session.upgrade() else {
+                break;
+            };
+            // An unavailable source is not semantic revocation. Immediate tool
+            // and request admission still holds when authorization cannot be read.
+            if !matches!(revocation_observed(&turn.config).await, Ok(true)) {
+                continue;
+            }
+            let _ = hold(&session, &turn, "account_revoked_or_replaced");
+            let account = turn
+                .config
+                .inference_selection
+                .as_ref()
+                .map(|value| value.selection.account_id.as_str())
+                .unwrap_or("unattributed");
+            session.abort_turn_if_active(&turn.sub_id, codex_protocol::protocol::TurnAbortReason::Interrupted,
+                Some(codex_protocol::protocol::ErrorEvent {misalignment:None, codex_error_info:None,
+                    message:format!("Grok account {account} was revoked or replaced. Owned work is held locally; provider completion and usage remain unconfirmed. Reconcile retained evidence before explicit reassignment; no uncertain replay.")
+                })).await;
+            break;
+        }
+    });
+}
