@@ -229,0 +230,51 @@ pub fn snapshots(catalog: &InferenceCatalog) -> io::Result<Vec<InferenceSelectio
+/// A semantic account generation event is separate from unrelated catalog
+/// updates and from unconfirmed credential-file absence.
+pub(crate) fn account_revoked(
+    catalog: &InferenceCatalog,
+    accepted: &InferenceSelectionSnapshot,
+) -> io::Result<bool> {
+    let provider = catalog
+        .providers
+        .get(&accepted.selection.provider_id)
+        .ok_or_else(held)?;
+    provider.validate().map_err(|_| held())?;
+    if provider.wire_api != WireApi::Grok
+        || provider.base_url.as_deref() != Some("https://cli-chat-proxy.grok.com/v1")
+    {
+        return Err(held());
+    }
+    let auth = provider.auth.as_ref().ok_or_else(held)?;
+    let tail: Vec<_> = auth
+        .args
+        .iter()
+        .rev()
+        .take(6)
+        .map(|argument| argument.as_str())
+        .collect();
+    if tail.len() != 6
+        || tail[1..]
+            != [
+                "--expected-account-revision",
+                accepted.selection.account_id.as_str(),
+                "token",
+                "auth",
+                "grok",
+            ]
+        || auth.refresh_interval_ms != 0
+        || !std::path::Path::new(&auth.command).is_absolute()
+    {
+        return Err(held());
+    }
+    if tail[0] != accepted.selection.account_revision.as_str() {
+        return Ok(true);
+    }
+    Ok(catalog.selections.iter().any(|row| {
+        row.provider_id == accepted.selection.provider_id
+            && row.account_id == accepted.selection.account_id
+            && row
+                .reasons
+                .iter()
+                .any(|reason| reason == "authentication_revoked")
+    }))
+}
+
