+#[test_case("provider"; "provider held")]
+#[test_case("incomplete"; "incomplete held")]
+#[test_case("missing_usage"; "missing usage cannot dispatch tool")]
+#[test_case("compact_missing_usage"; "compaction preserves uncertainty")]
+#[test_case("cold_known"; "cold known history cannot reset allowance")]
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn grok_failures_hold_without_uncertain_replay(case: &str) -> anyhow::Result<()> {
+    use codex_model_provider_info::{ModelProviderInfo, WireApi};
+    use std::sync::atomic::{AtomicUsize, Ordering};
+    use wiremock::matchers::{method, path};
+    use wiremock::{Mock, ResponseTemplate};
+    let server = start_mock_server().await;
+    let effects = tempfile::tempdir()?;
+    let forbidden = effects.path().join("unknown-action-must-not-run");
+    let calls = Arc::new(AtomicUsize::new(0));
+    let observed = calls.clone();
+    let known = case == "cold_known";
+    let status = match case {
+        "auth" => 401,
+        "quota" => 429,
+        "provider" => 503,
+        _ => 200,
+    };
+    let body = if status != 200 {
+        json!({"error":{"message":"synthetic provider rejection","type":"fixture"}}).to_string()
+    } else if case == "missing_usage" {
+        let arguments =
+            json!({"cmd":format!("touch '{}'",forbidden.display()),"yield_time_ms":1000})
+                .to_string();
+        format!(
+            "data: {}\n\ndata: [DONE]\n\n",
+            json!({"id":"missing-usage","model":"grok-build","choices":[{"index":0,"delta":{"tool_calls":[{"index":0,"id":"unknown-action","type":"function","function":{"name":"exec_command","arguments":arguments}}]},"finish_reason":"tool_calls"}]})
+        )
+    } else {
+        let chunk = json!({"id":"safety-answer","model":"grok-build","choices":[{"index":0,"delta":{"content":"synthetic answer"},"finish_reason":if case=="incomplete" {serde_json::Value::Null} else {json!("stop")}}]});
+        let mut body = format!("data: {chunk}\n\n");
+        if known {
+            body.push_str(&format!("data: {}\n\n",json!({"id":"safety-answer","model":"grok-build","choices":[],"usage":{"prompt_tokens":5,"completion_tokens":3,"total_tokens":8}})));
+        }
+        if case != "incomplete" {
+            body.push_str("data: [DONE]\n\n");
+        }
+        body
+    };
+    Mock::given(method("POST"))
+        .and(path("/v1/chat/completions"))
+        .respond_with(move |_: &wiremock::Request| {
+            observed.fetch_add(1, Ordering::SeqCst);
+            ResponseTemplate::new(status)
+                .insert_header("content-type", "text/event-stream")
+                .set_body_string(body.clone())
+        })
+        .mount(&server)
+        .await;
+    let auth = crate::suite::client::ProviderAuthCommandFixture::new(&[
+        "synthetic-grok-bearer",
+        "unused-retry-bearer",
+    ])?;
+    let auth_info = auth.auth();
+    let base_url = format!("{}/v1", server.uri());
+    let fixture = test_codex().with_model_info_override("gpt-5.4", |model| {
+        model.slug = "grok-build".into();
+        model.use_responses_lite = false;
+        model.supports_search_tool = false;
+        model.tool_mode = Some(codex_protocol::openai_models::ToolMode::Direct);
+    }).with_config(move |config| {
+        config.model = Some("grok-build".into());
+        config.model_provider_id = "grok__personal".into();
+        config.model_provider = ModelProviderInfo {name:"grok".into(), wire_api:WireApi::Grok,
+            base_url:Some(base_url), auth:Some(auth_info), ..Default::default()};
+        config.inference_selection = Some(serde_json::from_value(json!({
+            "providerRevision":"fixture-provider","sourceRevision":"fixture-source","revision":"fixture-snapshot",
+            "selection":{"providerId":"grok__personal","accountId":"personal","accountRevision":"account-v1",
+            "modelId":"grok-build","catalogRevision":"catalog-v1","evidenceRevision":"fixture-coding-proof",
+            "selectionId":"fixture-choice","accountLabel":"Personal Grok","displayName":"Grok Build","contextWindow":32000,
+            "readiness":"qualified","reasons":[],"capabilities":{"text":true,"streaming":true,"terminal":true,"file_editing":true,"mcp":true},
+            "disabledFeatures":[],"defaultForAccount":true,"source":"synthetic-native-fixture"}
+        })).unwrap());
+        config.rollout_budget = Some(codex_core::config::RolloutBudgetConfig {
+            enforce_limit:true, limit_tokens:80, reminder_at_remaining_tokens:vec![20],
+            sampling_token_weight:1.0, prefill_token_weight:1.0,
+        });
+        for feature in [Feature::CodeMode,Feature::CodeModeOnly,Feature::CodeModeToolSearch,
+            Feature::CodeModeHost,Feature::ToolSearch,Feature::ToolSearchAlwaysDeferMcpTools] {
+            config.features.disable(feature).unwrap();
+        }
+    }).build(&server).await?;
+
+    if case == "compact_missing_usage" {
+        fixture.codex.submit(Op::Compact).await?;
+    } else {
+        fixture
+            .codex
+            .start_or_steer_turn(TurnInputRequest::user_input(vec![UserInput::Text {
+                text: "Synthetic failure/recovery acceptance".into(),
+                text_elements: vec![],
+            }]))
+            .await?;
+    }
+    tokio::time::timeout(Duration::from_secs(15), async {
+        let mut saw_held = false;
+        loop {
+            let event = fixture.codex.next_event().await.expect("native event").msg;
+            match event {
+                EventMsg::TurnComplete(done) => {
+                    if known {
+                        assert!(done.error.is_none(), "known completion: {done:?}");
+                    } else {
+                        assert!(
+                            saw_held && done.error.is_some(),
+                            "uncertain request completed without hold: {done:?}"
+                        );
+                    }
+                    break;
+                }
+                EventMsg::Error(error) if !known => {
+                    assert!(
+                        error.message.contains("held"),
+                        "actionable held error: {}",
+                        error.message
+                    );
+                    saw_held = true;
+                }
+                EventMsg::Error(error) => panic!("known response failed: {}", error.message),
+                _ => {}
+            }
+        }
+    })
+    .await?;
+    assert!(
+        !forbidden.exists(),
+        "missing accounting must block local effects"
+    );
+    assert_eq!(
+        calls.load(Ordering::SeqCst),
+        1,
+        "no provider retry/fallback"
+    );
+    fixture.codex.flush_rollout().await?;
+    if let Some(directory) = std::env::var_os("P233_CANONICAL_EVIDENCE_DIR") {
+        let capture = std::path::PathBuf::from(directory).join(format!("failure-{case}"));
+        std::fs::create_dir_all(capture.join("sessions"))?;
+        std::fs::copy(
+            fixture
+                .codex
+                .rollout_path()
+                .expect("durable failure evidence"),
+            capture.join("sessions/source.jsonl"),
+        )?;
+        std::fs::write(
+            capture.join("root-thread-id"),
+            fixture.session_configured.thread_id.to_string(),
+        )?;
+    }
+    if known {
+        fixture.codex.flush_rollout().await?;
+        let rollout = fixture.codex.rollout_path().expect("known durable history");
+        let original = fixture.config.clone();
+        fixture.codex.shutdown_and_wait().await?;
+        fixture
+            .thread_manager
+            .remove_thread(&fixture.session_configured.thread_id)
+            .await
+            .expect("owned unload");
+        let recovered = test_codex()
+            .with_model_info_override("gpt-5.4", |model| {
+                model.slug = "grok-build".into();
+                model.use_responses_lite = false;
+                model.supports_search_tool = false;
+                model.tool_mode = Some(codex_protocol::openai_models::ToolMode::Direct);
+            })
+            .with_config(move |config| {
+                *config = original;
+                config.rollout_budget.as_mut().unwrap().limit_tokens = 900;
+            })
+            .resume(&server, fixture.home.clone(), rollout)
+            .await?;
+        let input = recovered
+            .codex
+            .start_or_steer_turn(TurnInputRequest::user_input(vec![UserInput::Text {
+                text: "Cannot reset original cumulative allowance".into(),
+                text_elements: vec![],
+            }]))
+            .await;
+        assert!(
+            input.is_err(),
+            "cold history must not authorize a fresh zero-spend allowance"
+        );
+    } else {
+        let input = fixture
+            .codex
+            .start_or_steer_turn(TurnInputRequest::user_input(vec![UserInput::Text {
+                text: "Explicit reconciliation/reassignment required".into(),
+                text_elements: vec![],
+            }]))
+            .await;
+        assert!(input.is_err(), "uncertainty must hold next turn");
+    }
+    assert_eq!(calls.load(Ordering::SeqCst), 1);
+    Ok(())
+}
