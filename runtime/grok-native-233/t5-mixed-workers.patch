+        "auth":{"command":"/bin/false","args":["grok","auth","token","personal","--expected-account-revision","account-v1"],"cwd":"/","timeout_ms":1000,"refresh_interval_ms":0}}},
diff --git a/codex-rs/core/src/agent/child_config.rs b/codex-rs/core/src/agent/child_config.rs
index 96d9675f63..17d537d623 100644
--- a/codex-rs/core/src/agent/child_config.rs
+++ b/codex-rs/core/src/agent/child_config.rs
@@ -221,3 +221,14 @@ async fn apply_requested_spawn_agent_model_overrides(
-        let available_models = session
-            .services
-            .models_manager
+        let openai_provider = (config.model_provider.wire_api
+            == codex_model_provider_info::WireApi::Grok)
+            .then(|| config.model_providers.get("openai").cloned())
+            .flatten();
+        let models_manager = if let Some(provider) = &openai_provider {
+            let mut openai_config = config.clone();
+            openai_config.model_provider_id = "openai".into();
+            openai_config.model_provider = provider.clone();
+            openai_config.inference_selection = None;
+            crate::build_models_manager(&openai_config, session.services.auth_manager.clone())
+        } else {
+            session.services.models_manager.clone()
+        };
+        let available_models = models_manager
@@ -230,4 +241,53 @@ async fn apply_requested_spawn_agent_model_overrides(
-        )?;
-        let selected_model_info = session
-            .services
-            .models_manager
+        );
+        if requested_model.starts_with("grok__")
+            || (selected_model_name.is_err() && config.inference_catalog_command.is_some())
+        {
+            let catalog =
+                crate::inference_selection::load_catalog(config.inference_catalog_command.as_ref())
+                    .await
+                    .map_err(|_| "Worker inference catalog unavailable".to_string())?;
+            let mut choices = crate::inference_selection::snapshots(&catalog)
+                .map_err(|_| "Worker inference catalog unavailable".to_string())?
+                .into_iter()
+                .filter(|snapshot| {
+                    snapshot.selection.selection_id == requested_model
+                        || (snapshot.selection.provider_id == requested_model
+                            && snapshot.selection.default_for_account)
+                });
+            let requested = choices.next().ok_or_else(|| {
+                "Worker requires an explicit qualified account default".to_string()
+            })?;
+            if choices.next().is_some() {
+                return Err("Worker account default is ambiguous".to_string());
+            }
+            let (selection, provider) =
+                crate::inference_selection::resolve(&catalog, Some(&requested))
+                    .map_err(|_| {
+                        "Worker inference selection unavailable, stale or unqualified".to_string()
+                    })?
+                    .ok_or_else(|| "Worker inference selection missing".to_string())?;
+            if requested_reasoning_effort.is_some() {
+                return Err("Reasoning effort is unsupported for this Grok selection".to_string());
