+/// Ordinary worker delegation resolves a qualified account default before child startup.
+/// Private auth deliberately fails locally, so this selection test cannot submit inference.
+#[cfg(unix)]
+#[test_case("grok__personal"; "account default")]
+#[test_case("selection-v1"; "exact selection")]
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn spawn_agent_selects_grok_account_default_under_existing_parent(
+    selector: &str,
+) -> Result<()> {
+    let server = start_mock_server().await;
+    let catalog_home = tempfile::tempdir()?;
+    let source = catalog_home.path().join("inference.json");
+    std::fs::write(
+        &source,
+        serde_json::to_vec(&json!({
+            "schemaVersion": 1, "sourceRevision": "worker-qualified-v1",
+            "providers": {"grok__personal": {
+                "name": "Personal Grok", "wire_api": "grok",
+                "base_url": "https://cli-chat-proxy.grok.com/v1",
+                "auth": {"command": "/bin/false", "cwd": "/", "timeout_ms": 1000,
+                    "refresh_interval_ms": 0,
+                    "args": ["grok", "auth", "token", "personal", "--expected-account-revision", "account-v1"]}
+            }},
+            "selections": [{"providerId": "grok__personal", "accountId": "personal",
+                "accountRevision": "account-v1", "modelId": "grok-build",
+                "catalogRevision": "catalog-v1", "evidenceRevision": "independent-coding-v1",
+                "selectionId": "selection-v1", "accountLabel": "Personal Grok",
+                "displayName": "Grok Build", "contextWindow": 32000, "readiness": "qualified",
+                "reasons": [], "capabilities": {"text": true, "streaming": true,
+                    "terminal": true, "file_editing": true, "mcp": true},
+                "disabledFeatures": ["image_generation", "web_search", "reasoning_summary"],
+                "defaultForAccount": selector == "grok__personal", "source": "independent-account-receipt"}]
+        }))?,
+    )?;
+    let child = spawn_child_and_capture_snapshot(
+        &server,
+        json!({"message": CHILD_PROMPT, "model": selector}),
+        |builder| {
+            builder.with_config(move |config| {
+                config.inference_catalog_command = Some(
+                    codex_protocol::inference_selection::InferenceCatalogCommand {
+                        command: "/bin/cat".into(),
+                        args: vec![source.display().to_string()],
+                        cwd: "/".into(),
+                        timeout_ms: 1000,
+                    },
+                );
+            })
+        },
+    )
+    .await?;
+    assert_eq!(child.model_provider_id, "grok__personal");
+    assert_eq!(child.model, "grok-build");
+    assert_eq!(child.reasoning_effort, None);
+    assert_eq!(child.service_tier, None);
+    assert!(child.parent_thread_id.is_some());
+    Ok(())
+}
