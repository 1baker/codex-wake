+    .await;
+    if let EventMsg::Error(error) = completed {
+        anyhow::bail!("Grok parent failed before delegation: {}", error.message);
+    }
+    test.codex.flush_rollout().await?;
+    let rollout =
+        tokio::fs::read_to_string(test.codex.rollout_path().expect("parent rollout")).await?;
