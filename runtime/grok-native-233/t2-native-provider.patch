diff --git a/codex-rs/codex-api/src/grok.rs b/codex-rs/codex-api/src/grok.rs
new file mode 100644
index 0000000000000000000000000000000000000000..4af9a192d00d7a7d734415119fd13ce4f2b7f532
--- /dev/null
+++ b/codex-rs/codex-api/src/grok.rs
@@ -0,0 +1,233 @@
+//! Grok session-proxy compatibility. This is deliberately not a generic chat provider.
+use crate::common::ResponsesApiRequest;
+use crate::error::ApiError;
+use codex_protocol::models::ResponseItem;
+use serde_json::Value;
+use serde_json::json;
+use std::collections::BTreeMap;
+use std::collections::HashSet;
+
+#[derive(Clone)]
+pub(crate) struct Tool {
+    pub name: String,
+    pub namespace: Option<String>,
+    pub custom: bool,
+}
+
+pub(crate) fn invalid(reason: &str) -> ApiError {
+    ApiError::InvalidRequest {
+        message: format!("Grok request held: {reason}"),
+    }
+}
+
+fn string<'a>(value: &'a Value, key: &str) -> Result<&'a str, ApiError> {
+    value
+        .get(key)
+        .and_then(Value::as_str)
+        .filter(|s| !s.is_empty())
+        .ok_or_else(|| invalid("missing required history/tool field"))
+}
+
+fn add_tools(
+    values: &[Value],
+    namespace: Option<&str>,
+    tools: &mut Vec<Value>,
+    names: &mut BTreeMap<String, Tool>,
+) -> Result<(), ApiError> {
+    for value in values {
+        let kind = string(value, "type")?;
+        if kind == "namespace" {
+            if namespace.is_some() {
+                return Err(invalid("nested tool namespace is unsupported"));
+            }
+            add_tools(
+                value["tools"]
+                    .as_array()
+                    .ok_or_else(|| invalid("invalid tool namespace"))?,
+                Some(string(value, "name")?),
+                tools,
+                names,
+            )?;
+            continue;
+        }
+        if kind != "function" && kind != "custom" {
+            return Err(invalid("unsupported provider tool capability"));
+        }
+        let name = string(value, "name")?.to_owned();
+        if names
+            .values()
+            .any(|t| t.name == name && t.namespace.as_deref() == namespace)
+        {
+            return Err(invalid("duplicate tool declaration"));
+        }
+        // The wire alias is request-local; native names and namespaces are never guessed from it.
+        let alias = format!("codex_tool_{}", names.len());
+        let custom = kind == "custom";
+        let parameters = if custom {
+            json!({"type":"object", "properties":{"input":{"type":"string"}}, "required":["input"], "additionalProperties":false})
+        } else {
+            value
+                .get("parameters")
+                .cloned()
+                .ok_or_else(|| invalid("tool has no parameters"))?
+        };
+        let label = namespace
+            .map(|n| format!("{n}.{name}"))
+            .unwrap_or_else(|| name.clone());
+        let description = format!(
+            "{label}: {}",
+            value["description"].as_str().unwrap_or_default()
+        );
+        tools.push(json!({"type":"function","function":{"name":alias,"description":description,"parameters":parameters}}));
+        names.insert(
+            alias,
+            Tool {
+                name,
+                namespace: namespace.map(str::to_owned),
+                custom,
+            },
+        );
+    }
+    Ok(())
+}
+
+type PreparedRequest = (Value, BTreeMap<String, Tool>, HashSet<String>);
+
+pub(crate) fn convert(request: &ResponsesApiRequest) -> Result<PreparedRequest, ApiError> {
+    if request.model.trim().is_empty() {
+        return Err(invalid("model selection is missing"));
+    }
+    if request
+        .text
+        .as_ref()
+        .is_some_and(|text| text.format.is_some())
+    {
+        return Err(invalid("structured output is not qualified"));
+    }
+    if request.service_tier.is_some() {
+        return Err(invalid("service-tier billing selection is not qualified"));
+    }
+    if request.access_programs.is_some() {
+        return Err(invalid("access programs are unsupported"));
+    }
+    let mut tools = Vec::new();
+    let mut names = BTreeMap::new();
+    if let Some(raw) = &request.tools {
+        let values: Vec<Value> = serde_json::from_str(raw.as_raw_value().get())
+            .map_err(|_| invalid("invalid tool declarations"))?;
+        add_tools(&values, None, &mut tools, &mut names)?;
+    }
+    let mut messages = Vec::new();
+    let mut pending = HashSet::new();
+    let mut seen = HashSet::new();
+    for item in &request.input {
+        let value =
+            serde_json::to_value(item).map_err(|_| invalid("history serialization failed"))?;
+        match item {
+            ResponseItem::Message { .. } => {
+                if !pending.is_empty() {
+                    return Err(invalid("tool results missing before next message"));
+                }
+                let role = string(&value, "role")?;
+                if !matches!(role, "developer" | "system" | "user" | "assistant") {
+                    return Err(invalid("unsupported message role"));
+                }
+                let content = value["content"]
+                    .as_array()
+                    .ok_or_else(|| invalid("invalid message content"))?;
+                let mut text = String::new();
+                for part in content {
+                    if !matches!(part["type"].as_str(), Some("input_text" | "output_text")) {
+                        return Err(invalid("non-text content is not qualified"));
+                    }
+                    text.push_str(
+                        part["text"]
+                            .as_str()
+                            .ok_or_else(|| invalid("invalid text content"))?,
+                    );
+                }
+                messages.push(
+                    json!({"role":if role=="developer" {"system"} else {role},"content":text}),
+                );
+            }
+            ResponseItem::FunctionCall { .. } | ResponseItem::CustomToolCall { .. } => {
+                let call_id = string(&value, "call_id")?;
+                if !seen.insert(call_id.to_owned()) {
+                    return Err(invalid("duplicate historical tool call ID"));
+                }
+                pending.insert(call_id.to_owned());
+                let custom = matches!(item, ResponseItem::CustomToolCall { .. });
+                let name = string(&value, "name")?;
+                let namespace = value["namespace"].as_str();
+                let (alias, _) = names
+                    .iter()
+                    .find(|(_, t)| {
+                        t.name == name && t.namespace.as_deref() == namespace && t.custom == custom
+                    })
+                    .ok_or_else(|| invalid("history references an unavailable tool"))?;
+                let arguments = if custom {
+                    json!({"input":value["input"]}).to_string()
+                } else {
+                    string(&value, "arguments")?.to_owned()
+                };
+                let parsed: Value = serde_json::from_str(&arguments)
+                    .map_err(|_| invalid("malformed historical arguments"))?;
+                if !parsed.is_object() {
+                    return Err(invalid("tool arguments must be an object"));
+                }
+                let call = json!({"id":call_id,"type":"function","function":{"name":alias,"arguments":arguments}});
+                if let Some(last) = messages
+                    .last_mut()
+                    .filter(|m| m.get("tool_calls").is_some())
+                {
+                    last["tool_calls"]
+                        .as_array_mut()
+                        .ok_or_else(|| invalid("invalid tool history"))?
+                        .push(call);
+                } else {
+                    messages.push(json!({"role":"assistant","tool_calls":[call]}));
+                }
+            }
+            ResponseItem::FunctionCallOutput { .. } | ResponseItem::CustomToolCallOutput { .. } => {
+                let call_id = string(&value, "call_id")?;
+                if !pending.remove(call_id) {
+                    return Err(invalid("unknown or duplicate tool result"));
+                }
+                let content = match &value["output"] {
+                    Value::String(s) => s.clone(),
+                    Value::Array(parts) => {
+                        let mut text = String::new();
+                        for part in parts {
+                            if part["type"] != "input_text" {
+                                return Err(invalid("non-text tool output is not qualified"));
+                            }
+                            text.push_str(
+                                part["text"]
+                                    .as_str()
+                                    .ok_or_else(|| invalid("invalid tool output"))?,
+                            );
+                        }
+                        text
+                    }
+                    _ => return Err(invalid("unsupported tool output")),
+                };
+                messages.push(json!({"role":"tool","tool_call_id":call_id,"content":content}));
+            }
+            // Opaque reasoning must never cross the provider boundary. Visible context stays intact.
+            ResponseItem::Reasoning { .. } => {}
+            _ => {
+                return Err(invalid(
+                    "unsupported history item; linked continuation required",
+                ));
+            }
+        }
+    }
+    if !pending.is_empty() {
+        return Err(invalid("unresolved tool call in history"));
+    }
+    Ok((
+        json!({"model":request.model,"stream":true,"stream_options":{"include_usage":true},"messages":messages,"tools":tools,"tool_choice":"auto","parallel_tool_calls":request.parallel_tool_calls}),
+        names,
+        seen,
+    ))
+}
