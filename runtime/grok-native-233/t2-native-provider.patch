+}
+
+#[test]
+fn grok_session_transport_cannot_select_ambient_or_api_key_auth() {
+    let mut info = ModelProviderInfo {
+        name: "grok".into(),
+        wire_api: WireApi::Grok,
+        base_url: Some("https://cli-chat-proxy.grok.com/v1".into()),
+        ..Default::default()
+    };
+    assert!(info.validate().is_err());
