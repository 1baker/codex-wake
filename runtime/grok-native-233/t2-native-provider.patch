diff --git a/codex-rs/codex-api/src/sse/grok.rs b/codex-rs/codex-api/src/sse/grok.rs
new file mode 100644
index 0000000000000000000000000000000000000000..1a6445fe84dff2e4f4392ac3cd4041c7972c2a42
--- /dev/null
+++ b/codex-rs/codex-api/src/sse/grok.rs
@@ -0,0 +1,389 @@
+//! Normalize Grok's Chat Completions stream without admitting partial tool effects.
+use crate::common::ResponseEvent;
+use crate::common::ResponseStream;
+use crate::error::ApiError;
+use crate::grok::Tool;
+use codex_client::StreamResponse;
+use codex_protocol::error::ResponseIncompleteError;
+use codex_protocol::models::ResponseItem;
+use codex_protocol::protocol::TokenUsage;
+use eventsource_stream::Eventsource;
+use futures::StreamExt;
+use serde_json::Value;
+use serde_json::json;
+use std::collections::BTreeMap;
+use std::collections::HashSet;
+use std::time::Duration;
+use tokio::sync::mpsc;
+
+#[derive(Default)]
+struct Call {
+    id: String,
+    name: String,
+    arguments: String,
+}
+
+#[derive(Default)]
+struct State {
+    id: Option<String>,
+    model: Option<String>,
+    text: String,
+    calls: BTreeMap<u64, Call>,
+    finish: Option<String>,
+    usage: Option<TokenUsage>,
+    bytes: usize,
+}
+
+impl State {
+    fn held(&self, reason: &str) -> ApiError {
+        ApiError::ResponseIncomplete(Box::new(ResponseIncompleteError {
+            reason: format!("Grok completion unknown: {reason}; automatic replay withheld"),
+            response_id: self.id.clone(),
+            token_usage: self.usage.clone(),
+            partial_output: Vec::new(),
+        }))
+    }
+
+    fn accept(&mut self, chunk: Value) -> Result<Vec<ResponseEvent>, ApiError> {
+        if chunk.get("error").is_some() {
+            return Err(self.held("provider returned a stream error"));
+        }
+        let id = chunk["id"]
+            .as_str()
+            .filter(|s| !s.is_empty())
+            .ok_or_else(|| self.held("missing response identity"))?;
+        let model = chunk["model"]
+            .as_str()
+            .filter(|s| !s.is_empty())
+            .ok_or_else(|| self.held("missing observed model"))?;
+        let mut events = Vec::new();
+        if let Some(old) = &self.id {
+            if old != id || self.model.as_deref() != Some(model) {
+                return Err(self.held("response identity changed"));
+            }
+        } else {
+            self.id = Some(id.to_owned());
+            self.model = Some(model.to_owned());
+            events.push(ResponseEvent::Created {
+                response_id: self.id.clone(),
+            });
+            events.push(ResponseEvent::ServerModel(model.to_owned()));
+        }
+        if !chunk["usage"].is_null() {
+            if self.usage.is_some() {
+                return Err(self.held("duplicate usage"));
+            }
+            let u = &chunk["usage"];
+            let count = |key| {
+                u[key]
+                    .as_i64()
+                    .filter(|n| *n >= 0)
+                    .ok_or_else(|| self.held("invalid usage"))
+            };
+            let input = count("prompt_tokens")?;
+            let output = count("completion_tokens")?;
+            let total = count("total_tokens")?;
+            if input.checked_add(output) != Some(total) {
+                return Err(self.held("inconsistent usage"));
+            }
+            self.usage = Some(TokenUsage {
+                input_tokens: input,
+                output_tokens: output,
+                total_tokens: total,
+                ..Default::default()
+            });
+        }
+        let choices = chunk["choices"]
+            .as_array()
+            .ok_or_else(|| self.held("missing choices"))?;
+        if choices.is_empty() {
+            if self.finish.is_none() || self.usage.is_none() {
+                return Err(self.held("unexpected empty choices"));
+            }
+            return Ok(events);
+        }
+        if choices.len() != 1 || choices[0]["index"].as_u64() != Some(0) || self.finish.is_some() {
+            return Err(self.held("unexpected choice or content after finish"));
+        }
+        let choice = &choices[0];
+        let delta = choice["delta"]
+            .as_object()
+            .ok_or_else(|| self.held("invalid delta"))?;
+        // Provider-specific reasoning is not promoted into portable Codex history.
+        for (key, value) in delta {
+            if value.is_null() {
+                continue;
+            }
+            match key.as_str() {
+                "role" if value.as_str() == Some("assistant") => {}
+                "content" => {
+                    let text = value.as_str().ok_or_else(|| self.held("non-text output"))?;
+                    if !text.is_empty() {
+                        if self.text.is_empty() {
+                            events.push(ResponseEvent::OutputItemAdded(self.message(false)?));
+                        }
+                        self.text.push_str(text);
+                        events.push(ResponseEvent::OutputTextDelta(text.to_owned()));
+                    }
+                }
+                "tool_calls" => {
+                    for v in value
+                        .as_array()
+                        .ok_or_else(|| self.held("invalid tool deltas"))?
+                    {
+                        let index = v["index"]
+                            .as_u64()
+                            .filter(|n| *n < 128)
+                            .ok_or_else(|| self.held("invalid tool index"))?;
+                        if v.get("type").is_some_and(|t| t != "function") {
+                            return Err(self.held("unsupported tool type"));
+                        }
+                        self.calls.entry(index).or_default();
+                        if let Some(id) = v.get("id") {
+                            let id = id
+                                .as_str()
+                                .filter(|s| !s.is_empty())
+                                .ok_or_else(|| self.held("invalid call ID"))?;
+                            let Some(call) = self.calls.get_mut(&index) else {
+                                return Err(self.held("missing call state"));
+                            };
+                            if !call.id.is_empty() && call.id != id {
+                                return Err(self.held("call ID changed"));
+                            }
+                            call.id = id.to_owned();
+                        }
+                        if let Some(function) = v.get("function") {
+                            for field in ["name", "arguments"] {
+                                if let Some(fragment) = function.get(field) {
+                                    let fragment = fragment
+                                        .as_str()
+                                        .ok_or_else(|| self.held("invalid function fragment"))?;
+                                    let Some(call) = self.calls.get_mut(&index) else {
+                                        return Err(self.held("missing call state"));
+                                    };
+                                    if field == "name" {
+                                        call.name.push_str(fragment);
+                                    } else {
+                                        call.arguments.push_str(fragment);
+                                    }
+                                }
+                            }
+                        }
+                    }
+                }
+                "reasoning_content" | "reasoning" => {}
+                _ => return Err(self.held("unsupported stream delta")),
+            }
+        }
+        if !choice["finish_reason"].is_null() {
+            self.finish = Some(
+                choice["finish_reason"]
+                    .as_str()
+                    .ok_or_else(|| self.held("invalid finish reason"))?
+                    .to_owned(),
+            );
+        }
+        Ok(events)
+    }
+
+    fn message(&self, done: bool) -> Result<ResponseItem, ApiError> {
+        serde_json::from_value(json!({"type":"message","id":format!("grok-msg-{}",self.id.as_deref().unwrap_or_default()),"role":"assistant","status":if done {"completed"} else {"in_progress"},"content":[{"type":"output_text","text":if done {self.text.as_str()} else {""}}]})).map_err(|_| self.held("invalid message"))
+    }
+
+    fn complete(
+        &self,
+        tools: &BTreeMap<String, Tool>,
+        prior_ids: &HashSet<String>,
+    ) -> Result<Vec<ResponseEvent>, ApiError> {
+        let finish = self
+            .finish
+            .as_deref()
+            .ok_or_else(|| self.held("terminal marker without finish reason"))?;
+        if !matches!(finish, "stop" | "tool_calls")
+            || (finish == "tool_calls") == self.calls.is_empty()
+        {
+            return Err(self.held("incomplete or inconsistent finish reason"));
+        }
+        let mut events = Vec::new();
+        let mut ids = prior_ids.clone();
+        for call in self.calls.values() {
+            if call.id.is_empty() || !ids.insert(call.id.clone()) {
+                return Err(self.held("missing or reused call ID"));
+            }
+            let tool = tools
+                .get(&call.name)
+                .ok_or_else(|| self.held("unknown tool"))?;
+            let arguments: Value = serde_json::from_str(&call.arguments)
+                .map_err(|_| self.held("malformed function arguments"))?;
+            if !arguments.is_object() {
+                return Err(self.held("function arguments must be an object"));
+            }
+            let item = if tool.custom {
+                if arguments.as_object().is_none_or(|a| a.len() != 1) {
+                    return Err(self.held("invalid custom tool arguments"));
+                }
+                json!({"type":"custom_tool_call","id":format!("grok-call-{}",call.id),"call_id":call.id,"name":tool.name,"namespace":tool.namespace,"input":arguments["input"].as_str().ok_or_else(|| self.held("missing custom input"))?,"status":"completed"})
+            } else {
+                json!({"type":"function_call","id":format!("grok-call-{}",call.id),"call_id":call.id,"name":tool.name,"namespace":tool.namespace,"arguments":call.arguments,"status":"completed"})
+            };
+            let item = serde_json::from_value(item)
+                .map_err(|_| self.held("invalid normalized tool call"))?;
+            events.push(ResponseEvent::OutputItemDone(item));
+        }
+        if !self.text.is_empty() {
+            events.insert(0, ResponseEvent::OutputItemDone(self.message(true)?));
+        }
+        events.push(ResponseEvent::Completed {
+            response_id: self
+                .id
+                .clone()
+                .ok_or_else(|| self.held("missing response identity"))?,
+            token_usage: self.usage.clone(),
+            usage_metadata: None,
+            end_turn: Some(finish == "stop"),
+        });
+        Ok(events)
+    }
+}
+
+pub(crate) fn spawn(
+    stream: StreamResponse,
+    idle: Duration,
+    tools: BTreeMap<String, Tool>,
+    prior_ids: HashSet<String>,
+) -> ResponseStream {
+    let upstream_request_id = stream
+        .headers
+        .get("x-request-id")
+        .and_then(|v| v.to_str().ok())
+        .map(str::to_owned);
+    let (tx, rx_event) = mpsc::channel(1600);
+    tokio::spawn(async move {
+        let mut state = State::default();
+        let mut source = stream.bytes.eventsource();
+        let result:Result<(),ApiError>=async {
+            loop {
+                let event=tokio::select! {
+                    _=tx.closed()=>return Ok(()),
+                    next=tokio::time::timeout(idle,source.next())=>next.map_err(|_| state.held("stream idle timeout"))?.ok_or_else(|| state.held("stream ended before terminal marker"))?.map_err(|_| state.held("stream connection failed"))?,
+                };
+                if event.data=="[DONE]" {
+                    for e in state.complete(&tools,&prior_ids)? { if tx.send(Ok(e)).await.is_err() {return Ok(());} }
+                    return Ok(());
+                }
+                state.bytes=state.bytes.saturating_add(event.data.len());
+                if state.bytes>16*1024*1024 {return Err(state.held("stream exceeds bounded response size"));}
+                let chunk=serde_json::from_str(&event.data).map_err(|_| state.held("malformed stream JSON"))?;
+                for e in state.accept(chunk)? { if tx.send(Ok(e)).await.is_err() {return Ok(());} }
+            }
+        }.await;
+        if let Err(error) = result {
+            let _ = tx.send(Err(error)).await;
+        }
+    });
+    ResponseStream {
+        rx_event,
+        routing_affinity: None,
+        upstream_request_id,
+        interrupt: None,
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn chunk(delta: Value, finish: Value) -> Value {
+        json!({"id":"response-1","model":"grok-observed","choices":[{"index":0,"delta":delta,"finish_reason":finish}]})
+    }
+    fn tools() -> BTreeMap<String, Tool> {
+        BTreeMap::from([(
+            "tool".into(),
+            Tool {
+                name: "exec_command".into(),
+                namespace: None,
+                custom: false,
+            },
+        )])
+    }
+    #[test]
+    fn malformed_or_incomplete_calls_never_commit_and_cannot_retry() {
+        for (arguments, finish, name) in [
+            ("{", "tool_calls", "tool"),
+            ("{}", "length", "tool"),
+            ("{}", "stop", "tool"),
+            ("{}", "tool_calls", "unknown"),
+        ] {
+            let mut state = State::default();
+            assert!(state.accept(chunk(json!({"tool_calls":[{"index":0,"id":"call-1","type":"function","function":{"name":name,"arguments":arguments}}]}),json!(finish))).unwrap().iter().all(|e| !matches!(e,ResponseEvent::OutputItemDone(_))));
+            let error = state.complete(&tools(), &HashSet::new()).unwrap_err();
+            assert!(crate::map_api_error(error).retry_delay(0).is_none());
+        }
+    }
+    #[test]
+    fn reused_ids_identity_drift_and_missing_terminal_state_hold() {
+        let mut state = State::default();
+        state.accept(chunk(json!({"tool_calls":[{"index":0,"id":"prior","function":{"name":"tool","arguments":"{}"}}]}),json!("tool_calls"))).unwrap();
+        assert!(
+            state
+                .complete(&tools(), &HashSet::from(["prior".into()]))
+                .is_err()
+        );
+        let mut changed = chunk(json!({}), Value::Null);
+        changed["id"] = json!("other");
+        assert!(state.accept(changed).is_err());
+        assert!(
+            State::default()
+                .complete(&tools(), &HashSet::new())
+                .is_err()
+        );
+    }
+    #[tokio::test]
+    async fn eof_after_finish_is_unknown_without_success_or_tool_effects() {
+        use bytes::Bytes;
+        let body = format!(
+            "data: {}\n\n",
+            chunk(
+                json!({"tool_calls":[{"index":0,"id":"call-1","function":{"name":"tool","arguments":"{}"}}]}),
+                json!("tool_calls")
+            )
+        );
+        let response = StreamResponse {
+            status: http::StatusCode::OK,
+            headers: http::HeaderMap::new(),
+            bytes: Box::pin(futures::stream::iter(vec![Ok(Bytes::from(body))])),
+        };
+        let events = spawn(response, Duration::from_secs(1), tools(), HashSet::new())
+            .collect::<Vec<_>>()
+            .await;
+        assert!(events.iter().any(Result::is_err));
+        assert!(!events.iter().any(|e| matches!(
+            e,
+            Ok(ResponseEvent::OutputItemDone(_) | ResponseEvent::Completed { .. })
+        )));
+    }
+    #[test]
+    fn usage_is_reported_only_when_present_and_consistent() {
+        let mut state = State::default();
+        state
+            .accept(chunk(json!({"content":"done"}), json!("stop")))
+            .unwrap();
+        assert!(matches!(
+            state.complete(&tools(), &HashSet::new()).unwrap().last(),
+            Some(ResponseEvent::Completed {
+                token_usage: None,
+                ..
+            })
+        ));
+        state.accept(json!({"id":"response-1","model":"grok-observed","choices":[],"usage":{"prompt_tokens":3,"completion_tokens":2,"total_tokens":5}})).unwrap();
+        assert!(matches!(
+            state.complete(&tools(), &HashSet::new()).unwrap().last(),
+            Some(ResponseEvent::Completed {
+                token_usage: Some(TokenUsage {
+                    total_tokens: 5,
+                    ..
+                }),
+                ..
+            })
+        ));
+    }
+}
