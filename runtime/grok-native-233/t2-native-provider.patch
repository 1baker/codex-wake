+    p.base_url = "https://cli-chat-proxy.grok.com/v1".into();
+    p.retry.max_attempts = 5;
+    let error = codex_api::GrokClient::new(
+        transport.clone(),
+        p,
+        Arc::new(StaticAuth::new("secret", "account")),
+    )
+    .stream_request(grok_request(vec![]))
+    .await
+    .err()
+    .expect("held failure");
+    assert_eq!(transport.attempts(), 1);
+    assert!(codex_api::map_api_error(error).retry_delay(0).is_none());
+    Ok(())
+}
