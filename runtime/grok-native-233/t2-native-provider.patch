+#[tokio::test]
+async fn grok_fragmented_calls_preserve_native_identity_and_tool_continuation() -> Result<()> {
+    use codex_api::GrokClient;
+    use codex_api::ResponseEvent;
+    use futures::StreamExt;
+    use wiremock::Mock;
+    use wiremock::MockServer;
+    use wiremock::ResponseTemplate;
+    use wiremock::matchers::method;
+    use wiremock::matchers::path;
+    let server = MockServer::start().await;
+    let chunks = [
+        serde_json::json!({"content":"Checking files"}),
+        serde_json::json!({"tool_calls":[{"index":0,"id":"call-native-1","type":"function","function":{"name":"codex_tool_0","arguments":"{\"cmd\":"}}]}),
+        serde_json::json!({"tool_calls":[{"index":0,"function":{"arguments":"\"pwd\"}"}}]}),
+    ];
+    let mut body = String::new();
+    for delta in chunks {
+        body.push_str(&format!("data: {}\n\n",serde_json::json!({"id":"grok-response-1","model":"grok-observed","choices":[{"index":0,"delta":delta,"finish_reason":null}]})));
+    }
+    body.push_str("data: {\"id\":\"grok-response-1\",\"model\":\"grok-observed\",\"choices\":[{\"index\":0,\"delta\":{},\"finish_reason\":\"tool_calls\"}]}\n\ndata: [DONE]\n\n");
+    Mock::given(method("POST"))
+        .and(path("/v1/chat/completions"))
+        .respond_with(
+            ResponseTemplate::new(200)
+                .insert_header("content-type", "text/event-stream")
+                .set_body_string(body),
+        )
+        .mount(&server)
+        .await;
+    let mut p = provider("grok");
+    p.base_url = format!("{}/v1", server.uri());
+    p.headers.insert(
+        "ChatGPT-Account-ID",
+        HeaderValue::from_static("must-not-forward"),
+    );
+    let input: ResponseItem = serde_json::from_value(
+        serde_json::json!({"type":"message","role":"user","content":[{"type":"input_text","text":"Inspect the workspace"}]}),
+    )?;
+    let mut stream = GrokClient::new(
+        codex_client::ReqwestTransport::new(reqwest::Client::new()),
+        p.clone(),
+        Arc::new(StaticAuth::new("grok-session", "ambient-account")),
+    )
+    .stream_request(grok_request(vec![input.clone()]))
+    .await?;
+    let mut call = None;
+    let mut completed = false;
+    while let Some(event) = stream.next().await {
+        match event? {
+            ResponseEvent::OutputItemDone(item @ ResponseItem::FunctionCall { .. }) => {
+                call = Some(item)
+            }
+            ResponseEvent::Completed { token_usage, .. } => {
+                assert!(token_usage.is_none());
+                completed = true;
+            }
+            _ => {}
+        }
+    }
+    assert!(completed);
+    let call = call.expect("native call");
+    let value = serde_json::to_value(&call)?;
+    assert_eq!(value["call_id"], "call-native-1");
+    assert_eq!(value["name"], "exec_command");
+    assert_eq!(value["namespace"], "functions");
+    assert_eq!(value["arguments"], r#"{"cmd":"pwd"}"#);
+    let output = serde_json::from_value(
+        serde_json::json!({"type":"function_call_output","call_id":"call-native-1","output":"/workspace"}),
+    )?;
+    let _stream = GrokClient::new(
+        codex_client::ReqwestTransport::new(reqwest::Client::new()),
+        p,
+        Arc::new(StaticAuth::new("grok-session", "ambient-account")),
+    )
+    .stream_request(grok_request(vec![input, call, output]))
+    .await?;
+    let requests = server.received_requests().await.unwrap();
+    assert_eq!(requests.len(), 2);
+    for req in &requests {
+        assert_eq!(
+            req.headers.get("authorization").unwrap(),
+            "Bearer grok-session"
+        );
+        assert_eq!(req.headers.get("x-xai-token-auth").unwrap(), "xai-grok-cli");
+        assert_eq!(
+            req.headers.get("x-grok-model-override").unwrap(),
+            "grok-build"
+        );
+        assert!(req.headers.get("chatgpt-account-id").is_none());
+    }
+    let continuation: serde_json::Value = requests[1].body_json()?;
+    assert_eq!(continuation["messages"][2]["tool_call_id"], "call-native-1");
+    assert_eq!(continuation["messages"][2]["content"], "/workspace");
+    Ok(())
+}
