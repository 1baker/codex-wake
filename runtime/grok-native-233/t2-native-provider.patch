diff --git a/codex-rs/codex-api/src/endpoint/grok.rs b/codex-rs/codex-api/src/endpoint/grok.rs
new file mode 100644
index 0000000000000000000000000000000000000000..0e3a06eac3917cfd450f5408213bd220094cd258
--- /dev/null
+++ b/codex-rs/codex-api/src/endpoint/grok.rs
@@ -0,0 +1,151 @@
+use crate::auth::AuthError;
+use crate::auth::AuthProvider;
+use crate::auth::SharedAuthProvider;
+use crate::common::ResponseStream;
+use crate::common::ResponsesApiRequest;
+use crate::endpoint::session::EndpointSession;
+use crate::error::ApiError;
+use crate::grok::invalid;
+use crate::provider::Provider;
+use codex_client::EncodedJsonBody;
+use codex_client::HttpTransport;
+use codex_client::RequestTelemetry;
+use http::HeaderMap;
+use http::HeaderValue;
+use http::Method;
+use std::sync::Arc;
+
+/// Session-authenticated Grok inference, normalized to the native Codex event contract.
+pub struct GrokClient<T: HttpTransport> {
+    transport: T,
+    provider: Provider,
+    auth: SharedAuthProvider,
+    telemetry: Option<Arc<dyn RequestTelemetry>>,
+}
+
+struct PinnedBearer(HeaderValue);
+impl AuthProvider for PinnedBearer {
+    fn add_auth_headers(&self, headers: &mut HeaderMap) -> Result<(), AuthError> {
+        headers.insert(http::header::AUTHORIZATION, self.0.clone());
+        Ok(())
+    }
+}
+
+impl<T: HttpTransport> GrokClient<T> {
+    pub fn new(transport: T, provider: Provider, auth: SharedAuthProvider) -> Self {
+        Self {
+            transport,
+            provider,
+            auth,
+            telemetry: None,
+        }
+    }
+    pub fn with_telemetry(mut self, telemetry: Option<Arc<dyn RequestTelemetry>>) -> Self {
+        self.telemetry = telemetry;
+        self
+    }
+
+    pub async fn stream_request(
+        self,
+        request: ResponsesApiRequest,
+    ) -> Result<ResponseStream, ApiError> {
+        validate_grok_base_url(&self.provider.base_url)?;
+        if self
+            .provider
+            .query_params
+            .as_ref()
+            .is_some_and(|q| !q.is_empty())
+        {
+            return Err(invalid(
+                "Grok session proxy query parameters are not admitted",
+            ));
+        }
+        let (body, tools, prior_ids) = crate::grok::convert(&request)?;
+        let model = HeaderValue::from_str(&request.model)
+            .map_err(|_| invalid("invalid model routing identity"))?;
+        // Resolve exactly once for this request. Never forward ambient account/first-party headers.
+        let resolved = self
+            .auth
+            .apply_auth_headers(HeaderMap::new())
+            .await
+            .map_err(|_| invalid("session authentication unavailable"))?;
+        let mut bearer = resolved
+            .get(http::header::AUTHORIZATION)
+            .filter(|v| {
+                v.to_str()
+                    .is_ok_and(|s| s.starts_with("Bearer ") && s.len() > 7)
+            })
+            .cloned()
+            .ok_or_else(|| invalid("session bearer authentication required"))?;
+        bearer.set_sensitive(true);
+        let mut provider = self.provider;
+        // A failed POST may already have reached inference. Do not automatically replay it.
+        provider.retry.max_attempts = 0;
+        provider.retry.retry_transport = false;
+        provider.retry.retry_5xx = false;
+        provider.retry.retry_429 = false;
+        provider.headers.clear();
+        let idle = provider.stream_idle_timeout;
+        let session =
+            EndpointSession::new(self.transport, provider, Arc::new(PinnedBearer(bearer)))
+                .with_request_telemetry(self.telemetry);
+        let mut headers = HeaderMap::new();
+        headers.insert("x-xai-token-auth", HeaderValue::from_static("xai-grok-cli"));
+        headers.insert("x-grok-model-override", model);
+        let body =
+            EncodedJsonBody::encode(&body).map_err(|_| invalid("request encoding failed"))?;
+        let response = session
+            .stream_encoded_json_with(
+                Method::POST,
+                "/chat/completions",
+                headers,
+                Some(body),
+                |req| {
+                    req.headers.insert(
+                        http::header::ACCEPT,
+                        HeaderValue::from_static("text/event-stream"),
+                    );
+                    req.response_body_limit_bytes = Some(16 * 1024 * 1024);
+                },
+            )
+            .await
+            .map_err(|error| match error {
+                ApiError::Transport(codex_client::TransportError::Http { status, .. })
+                    if status == http::StatusCode::UNAUTHORIZED
+                        || status == http::StatusCode::FORBIDDEN =>
+                {
+                    invalid("session authentication or entitlement rejected")
+                }
+                ApiError::Transport(codex_client::TransportError::Http { status, .. })
+                    if status == http::StatusCode::TOO_MANY_REQUESTS =>
+                {
+                    invalid("provider rate limit; explicit reassignment required")
+                }
+                _ => invalid("inference request outcome unknown; automatic replay withheld"),
+            })?;
+        Ok(crate::sse::grok::spawn(response, idle, tools, prior_ids))
+    }
+}
+
+/// Reject unsupported destinations before resolving any account authentication.
+pub fn validate_grok_base_url(base_url: &str) -> Result<(), ApiError> {
+    let destination =
+        url::Url::parse(base_url).map_err(|_| invalid("invalid session proxy destination"))?;
+    let loopback = matches!(
+        destination.host_str(),
+        Some("127.0.0.1" | "localhost" | "[::1]")
+    ) && matches!(destination.scheme(), "http" | "https");
+    if !(destination.scheme() == "https"
+        && destination.host_str() == Some("cli-chat-proxy.grok.com")
+        && destination.port_or_known_default() == Some(443)
+        || loopback)
+        || !destination.username().is_empty()
+        || destination.password().is_some()
+        || destination.query().is_some()
+        || destination.fragment().is_some()
+        || destination.path().trim_end_matches('/') != "/v1"
+    {
+        return Err(invalid("Grok session proxy destination is not admitted"));
+    }
+    Ok(())
+}
