+impl BoundedQueueOutcome {
+    pub(crate) fn try_from_row(row: &SqliteRow) -> Result<Self> {
+        let status: String = row.try_get("status")?;
+        let status = match status.as_str() {
+            "canceled" => BoundedQueueStatus::Canceled,
+            "expired" => BoundedQueueStatus::Expired,
+            "admitted" => BoundedQueueStatus::Admitted {
+                turn_id: row.try_get("turn_id")?,
+            },
+            _ => anyhow::bail!("unknown bounded queue outcome"),
+        };
+        Ok(Self {
+            record: QueuedUserSubmissionRecord::try_from_row(row)?,
+            status,
+            clock_evidence: row.try_get("clock_evidence")?,
         })
     }
 }
