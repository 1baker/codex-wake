+-- Older binaries read only queued_items and must never see bounded input.
+CREATE TABLE bounded_pending_items (
+    id TEXT PRIMARY KEY NOT NULL,
+    thread_id TEXT NOT NULL,
+    payload_json TEXT NOT NULL,
+    queue_order INTEGER NOT NULL,
+    created_at_ms INTEGER NOT NULL,
+    updated_at_ms INTEGER NOT NULL,
+    expires_at INTEGER NOT NULL CHECK (expires_at > 0)
+);
+CREATE UNIQUE INDEX bounded_pending_thread_order_idx
+    ON bounded_pending_items(thread_id, queue_order);
+-- Migrate any pre-activation bounded rows without exposing them to downlevel readers.
+INSERT INTO bounded_pending_items SELECT id, thread_id, payload_json, queue_order,
+    created_at_ms, updated_at_ms, expires_at FROM queued_items WHERE expires_at IS NOT NULL;
+DELETE FROM queued_items WHERE expires_at IS NOT NULL;
+
+CREATE TRIGGER bounded_pending_revision_after_insert
+AFTER INSERT ON bounded_pending_items
+BEGIN
+    INSERT INTO queued_thread_revisions (thread_id) VALUES (NEW.thread_id)
+    ON CONFLICT(thread_id) DO UPDATE
+    SET revision = (SELECT COALESCE(MAX(revision), 0) + 1 FROM queued_thread_revisions);
+END;
+
+CREATE TRIGGER bounded_pending_revision_after_update
+AFTER UPDATE ON bounded_pending_items
+BEGIN
+    INSERT INTO queued_thread_revisions (thread_id) VALUES (NEW.thread_id)
+    ON CONFLICT(thread_id) DO UPDATE
+    SET revision = (SELECT COALESCE(MAX(revision), 0) + 1 FROM queued_thread_revisions);
+END;
+
+CREATE TRIGGER bounded_pending_revision_after_delete
+AFTER DELETE ON bounded_pending_items
+BEGIN
+    INSERT INTO queued_thread_revisions (thread_id) VALUES (OLD.thread_id)
+    ON CONFLICT(thread_id) DO UPDATE
+    SET revision = (SELECT COALESCE(MAX(revision), 0) + 1 FROM queued_thread_revisions);
+END;
