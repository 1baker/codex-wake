+//! Controlled service-reader seam evidence, not real service qualification.
+#![cfg(target_os = "linux")]
+
+use codex_queue_extension::{QueueClock, StableTimeClock};
+use serde_json::{Value, json};
+use std::os::unix::fs::PermissionsExt;
+
+fn evidence() -> Value {
+    json!({"contract_version":2,"state":"qualified","basis":"service_measurement",
+        "receipt_time_bound":false,"lower":100.0,"upper":100.1,"valid_for_ns":2000000000_u64,
+        "counter":{"epoch":"3c93a3d4-445d-4403-8a40-77fa9162dee6","counter":1000,"frequency":1000,"rate_ppm":0},
+        "counter_source":{"kind":"stable_time_service_measurement"}})
+}
+
+fn clock(root: &std::path::Path, body: &str) -> anyhow::Result<StableTimeClock> {
+    let reader = root.join("reader.py");
+    std::fs::write(&reader, format!("#!/usr/bin/python3\n{body}\n"))?;
+    std::fs::set_permissions(&reader, std::fs::Permissions::from_mode(0o700))?;
+    let config = root.join("native-clock.json");
+    std::fs::write(
+        &config,
+        json!({"interpreter":reader,"stable_time_config":root.join("stable-time.json")})
+            .to_string(),
+    )?;
+    std::fs::set_permissions(&config, std::fs::Permissions::from_mode(0o600))?;
+    Ok(StableTimeClock::from_config(&config))
+}
+
+#[tokio::test]
+async fn service_measurement_preserves_bounds_without_private_counter() -> anyhow::Result<()> {
+    let root = tempfile::tempdir()?;
+    let expected = evidence();
+    // Reader delivery has a deliberate delay. No receipt-time guarantee or
+    // elapsed-time projection may be manufactured from that delay.
+    let reader = clock(
+        root.path(),
+        &format!(
+            "import time\ntime.sleep(0.05)\nprint({:?})",
+            expected.to_string()
+        ),
+    )?;
+    let sample = reader
+        .sample()
+        .await
+        .expect("service observation qualifies");
+    assert_eq!(sample.lower, 100.0);
+    assert_eq!(sample.upper, 100.1);
+    assert_eq!(serde_json::from_str::<Value>(&sample.evidence)?, expected);
+    Ok(())
+}
+
+#[tokio::test]
+async fn malformed_or_obsolete_service_evidence_holds() -> anyhow::Result<()> {
+    let cases = [
+        ("legacy", "contract_version", json!(1)),
+        ("held", "state", json!("held")),
+        ("wrong_basis", "basis", json!("receipt")),
+        ("receipt_claim", "receipt_time_bound", json!(true)),
+        ("string_receipt", "receipt_time_bound", json!("false")),
+        ("inverted_bounds", "lower", json!(101.0)),
+        ("non_numeric_bounds", "upper", json!("NaN")),
+        ("no_validity", "valid_for_ns", json!(0)),
+        ("negative_validity", "valid_for_ns", json!(-1)),
+        (
+            "private_bridge",
+            "counter_source",
+            json!({"kind":"windows_qpc_private_bridge","socket":"/missing"}),
+        ),
+        (
+            "wrong_counter",
+            "counter",
+            json!({"epoch":"bad","counter":1000,"frequency":1000,"rate_ppm":0}),
+        ),
+        (
+            "zero_frequency",
+            "counter",
+            json!({"epoch":"3c93a3d4-445d-4403-8a40-77fa9162dee6","counter":1000,"frequency":0,"rate_ppm":0}),
+        ),
+        (
+            "bad_rate",
+            "counter",
+            json!({"epoch":"3c93a3d4-445d-4403-8a40-77fa9162dee6","counter":1000,"frequency":1000,"rate_ppm":5001}),
+        ),
+        (
+            "negative_counter",
+            "counter",
+            json!({"epoch":"3c93a3d4-445d-4403-8a40-77fa9162dee6","counter":-1,"frequency":1000,"rate_ppm":0}),
+        ),
+    ];
+    for (name, field, value) in cases {
+        let root = tempfile::tempdir()?;
+        let mut malformed = evidence();
+        malformed[field] = value;
+        let reader = clock(root.path(), &format!("print({:?})", malformed.to_string()))?;
+        assert!(reader.sample().await.is_none(), "{name} must hold");
+    }
+    for field in [
+        "basis",
+        "receipt_time_bound",
+        "counter_source",
+        "valid_for_ns",
+        "counter",
+        "lower",
+        "upper",
+    ] {
+        let root = tempfile::tempdir()?;
+        let mut malformed = evidence();
+        malformed.as_object_mut().unwrap().remove(field);
+        let reader = clock(root.path(), &format!("print({:?})", malformed.to_string()))?;
+        assert!(reader.sample().await.is_none(), "missing {field} must hold");
+    }
+    Ok(())
+}
+
+#[tokio::test]
+async fn process_and_configuration_failures_hold() -> anyhow::Result<()> {
+    for body in [
+        "print('x' * 4097)",
+        "raise SystemExit(1)",
+        "print('invalid json')",
+        "import time; time.sleep(3)",
+    ] {
+        let root = tempfile::tempdir()?;
+        let reader = clock(root.path(), body)?;
+        assert!(reader.sample().await.is_none(), "{body} must hold");
+    }
+    let root = tempfile::tempdir()?;
+    let _ = clock(root.path(), &format!("print({:?})", evidence().to_string()))?;
+    let config = root.path().join("native-clock.json");
+    std::fs::set_permissions(&config, std::fs::Permissions::from_mode(0o644))?;
+    assert!(!StableTimeClock::from_config(&config).configured());
+    assert!(!StableTimeClock::from_config(std::path::Path::new("relative.json")).configured());
+    Ok(())
+}
