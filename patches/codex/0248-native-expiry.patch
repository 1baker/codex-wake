+
+fn api_bounded_submission(value: QueuedItem) -> Result<BoundedQueuedSubmission, JSONRPCErrorError> {
+    let expires_at_unix_micros = value
+        .expires_at
+        .ok_or_else(|| internal_error("bounded expiry missing"))?;
+    let item = api_queued_submission(value)?;
+    Ok(BoundedQueuedSubmission {
+        id: item.id,
+        input: item.input,
+        client_user_message_id: item.client_user_message_id,
+        responsesapi_client_metadata: item.responsesapi_client_metadata,
+        expires_at_unix_micros,
+    })
+}
+
+fn api_bounded_lookup(
+    value: BoundedQueueLookup,
+) -> Result<BoundedQueueInspection, JSONRPCErrorError> {
+    let mut response = BoundedQueueInspection {
+        state: BoundedQueueState::NotFound,
+        queued_submission: None,
+        turn_id: None,
+        clock_evidence: None,
+    };
+    match value {
+        BoundedQueueLookup::Missing => {}
+        BoundedQueueLookup::Ambiguous => response.state = BoundedQueueState::Ambiguous,
+        BoundedQueueLookup::Pending(record) => {
+            response.state = BoundedQueueState::Pending;
+            response.queued_submission = Some(api_bounded_submission(
+                QueuedItem::try_from(record).map_err(queue_error)?,
+            )?);
+        }
+        BoundedQueueLookup::Terminal(outcome) => {
+            response.state = match outcome.status {
+                BoundedQueueStatus::Canceled => BoundedQueueState::Canceled,
+                BoundedQueueStatus::Expired => BoundedQueueState::Expired,
+                BoundedQueueStatus::Admitted { turn_id } => {
+                    response.turn_id = Some(turn_id);
+                    BoundedQueueState::Admitted
+                }
+            };
+            response.queued_submission = Some(api_bounded_submission(
+                QueuedItem::try_from(outcome.record).map_err(queue_error)?,
+            )?);
+            response.clock_evidence = outcome
+                .clock_evidence
+                .map(|value| serde_json::from_str(&value))
+                .transpose()
+                .map_err(|_| internal_error("bounded clock evidence is invalid"))?;
+        }
+    }
+    Ok(response)
+}
