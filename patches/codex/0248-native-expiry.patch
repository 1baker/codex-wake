         expected
     );
 }
+
+#[test]
+fn bounded_queue_method_requires_original_expiry_without_legacy_downgrade() {
+    let mut value = json!({ "id": 7, "method": "thread/queue/bounded/add", "params": {
+        "threadId": "1970f00d-6bce-4fc3-9cf9-30a5de56db1a",
+        "clientUserMessageId": "original-client",
+        "input": [{ "type": "text", "text": "wake", "text_elements": [] }],
+        "expiresAtUnixMicros": 200_000_000
+    }});
+    let request: ClientRequest =
+        serde_json::from_value(value.clone()).expect("bounded method supported");
+    let wire = serde_json::to_value(request).unwrap();
+    assert_eq!(wire["method"], "thread/queue/bounded/add");
+    assert_eq!(wire["params"]["expiresAtUnixMicros"], 200_000_000);
+    value["params"]
+        .as_object_mut()
+        .unwrap()
+        .remove("expiresAtUnixMicros");
+    assert!(serde_json::from_value::<ClientRequest>(value).is_err());
+}
