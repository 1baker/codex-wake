+#[tokio::test]
+async fn bounded_responses_recheck_admission_after_async_authentication() -> Result<()> {
+    use std::sync::atomic::{AtomicBool, Ordering};
+    struct ExpiringAuth(Arc<AtomicBool>);
+    impl AuthProvider for ExpiringAuth {
+        fn add_auth_headers(&self, _headers: &mut HeaderMap) -> Result<(), AuthError> {
+            Ok(())
+        }
+        fn apply_auth(&self, request: Request) -> codex_api::AuthProviderFuture<'_> {
+            Box::pin(async move {
+                tokio::task::yield_now().await;
+                self.0.store(false, Ordering::SeqCst);
+                Ok(request)
+            })
+        }
+    }
+    let eligible = Arc::new(AtomicBool::new(true));
+    let clock = Arc::clone(&eligible);
+    let state = RecordingState::default();
+    let client = ResponsesClient::new(
+        RecordingTransport::new(state.clone()),
+        provider("openai"),
+        Arc::new(ExpiringAuth(eligible)),
+    )
+    .with_request_admission(Some(Arc::new(move || {
+        let clock = Arc::clone(&clock);
+        Box::pin(async move { clock.load(Ordering::SeqCst) })
+    })));
+    let result = client
+        .stream(
+            serde_json::json!({"input":"expired bounded prompt"}),
+            HeaderMap::new(),
+            Compression::None,
+            None,
+        )
+        .await;
+    assert!(
+        matches!(result, Err(ApiError::RequestNotAdmitted)),
+        "expired request was not distinctly rejected after async authentication"
+    );
+    assert!(
+        state.take_stream_requests().is_empty(),
+        "expired input reached transport"
+    );
+    Ok(())
+}
