+            (None, Some(id)) if !id.is_empty() => BoundedQueueSelector::ClientUserMessageId(id),
+            _ => {
+                return Err(invalid_request(
+                    "select exactly one queue ID or original client message ID",
+                ));
+            }
+        };
+        Ok(ThreadQueueBoundedReadResponse {
+            inspection: api_bounded_lookup(
+                self.service()?
+                    .lookup_bounded(thread_id, selector)
+                    .await
+                    .map_err(queue_error)?,
+            )?,
