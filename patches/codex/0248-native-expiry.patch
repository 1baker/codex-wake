+//! Native-owned Stable Time process reader. No sender clock or wall-time fallback.
+use std::future::Future;
+use std::path::PathBuf;
+use std::pin::Pin;
+use std::process::Stdio;
+use std::time::Duration;
+
+use codex_thread_store::BoundedQueueClockSample;
+use serde_json::Value;
+use tokio::io::AsyncReadExt;
+
+pub type QueueClockFuture<'a> =
+    Pin<Box<dyn Future<Output = Option<BoundedQueueClockSample>> + Send + 'a>>;
+
+/// Host integration for qualified UTC bounds, independent of the Wake watcher.
+pub trait QueueClock: Send + Sync {
+    fn sample(&self) -> QueueClockFuture<'_>;
+    fn configured(&self) -> bool {
+        true
+    }
+}
+
+pub struct StableTimeClock {
+    reader: Option<(PathBuf, PathBuf)>,
+}
+
+impl StableTimeClock {
+    pub(crate) fn from_env() -> Self {
+        match std::env::var_os("CODEX_NATIVE_QUEUE_CLOCK_CONFIG") {
+            Some(path) => Self::from_config(&PathBuf::from(path)),
+            None => Self { reader: None },
+        }
+    }
+
+    /// Construct the host-owned clock from an explicit pinned configuration.
+    pub fn from_config(path: &std::path::Path) -> Self {
+        fn configuration(path: &std::path::Path) -> Option<(PathBuf, PathBuf)> {
+            if !cfg!(target_os = "linux") || !path.is_absolute() {
+                return None;
+            }
+            let metadata = std::fs::symlink_metadata(path).ok()?;
+            if !metadata.is_file() || metadata.len() > 16384 {
+                return None;
+            }
+            #[cfg(target_os = "linux")]
+            {
+                use std::os::unix::fs::{MetadataExt, PermissionsExt};
+                let uid = std::fs::metadata("/proc/self").ok()?.uid();
+                if metadata.uid() != uid || metadata.permissions().mode() & 0o077 != 0 {
+                    return None;
+                }
+            }
+            let value: Value = serde_json::from_slice(&std::fs::read(path).ok()?).ok()?;
+            if value.as_object()?.len() != 2 {
+                return None;
+            }
+            let interpreter = PathBuf::from(value.get("interpreter")?.as_str()?);
+            let config = PathBuf::from(value.get("stable_time_config")?.as_str()?);
+            (interpreter.is_absolute() && config.is_absolute()).then_some((interpreter, config))
+        }
+        Self {
+            reader: configuration(path),
+        }
+    }
+}
+
+impl QueueClock for StableTimeClock {
+    fn configured(&self) -> bool {
+        self.reader.is_some()
+    }
+
+    fn sample(&self) -> QueueClockFuture<'_> {
+        Box::pin(async move {
+            let (interpreter, config) = self.reader.as_ref()?;
+            let mut child = tokio::process::Command::new(interpreter)
+                .args(["-I", "-m", "codex_wake.native_queue_clock", "--config"])
+                .arg(config)
+                .stdin(Stdio::null())
+                .stdout(Stdio::piped())
+                .stderr(Stdio::null())
+                .kill_on_drop(true)
+                .spawn()
+                .ok()?;
+            let output = child.stdout.take()?;
+            let read = async {
+                let mut bytes = Vec::new();
+                output.take(4097).read_to_end(&mut bytes).await.ok()?;
+                if bytes.len() > 4096 {
+                    return None;
+                }
+                if !child.wait().await.ok()?.success() {
+                    return None;
+                }
+                let value: Value = serde_json::from_slice(&bytes).ok()?;
+                if value.get("contract_version")?.as_u64()? != 2
+                    || value.get("state")?.as_str()? != "qualified"
+                    || value.get("basis")?.as_str()? != "service_measurement"
+                    || value.get("receipt_time_bound")?.as_bool()?
+                {
+                    return None;
+                }
+                let lower = value.get("lower")?.as_f64()?;
+                let upper = value.get("upper")?.as_f64()?;
+                if !lower.is_finite() || !upper.is_finite() || lower > upper {
+                    return None;
+                }
+                let counter = value.get("counter")?;
+                uuid::Uuid::parse_str(counter.get("epoch")?.as_str()?).ok()?;
+                counter.get("counter")?.as_u64()?;
+                if counter.get("frequency")?.as_u64()? == 0
+                    || counter.get("rate_ppm")?.as_u64()? > 5000
+                {
+                    return None;
+                }
+                // Counter metadata describes the service measurement; it is not a
+                // license to extrapolate UTC with a WSL or private host clock.
+                if value.get("valid_for_ns")?.as_u64()? == 0
+                    || value.get("counter_source")?.get("kind")?.as_str()?
+                        != "stable_time_service_measurement"
+                {
+                    return None;
+                }
+                Some(BoundedQueueClockSample {
+                    lower,
+                    upper,
+                    evidence: value.to_string(),
+                })
+            };
+            // Bound the independent reader while a queue selection holds its transaction.
