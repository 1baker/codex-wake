@@ -0,0 +1,157 @@
+//! Bounded input stays out of reusable history until native model admission.
+use super::daemon_recovery::RecordedTurnInput;
+use super::session::Session;
+use super::turn_context::TurnContext;
+use crate::context_manager::ContextManager;
+use codex_analytics::ImagePreparationMetadata;
+use codex_history::ResponseItemEnvelope;
+use codex_protocol::openai_models::ModelInfo;
+use codex_protocol::turn_input::QueueAdmissionGuard;
+
+pub(super) struct Batch {
+    pub(super) model_info: ModelInfo,
+    pub(super) items: Vec<ResponseItemEnvelope>,
+    pub(super) image_preparations: Vec<ImagePreparationMetadata>,
+}
+
+#[derive(Default)]
+pub(super) enum Stage {
+    Pending(Vec<Batch>),
+    Authorized(Vec<Batch>),
+    #[default]
+    Admitted,
+    Rejected,
+}
+
+#[derive(Default)]
+pub(crate) struct QueuedInput {
+    pub(super) stage: Stage,
+    guard: Option<QueueAdmissionGuard>,
+}
+
+impl QueuedInput {
+    pub(super) fn pending(guard: QueueAdmissionGuard) -> Self {
+        Self {
+            stage: Stage::Pending(Vec::new()),
+            guard: Some(guard),
+        }
+    }
+    pub(super) fn is_pending(&self) -> bool {
+        matches!(self.stage, Stage::Pending(_) | Stage::Authorized(_))
+    }
+}
+
+impl Session {
+    pub(super) async fn clone_history_for_turn(&self, turn: &TurnContext) -> ContextManager {
+        let mut history = self.clone_history().await;
+        let staged = turn.queued_input.lock().await;
+        if let Stage::Pending(batches) | Stage::Authorized(batches) = &staged.stage {
+            for batch in batches {
+                let mut items = batch.items.clone();
+                history
+                    .record_annotated_items(&mut items, batch.model_info.truncation_policy.into());
+            }
+        }
+        history
+    }
+
+    /// Preparation must not consume a pending queue entry. Its original record,
+    /// cancellation and qualified-time decision belong to final transport send.
+    pub(super) async fn preflight_queued_input(&self, turn: &TurnContext) -> bool {
+        let mut staged = turn.queued_input.lock().await;
+        match staged.stage {
+            Stage::Admitted => true,
+            Stage::Pending(_) => staged.guard.is_some(),
+            Stage::Rejected => false,
+            Stage::Authorized(_) => {
+                // A prior provider attempt remains admitted; never turn a rejected
+                // retry into a fresh pending entry or renew its original deadline.
+                let permitted = match &staged.guard {
+                    Some(guard) => tokio::time::timeout(
+                        std::time::Duration::from_secs(15),
+                        guard.recheck(turn.sub_id.clone()),
+                    )
+                    .await
+                    .unwrap_or(false),
+                    None => false,
+                };
+                if !permitted {
+                    staged.stage = Stage::Rejected;
+                }
+                permitted
+            }
+        }
+    }
+
+    pub(super) async fn admit_queued_input(&self, turn: &TurnContext) -> bool {
+        let mut staged = turn.queued_input.lock().await;
+        match staged.stage {
+            Stage::Admitted => return true,
+            Stage::Authorized(_) => {
+                let permitted = match &staged.guard {
+                    Some(guard) => tokio::time::timeout(
+                        std::time::Duration::from_secs(15),
+                        guard.recheck(turn.sub_id.clone()),
+                    )
+                    .await
+                    .unwrap_or(false),
+                    None => false,
+                };
+                if !permitted {
+                    staged.stage = Stage::Rejected;
+                }
+                return permitted;
+            }
+            Stage::Rejected => return false,
+            Stage::Pending(_) => {}
+        }
+        let Some(guard) = staged.guard.clone() else {
+            return false;
+        };
+        let accepted = tokio::time::timeout(
+            std::time::Duration::from_secs(15),
+            guard.consume(turn.sub_id.clone()),
+        )
+        .await
+        .unwrap_or(false);
+        if !accepted {
+            staged.stage = Stage::Rejected;
+            return false;
+        }
+        let Stage::Pending(batches) = std::mem::replace(&mut staged.stage, Stage::Rejected) else {
+            return false;
+        };
+        staged.stage = Stage::Authorized(batches);
+        true
+    }
+
+    pub(super) async fn publish_queued_input(&self, turn: &TurnContext) {
+        let mut staged = turn.queued_input.lock().await;
+        if !matches!(staged.stage, Stage::Authorized(_)) {
+            return;
+        }
+        let Stage::Authorized(batches) = std::mem::replace(&mut staged.stage, Stage::Admitted)
+        else {
+            return;
+        };
+        // Keep later writes behind this batch until all accepted items are published.
+        for batch in batches {
+            self.record_admitted_conversation_items(
+                turn,
+                &batch.model_info,
+                batch.items,
+                batch.image_preparations,
+            )
+            .await;
+        }
+        turn.extension_data.insert(RecordedTurnInput);
+    }
+}
+
+impl std::fmt::Debug for QueuedInput {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("QueuedInput")
+            .field("pending", &self.is_pending())
+            .finish_non_exhaustive()
+    }
+}
