+        let offset = params
+            .cursor
+            .as_deref()
+            .map(str::parse::<usize>)
+            .transpose()
+            .map_err(|_| invalid_request("invalid bounded queue cursor"))?
+            .unwrap_or_default();
+        let limit = params
+            .limit
+            .map(|n| n as usize)
+            .unwrap_or(THREAD_LIST_DEFAULT_LIMIT)
+            .clamp(1, THREAD_LIST_MAX_LIMIT);
+        let mut items = self
+            .service()?
+            .list_bounded_page(thread_id, offset, limit.saturating_add(1))
+            .await
+            .map_err(queue_error)?;
+        let next_cursor = if items.len() > limit {
+            items.truncate(limit);
+            Some(offset.saturating_add(limit).to_string())
+        } else {
+            None
+        };
+        Ok(ThreadQueueBoundedListResponse {
+            data: items
+                .into_iter()
+                .map(api_bounded_submission)
+                .collect::<Result<Vec<_>, _>>()?,
+            next_cursor,
+        })
+    }
