+        "import json,sys\nfrom pathlib import Path\np=json.load(sys.stdin)\nif p['prompt']=='bounded prompt expired during preparation':\n    Path({:?}).touch()\n    print(json.dumps({{'hookSpecificOutput':{{'hookEventName':'UserPromptSubmit','additionalContext':'derived bounded context must expire'}}}}))\n",
+        marker.to_string_lossy(),
+    )).unwrap();
+    let python = if cfg!(windows) {
+        "python.exe"
+    } else {
+        "python3"
+    };
+    std::fs::write(
+        home.join("hooks.json"),
+        serde_json::json!({
