+#[cfg(unix)]
+async fn assert_bounded_auth_recovery(
+    after_rejection: &'static str,
+    mut expected_attempts: usize,
+    mut expect_history: bool,
+) -> anyhow::Result<()> {
+    let server = start_mock_server().await;
+    let auth_home = tempfile::tempdir()?;
+    let token = auth_home.path().join("synthetic-provider-token");
+    let marker = auth_home.path().join("clock-expired");
+    let script = auth_home.path().join("read_synthetic_token.py");
+    std::fs::write(&token, "first-fixture-token")?;
+    std::fs::write(
+        &script,
+        "from pathlib import Path\nimport sys\nprint(Path(sys.argv[1]).read_text())\n",
+    )?;
+    let calls = Arc::new(std::sync::atomic::AtomicUsize::new(0));
+    let observed = Arc::clone(&calls);
+    let handler_token = token.clone();
+    let handler_marker = marker.clone();
+    let response = responses::mount_response_handler(&server, move |_| {
+        if observed.fetch_add(1, Ordering::SeqCst) == 0
+            && !after_rejection.starts_with("before_transport")
+        {
+            std::fs::write(&handler_token, "second-fixture-token").unwrap();
+            std::fs::write(&handler_marker, after_rejection).unwrap();
+            wiremock::ResponseTemplate::new(401).set_body_string("synthetic auth recovery")
+        } else {
+            responses::sse_response(responses::sse_completed("after-auth-recovery"))
+        }
+    })
+    .await;
+    let auth_cwd = auth_home.path().to_path_buf();
+    let test = test_codex()
+        .with_config(move |config| {
+            config.model_provider.requires_openai_auth = false;
+            config.model_provider.supports_websockets = false;
+            config.model_provider.auth = Some(
+                serde_json::from_value(serde_json::json!({
+                    "command":"python3", "args":[script,token], "cwd":auth_cwd,
+                    "timeout_ms":5000, "refresh_interval_ms":60000
+                }))
+                .expect("valid synthetic provider auth command"),
+            );
+        })
+        .build_with_auto_env(&server)
+        .await?;
+    let thread_id = test.session_configured.thread_id;
+    let queue = loaded_thread_queue(&test)?;
+    let clock: Arc<dyn codex_queue_extension::QueueClock> =
+        if after_rejection.starts_with("before_transport") {
+            Arc::new(FinalSendClock {
+                inner: AuthRecoveryClock(marker.clone()),
+                observations: std::sync::atomic::AtomicUsize::new(0),
+                unknown: after_rejection == "before_transport_unknown",
+            })
+        } else {
+            Arc::new(AuthRecoveryClock(marker.clone()))
+        };
+    let staged = QueuedItemService::new(
+        Arc::clone(&queue),
+        Weak::new(),
+        Arc::new(NoopExtensionEventSink),
+    )
+    .with_clock(clock.clone());
+    let item = staged
+        .enqueue_bounded(
+            thread_id,
+            user_input("bounded prompt expired during auth recovery"),
+            None,
+            150_000_000,
+        )
+        .await?;
+    let live = QueuedItemService::new(
+        queue,
+        Arc::downgrade(&test.thread_manager),
+        Arc::new(NoopExtensionEventSink),
+    )
+    .with_clock(clock);
+    emit_idle(&live, thread_id).await;
+    wait_for_event_match(test.codex.as_ref(), |event| {
+        matches!(event, EventMsg::TurnComplete(_)).then_some(())
+    })
+    .await;
+    assert_eq!(
+        response.requests().len(),
+        expected_attempts,
+        "each retry must use current qualified time and the original deadline"
+    );
+    if after_rejection == "before_transport_unknown" {
+        assert!(
+            live.bounded_outcome(thread_id, item.id.clone())
+                .await?
+                .is_none(),
+            "unknown time before first send must not consume original pending entry"
+        );
+        assert_eq!(
+            live.list_bounded_page(thread_id, 0, 10).await?,
+            vec![item.clone()]
+        );
+        test.codex
+            .start_turn_if_idle(TurnInputRequest::new(user_input(
+                "operator control while clock unknown",
+            )))
+            .await?;
+        wait_for_event_match(test.codex.as_ref(), |event| {
+            matches!(event, EventMsg::TurnComplete(_)).then_some(())
+        })
+        .await;
+        assert_eq!(response.requests().len(), 1);
+        let body = response.requests()[0].body_json().to_string();
+        assert!(body.contains("operator control while clock unknown"));
+        assert!(!body.contains("bounded prompt expired during auth recovery"));
+        std::fs::write(&marker, "eligible")?;
+        emit_idle(&live, thread_id).await;
+        wait_for_event_match(test.codex.as_ref(), |event| {
+            matches!(event, EventMsg::TurnComplete(_)).then_some(())
+        })
+        .await;
+        assert_eq!(response.requests().len(), 2);
+        assert!(
+            response.requests()[1]
+                .body_json()
+                .to_string()
+                .contains("bounded prompt expired during auth recovery")
+        );
+        let original = live
+            .bounded_outcome(thread_id, item.id.clone())
+            .await?
+            .unwrap();
+        assert_eq!(original.record.id, item.id);
+        assert_eq!(original.record.expires_at, item.expires_at);
+        expected_attempts = 2;
+        expect_history = true;
+    }
+    let outcome = live
+        .bounded_outcome(thread_id, item.id.clone())
+        .await?
+        .unwrap();
+    assert_eq!(outcome.record.id, item.id);
+    assert_eq!(outcome.record.expires_at, item.expires_at);
+    if after_rejection == "before_transport" {
+        assert!(
+            matches!(
+                outcome.status,
+                codex_thread_store::BoundedQueueStatus::Expired
+            ),
+            "proven expiry before the first provider attempt is terminal"
+        );
+    } else {
+        assert!(
+            matches!(
+                outcome.status,
+                codex_thread_store::BoundedQueueStatus::Admitted { .. }
+            ),
+            "an actual first attempt remains recorded, not falsely undone"
+        );
+    }
+    live.enqueue(
+        thread_id,
+        user_input("ordinary control after rejected retry"),
+    )
+    .await?;
+    emit_idle(&live, thread_id).await;
+    wait_for_event_match(test.codex.as_ref(), |event| {
+        matches!(event, EventMsg::TurnComplete(_)).then_some(())
+    })
+    .await;
+    assert_eq!(response.requests().len(), expected_attempts + 1);
+    let body = response.requests()[expected_attempts]
+        .body_json()
+        .to_string();
+    assert!(body.contains("ordinary control after rejected retry"));
+    assert_eq!(
+        body.contains("bounded prompt expired during auth recovery"),
+        expect_history
+    );
+    if after_rejection == "before_transport" {
+        let rollout = test.codex.rollout_path().context("rollout path missing")?;
+        test.codex.shutdown_and_wait().await?;
+        test.thread_manager.remove_thread(&thread_id).await;
+        let resumed = test
+            .thread_manager
+            .resume_legacy_thread_from_rollout(
+                test.config.clone(),
+                rollout,
+                test.thread_manager.auth_manager(),
+                None,
+                Default::default(),
+            )
+            .await?;
+        resumed
+            .thread
+            .start_turn_if_idle(TurnInputRequest::new(user_input(
+                "resumed control after send refusal",
+            )))
+            .await?;
+        wait_for_event_match(resumed.thread.as_ref(), |event| {
+            matches!(event, EventMsg::TurnComplete(_)).then_some(())
+        })
+        .await;
+        assert_eq!(response.requests().len(), 2);
+        let body = response.requests()[1].body_json().to_string();
+        assert!(body.contains("resumed control after send refusal"));
+        assert!(!body.contains("bounded prompt expired during auth recovery"));
+    }
+    Ok(())
+}
