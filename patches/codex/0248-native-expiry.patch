+    /// Decide bounded admission under the same write transaction as selection.
+    /// The host callback must only read its independent clock and must be bounded;
+    /// it cannot mutate this queue. None or uncertain evidence leaves work pending.
+    pub async fn admit_bounded<F, Fut>(
+        &self,
+        expected: &QueuedUserSubmissionRecord,
+        turn_id: String,
+        clock: F,
+    ) -> anyhow::Result<Option<crate::BoundedQueueStatus>>
+    where
+        F: FnOnce() -> Fut + Send,
+        Fut: std::future::Future<Output = Option<crate::BoundedQueueClockSample>> + Send,
+    {
+        let expires_at = expected
+            .expires_at
+            .ok_or_else(|| anyhow::anyhow!("unbounded queue entry"))?;
