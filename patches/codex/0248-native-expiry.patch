+        let unchanged: i64 = sqlx::query_scalar(
+            "SELECT COUNT(*) FROM bounded_pending_items
+             WHERE thread_id = ? AND id = ? AND payload_json = ? AND expires_at = ?",
         )
+        .bind(expected.thread_id.to_string())
+        .bind(&expected.id)
+        .bind(&expected.payload)
+        .bind(expires_at)
+        .fetch_one(transaction.as_mut())
+        .await?;
+        if unchanged != 1 {
+            transaction.rollback().await?;
+            return Ok(None);
+        }
+        let Some(sample) = clock().await else {
+            transaction.rollback().await?;
+            return Ok(None);
+        };
+        let evidence = serde_json::from_str::<serde_json::Value>(&sample.evidence).ok();
+        if !sample.lower.is_finite()
+            || !sample.upper.is_finite()
+            || sample.lower > sample.upper
+            || sample.evidence.len() > 4096
+            || !evidence.as_ref().is_some_and(serde_json::Value::is_object)
+        {
+            transaction.rollback().await?;
+            return Ok(None);
+        }
+        let (status, wire_status, admitted_turn) =
+            if (sample.lower * 1_000_000.0).floor() as i128 >= expires_at as i128 {
+                (crate::BoundedQueueStatus::Expired, "expired", None)
+            } else if ((sample.upper * 1_000_000.0).ceil() as i128) < expires_at as i128 {
+                (
+                    crate::BoundedQueueStatus::Admitted {
+                        turn_id: turn_id.clone(),
+                    },
+                    "admitted",
+                    Some(turn_id),
+                )
+            } else {
+                transaction.rollback().await?;
+                return Ok(None);
+            };
+        let clock_evidence = serde_json::json!({
+            "lower": sample.lower, "upper": sample.upper, "authority": evidence,
+        })
+        .to_string();
+        sqlx::query("DELETE FROM bounded_pending_items WHERE thread_id = ? AND id = ?")
+            .bind(expected.thread_id.to_string())
+            .bind(&expected.id)
+            .execute(transaction.as_mut())
+            .await?;
+        sqlx::query(
+            "INSERT INTO bounded_queue_outcomes
+             (id, thread_id, payload_json, expires_at, status, recorded_at_ms, turn_id, clock_evidence)
+             VALUES (?, ?, ?, ?, ?, ?, ?, ?)",
+        ).bind(&expected.id).bind(expected.thread_id.to_string()).bind(&expected.payload)
+         .bind(expires_at).bind(wire_status).bind(datetime_to_epoch_millis(Utc::now()))
+         .bind(admitted_turn).bind(clock_evidence)
+         .execute(transaction.as_mut()).await?;
+        transaction.commit().await?;
+        Ok(Some(status))
