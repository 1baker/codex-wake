+// Explicit unit-boundary clock, not service/runtime qualification.
+struct AuthRecoveryClock(std::path::PathBuf);
+impl codex_queue_extension::QueueClock for AuthRecoveryClock {
+    fn sample(&self) -> codex_queue_extension::QueueClockFuture<'_> {
+        Box::pin(async move {
+            let mode = std::fs::read_to_string(&self.0).unwrap_or_default();
+            if mode == "unknown" {
+                return None;
+            }
+            let lower = if mode == "expired" { 200.0 } else { 100.0 };
+            Some(codex_thread_store::BoundedQueueClockSample {
+                lower, upper: lower + 1.0,
+                evidence: serde_json::json!({
+                    "source":"controlled-auth-clock", "contract_version":1, "state":"qualified",
+                    "lower":lower,"upper":lower+1.0,
+                    "counter":{"epoch":"11111111-1111-4111-8111-111111111111","counter":1,"frequency":10000000,"rate_ppm":5000}
+                }).to_string(),
+            })
+        })
+    }
+}
+
+// Explicit unit-boundary clock. The final send observation crosses the original
+// deadline after initial selection; API transport tests separately pin
+// the observation after authentication and sender waiting.
+// With non-consuming Pending preflight the final sender is the second clock
+// observation, rather than the old third observation after early consume.
+struct FinalSendClock {
+    inner: AuthRecoveryClock,
+    observations: std::sync::atomic::AtomicUsize,
+    unknown: bool,
+}
+impl codex_queue_extension::QueueClock for FinalSendClock {
+    fn sample(&self) -> codex_queue_extension::QueueClockFuture<'_> {
+        Box::pin(async move {
+            if self.observations.fetch_add(1, Ordering::SeqCst) == 1 {
+                std::fs::write(
+                    &self.inner.0,
+                    if self.unknown { "unknown" } else { "expired" },
+                )
+                .unwrap();
+            }
+            self.inner.sample().await
+        })
+    }
+}
