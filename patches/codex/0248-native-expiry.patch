+    .unwrap();
+    let selected = home.join("packages/app-server-daemon/current");
+    let before = selected.canonicalize().unwrap();
+    let backend =
+        crate::backend::PidBackend::new(selected.join("bin/codex"), daemon.pid_file.clone(), false);
+    backend.start().await.unwrap();
+    let pid_record = std::fs::read(&daemon.pid_file).unwrap();
+    let result = prepare_from_package(
+        &daemon,
+        &settings,
+        InstallMode::Replace,
+        Some(&source),
+        &bin,
+        |_| Ok(true),
+    )
+    .await;
+    let still_running = backend.is_starting_or_running().await.unwrap();
+    let after_pid_record = std::fs::read(&daemon.pid_file).ok();
+    let after = selected.canonicalize().unwrap();
+    backend.stop_with_grace(0).await.unwrap();
+    assert!(result.unwrap());
+    assert!(still_running);
+    assert_eq!(after_pid_record, Some(pid_record));
+    assert_eq!(after, before);
+    assert!(
+        !home
+            .join("packages/app-server-daemon/auto-update-version")
+            .exists()
+    );
+}
