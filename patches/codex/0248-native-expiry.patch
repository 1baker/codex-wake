+#[tokio::test]
+async fn local_replacement_refuses_a_running_daemon_before_changing_selection() {
+    let temp = tempfile::TempDir::new().unwrap();
+    let home = temp.path().join("home");
+    let daemon = daemon(&home);
+    let settings = DaemonSettings {
+        shutdown_grace_seconds: 0,
+        auto_update_enabled: false,
+        ..DaemonSettings::default()
+    };
+    let source = temp.path().join("package");
+    let bin = package(&source, "0.152.0");
+    prepare_from_package(
+        &daemon,
+        &settings,
+        InstallMode::Missing,
+        Some(&source),
+        &bin,
+        |_| Ok(true),
+    )
+    .await
+    .unwrap();
+    let selection = home
+        .join("packages/app-server-daemon/current")
+        .canonicalize()
+        .unwrap();
+    let live_bin = temp.path().join("live-daemon");
+    codex_utils_cargo_bin::write_executable(&live_bin, "#!/bin/sh\nexec sleep 30\n").unwrap();
+    let backend = crate::backend::PidBackend::new(live_bin, daemon.pid_file.clone(), false);
+    backend.start().await.unwrap();
+    let result = prepare_from_package(
+        &daemon,
+        &settings,
+        InstallMode::Replace,
+        Some(&source),
+        &bin,
+        |_| Ok(true),
+    )
+    .await;
+    let still_running = backend.is_starting_or_running().await.unwrap();
+    let after = home
+        .join("packages/app-server-daemon/current")
+        .canonicalize()
+        .unwrap();
+    backend.stop_with_grace(0).await.unwrap();
+    assert!(still_running, "replacement interrupted the running daemon");
+    assert_eq!(after, selection);
+    let error = result.expect_err("a local update must not stop an uncheckpointed daemon");
+    assert!(
+        error.to_string().contains("checkpoint and stop"),
+        "{error:#}"
+    );
+}
