+/// A native host's one-use asynchronous queue admission check.
+/// Clones share consumption. The assigned turn ID is recorded by the host before
+/// input is accepted; refusal or timeout must leave model input untouched.
+#[derive(Clone)]
+pub struct QueueAdmissionGuard {
+    admission: std::sync::Arc<std::sync::Mutex<Option<QueueAdmissionCallback>>>,
+    recheck: Option<std::sync::Arc<QueueRetryCallback>>,
+}
+type QueueAdmissionFuture = std::pin::Pin<Box<dyn std::future::Future<Output = bool> + Send>>;
+type QueueAdmissionCallback = Box<dyn FnOnce(String) -> QueueAdmissionFuture + Send + Sync>;
+type QueueRetryCallback = dyn Fn(String) -> QueueAdmissionFuture + Send + Sync;
+
+impl std::fmt::Debug for QueueAdmissionGuard {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
