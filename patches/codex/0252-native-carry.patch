+            .fork_thread_from_history(
+                codex_core::ForkSnapshot::Interrupted,
+                codex_core::StartThreadOptions {
+                    reserved_thread_id: Some(reserved_successor),
+                    ..codex_core::StartThreadOptions::new(target)
+                },
+                history,
+            )
+            .await
+    });
