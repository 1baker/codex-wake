+        })
+        .mount(&server)
+        .await;
+    let openai = test_codex().with_model("gpt-5.4").build(&server).await?;
+    openai
+        .codex
+        .start_or_steer_turn(TurnInputRequest::user_input(vec![UserInput::Text {
+            text: "Unrelated OpenAI work".into(),
+            text_elements: vec![],
