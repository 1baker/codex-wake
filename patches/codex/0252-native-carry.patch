+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn retained_terminal_and_legacy_history_does_not_hide_pending_work() {
+        let home = tempfile::tempdir().unwrap();
+        let root = home.path().join("daemon-upgrades");
+        private_dir(&root, true).unwrap();
+        for number in 0..300 {
+            let directory = root.join(format!("upgrade-retained-{number:04}"));
+            private_dir(&directory, true).unwrap();
+            let state = if number % 2 == 0 {
+                json!({"schema_version":2,"recovery_enabled":true,"phase":"recovered","threads":{}})
+            } else {
+                json!({"schema_version":1,"phase":"installedPaused","threads":{}})
+            };
+            upgrade_checkpoints::durable(&directory.join("state.json"), &state).unwrap();
+        }
+        assert!(scan_inventory(home.path()).unwrap().scan_incomplete);
+        assert!(
+            pending_work_operations(home.path())
+                .unwrap()
+                .contains(&INVENTORY_SCAN_OPERATION.to_string())
+        );
+        // A new directory created during a bounded sweep must invalidate that
+        // cursor, rather than letting an unexamined suffix grant admission.
+        let operation = "upgrade-still-pending";
+        let directory = root.join(operation);
+        private_dir(&directory, true).unwrap();
+        let thread = "019abcde-0000-7000-8000-000000000001";
+        upgrade_checkpoints::durable(
+            &directory.join("state.json"),
+            &json!({"schema_version":2,"recovery_enabled":true,"phase":"installing","threads":{thread:{}}}),
+        )
+        .unwrap();
+
+        let mut passes = 0;
+        loop {
+            passes += 1;
+            let inventory = scan_inventory(home.path()).unwrap();
+            if !inventory.scan_incomplete {
+                assert_eq!(inventory.pending_work_operations, vec![operation]);
+                break;
+            }
+            assert!(passes < 100);
+        }
+        assert!(passes > 1);
+        assert_eq!(std::fs::read_dir(root).unwrap().count(), 301);
+    }
+
