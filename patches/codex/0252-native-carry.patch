+            wait_for_event(&successor.thread, |event| {
+                matches!(event, EventMsg::TurnComplete(_))
+            })
+            .await;
+        } else {
+            assert!(
+                matches!(event, EventMsg::TurnComplete(done) if done.error.is_none() && done.last_agent_message.as_deref() == Some("Continued with completed results."))
+            );
+        }
+    }
+    assert_eq!(successor_calls.load(Ordering::SeqCst), 2);
+    assert_eq!(step.load(Ordering::SeqCst), 4);
+    if let Some(destination) = std::env::var_os("P233_CANONICAL_EVIDENCE_DIR") {
+        fixture.codex.flush_rollout().await?;
+        successor.thread.flush_rollout().await?;
+        let destination = std::path::PathBuf::from(destination).join("native-tool-continuation");
+        std::fs::create_dir_all(destination.join("sessions"))?;
+        std::fs::copy(
+            fixture.codex.rollout_path().expect("source"),
+            destination.join("sessions/source.jsonl"),
+        )?;
+        std::fs::copy(
+            successor.thread.rollout_path().expect("successor"),
+            destination.join("sessions/successor.jsonl"),
+        )?;
+        std::fs::write(
+            destination.join("root-thread-id"),
+            fixture.session_configured.thread_id.to_string(),
+        )?;
+    }
+    assert_eq!(
+        std::fs::read_to_string(fixture.cwd_path().join("grok-native.txt"))?,
+        "native patch\n"
+    );
+    Ok(())
+}
