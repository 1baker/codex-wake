+            matches!(event, EventMsg::TurnComplete(_) | EventMsg::Error(_))
+        })
+        .await;
+        if expect_budget_hold {
+            assert!(
+                matches!(event, EventMsg::Error(error) if error.codex_error_info == Some(codex_protocol::protocol::CodexErrorInfo::SessionBudgetExceeded))
