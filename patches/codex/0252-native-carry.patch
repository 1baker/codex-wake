+    admission
+        .prepare_upgrade(owner, "upgrade-disconnect")
+        .await
+        .expect("hold");
+    let recovery = admission.admit_steer(owner).expect("admitted recovery");
+    admission.release_upgrade(owner);
+    assert!(
+        admission.admit().is_err(),
+        "disconnect must not admit work while recovery is still activating the original goal"
+    );
+    assert!(admission.admit_turn_start().is_none());
+    drop(recovery);
+    drop(
+        admission
+            .admit()
+            .expect("completed recovery releases cancelled connection hold"),
+    );
+}
+
+#[tokio::test]
+async fn unresolved_recovery_disconnect_returns_to_boot_hold_until_matching_owner_settles() {
+    use crate::outgoing_message::ConnectionId;
+    let gate = TurnAdmission::with_pending_upgrade(Some("upgrade-restart".into()));
+    assert!(gate.admit().is_err());
+    let owner = ConnectionId(61);
+    gate.prepare_upgrade(owner, "upgrade-restart")
+        .await
+        .unwrap();
+    let active = gate.admit_steer(owner).unwrap();
+    gate.release_upgrade_with_pending(owner, Some("upgrade-restart".into()));
+    drop(active);
+    assert!(gate.admit().is_err());
+    assert!(gate.admit_steer(owner).is_err());
+    assert!(
+        gate.prepare_upgrade(ConnectionId(62), "wrong-upgrade")
+            .await
+            .is_err()
+    );
+    let next = ConnectionId(63);
+    gate.prepare_upgrade(next, "upgrade-restart").await.unwrap();
+    gate.release_upgrade_with_pending(next, None);
+    drop(gate.admit().unwrap());
+}
+
+#[tokio::test]
+async fn recovery_hold_is_retryable_and_cannot_override_shutdown() {
+    use crate::outgoing_message::ConnectionId;
+    let gate = TurnAdmission::with_pending_upgrade(Some("upgrade-restart".into()));
+    assert_eq!(
+        gate.admit().err().unwrap().code,
+        crate::error_code::OVERLOADED_ERROR_CODE
+    );
+    gate.prepare_upgrade(ConnectionId(71), "upgrade-restart")
+        .await
+        .unwrap();
+    gate.begin_drain();
+    assert!(gate.admit_steer(ConnectionId(71)).is_err());
+    gate.release_upgrade(ConnectionId(71));
+    assert!(gate.admit_turn_start().is_none());
+}
+
+#[tokio::test]
+async fn workspace_pause_and_upgrade_cannot_take_each_others_custody() {
+    use crate::outgoing_message::ConnectionId;
+    let admission = TurnAdmission::default();
+    let owner = ConnectionId(167);
+    let pause = admission.pause().await.expect("workspace owns admission");
+    assert!(
+        admission
+            .prepare_upgrade(owner, "upgrade-167")
+            .await
+            .is_err()
+    );
+    admission.release_upgrade(owner);
+    assert!(
+        admission.admit().is_err(),
+        "upgrade release cannot release workspace pause"
+    );
+    drop(pause);
+    admission
+        .prepare_upgrade(owner, "upgrade-167")
+        .await
+        .expect("upgrade owns admission");
+    assert!(admission.pause().await.is_err());
+    assert!(
+        admission.admit().is_err(),
+        "failed pause cannot release upgrade"
+    );
+    drop(
+        admission
+            .admit_steer(owner)
+            .expect("upgrade owner can checkpoint"),
+    );
+    admission.release_upgrade(owner);
+    drop(admission.admit().expect("owner release restores admission"));
+}
