+/// A retained coordinator lease must delay recovery, not exhaust its lifetime.
+/// The synthetic empty operation isolates scheduling from conversation admission;
+/// installed-package qualification separately exercises real saved work.
+#[cfg(unix)]
+#[tokio::test]
+async fn upgrade_recovery_continues_after_startup_budget_and_coordinator_release() -> Result<()> {
+    use std::os::unix::fs::PermissionsExt;
+
+    let home = TempDir::new()?;
+    create_config_toml(home.path(), "http://127.0.0.1:1", "never")?;
+    let operation = home.path().join("daemon-upgrades/upgrade-owner-loss");
+    std::fs::create_dir_all(&operation)?;
+    for directory in [operation.parent().context("upgrade root")?, &operation] {
+        std::fs::set_permissions(directory, std::fs::Permissions::from_mode(0o700))?;
+    }
+    let state = operation.join("state.json");
+    std::fs::write(
+        &state,
+        serde_json::to_vec(&json!({
+            "schema_version":2,"recovery_enabled":true,"phase":"installing","threads":{}
+        }))?,
+    )?;
+    std::fs::set_permissions(&state, std::fs::Permissions::from_mode(0o600))?;
+    let owner = std::fs::File::create(operation.join("coordinator.lock"))?;
+    owner.try_lock()?;
+    let socket = codex_app_server_transport::app_server_control_socket_path(home.path())?;
+    let mut server = spawn_server(home.path(), socket.as_path())?;
+    let mut client = connect_default_daemon_client(socket.as_path()).await?;
+    // This deliberately crosses the former real 30-second lifetime limit.
+    sleep(Duration::from_secs(32)).await;
+    assert_eq!(
+        serde_json::from_slice::<serde_json::Value>(&std::fs::read(&state)?)?["phase"],
+        "installing"
+    );
+    drop(owner);
+    timeout(Duration::from_secs(10), async {
+        loop {
+            let saved: serde_json::Value = serde_json::from_slice(&std::fs::read(&state)?)?;
+            if saved["phase"] == "recovered" {
+                return Ok::<(), anyhow::Error>(());
+            }
+            sleep(Duration::from_millis(25)).await;
+        }
+    })
+    .await
+    .context("recovery was abandoned after its startup budget")??;
+    start_thread(&mut client, /*id*/ 2, json!({})).await?;
+    request_shutdown(&server, socket.as_path()).await?;
+    wait_success(&mut server).await?;
+    Ok(())
+}
