+            let Ok(gate) = self.governor_exec_gate(&root) else {
+                return false;
+            };
+            // A start admitted before cancellation must publish its handle (or
+            // latch uncertainty) before this exact root can be verified stopped.
+            let _admission = gate.admission.write().await;
