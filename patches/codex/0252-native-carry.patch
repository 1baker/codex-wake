+    advance_queue_poll().await;
+    tokio::time::timeout(Duration::from_secs(/*secs*/ 5), async {
+        while clock.reads.load(Ordering::SeqCst) < 2 {
+            tokio::task::yield_now().await;
+        }
+    })
+    .await
+    .context("initial native watcher poll")?;
+    assert!(response.requests().is_empty());
+    assert_eq!(
+        service
+            .list_bounded_page(thread_id, /*offset*/ 0, /*limit*/ 10)
+            .await?
+            .len(),
+        1
+    );
+    clock.ready.store(true, Ordering::SeqCst);
+    advance_queue_poll().await;
+    wait_for_event_match(test.codex.as_ref(), |event| {
+        matches!(event, EventMsg::TurnComplete(_)).then_some(())
+    })
+    .await;
+    assert_eq!(response.requests().len(), 1);
+    assert!(
+        response.requests()[0]
+            .body_json()
+            .to_string()
+            .contains("bounded unexpired control")
+    );
+    assert!(
+        service
+            .list_bounded_page(thread_id, /*offset*/ 0, /*limit*/ 10)
+            .await?
+            .is_empty()
+    );
+    assert!(matches!(
+        service
+            .bounded_outcome(thread_id, item.id)
+            .await?
+            .unwrap()
+            .status,
+        codex_thread_store::BoundedQueueStatus::Admitted { .. }
+    ));
+    Ok(())
+}
