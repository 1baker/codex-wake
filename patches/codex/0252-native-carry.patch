+                    .map(|entry| (entry.process_id, Arc::clone(&entry.process)))
+                    .collect::<Vec<_>>()
+            };
+            let verified = futures::future::join_all(processes.into_iter().map(
+                |(process_id, process)| async move {
+                    if process.terminate_confirmed().await.is_err() {
+                        return false;
+                    }
