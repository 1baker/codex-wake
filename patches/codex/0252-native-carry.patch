+// #572: real shared composer rendering must keep governor status visible without inference.
+#[tokio::test]
+async fn wake_governor_strip_is_persistent_and_unknown_usage_is_explicit() {
+    let (mut widget, _sender, _events, _operations) = make_chatwidget_manual_with_sender().await;
+    let thread_id = ThreadId::new();
+    widget.thread_id = Some(thread_id);
+    widget.apply_wake_result(thread_id, Ok(serde_json::json!({
+        "schema_version":1,"state":"enforced","scope":{"thread_id":thread_id.to_string(),"kind":"task"},
+        "usage":{"used_tokens":25,"remaining_tokens":75,"elapsed_seconds":12},"limits":{"token_limit":100},"deadline":"14:30 UTC","watcher":{"fresh":true},"revision":1
+    })), false);
+    let frame = render_frame(&widget, 120);
+    assert!(contains_text(&frame, "Governor · ENFORCED"));
+    assert!(contains_text(&frame, "75 left"));
+    widget.apply_wake_result(thread_id, Err("watcher unavailable".into()), false);
+    let frame = render_frame(&widget, 120);
+    assert!(contains_text(&frame, "DISCONNECTED · accounting unknown"));
+    assert!(!contains_text(&frame, "75 left"));
+}
+
+// SPEC220-1: the strip must use the owner-selected effective allowance.
+#[tokio::test]
+async fn wake_governor_strip_uses_effective_remaining_tokens() {
+    let (mut widget, _sender, _events, _operations) = make_chatwidget_manual_with_sender().await;
+    let thread_id = ThreadId::new();
+    widget.thread_id = Some(thread_id);
+    let mut status = serde_json::json!({
+        "schema_version": 1, "state": "limit_reached",
+        "scope": {"thread_id": thread_id.to_string(), "kind": "task",
+                  "limiting_scope": "shared", "shared": {"used_tokens": 500, "token_limit": 500}},
+        "usage": {"used_tokens": 100, "remaining_tokens": 0},
+        "limits": {"token_limit": 1000}, "revision": 1
+    });
+    widget.apply_wake_result(thread_id, Ok(status.clone()), false);
+    let frame = render_frame(&widget, 160);
+    assert!(contains_text(&frame, "100/1000 · 0 left"));
+    assert!(!contains_text(&frame, "900 left"));
+
+    status["usage"]["remaining_tokens"] = serde_json::Value::Null;
+    status["revision"] = serde_json::json!(2);
+    widget.apply_wake_result(thread_id, Ok(status), false);
+    let frame = render_frame(&widget, 160);
+    assert!(contains_text(&frame, "100/1000 · unknown left"));
+    assert!(!contains_text(&frame, "900 left"));
+}
+
+// SPEC220-2: identify the owner-selected limiting scope and its shared ceilings.
+#[tokio::test]
+async fn wake_governor_identifies_limiting_scope_and_shared_allowance() {
+    let (mut widget, _sender, mut events, _operations) = make_chatwidget_manual_with_sender().await;
+    let thread_id = ThreadId::new();
+    widget.thread_id = Some(thread_id);
+    widget.apply_wake_result(
+        thread_id,
+        Ok(serde_json::json!({
+            "schema_version": 1, "state": "limit_reached", "reason": "allocation_exhausted",
+            "scope": {"thread_id": thread_id.to_string(), "kind": "task",
+                      "allocation_id": "shared-main", "limiting_scope": "shared",
+                      "shared": {"used_tokens": 500, "token_limit": 500,
+                                 "time_limit_seconds": 120, "deadline": 1893456120,
+                                 "deadline_basis": "qualified_utc"}},
+            "usage": {"used_tokens": 100, "remaining_tokens": 0},
+            "limits": {"token_limit": 1000}, "revision": 1
+        })),
+        true,
+    );
+    assert!(contains_text(
+        &render_frame(&widget, 160),
+        "limiting shared"
+    ));
+    let mut details = Vec::new();
+    while let Ok(event) = events.try_recv() {
+        if let crate::app_event::AppEvent::InsertHistoryCell(cell) = event {
+            details.extend(
+                cell.display_lines(160)
+                    .into_iter()
+                    .map(|line| line.to_string()),
+            );
+        }
+    }
+    let details = details.join("\n");
+    assert!(details.contains("limiting shared"));
+    assert!(details.contains("Shared allowance: shared-main"));
+    assert!(details.contains("Shared tokens: 500 used / 500 limit"));
+    assert!(details.contains("Shared time: 2m 00s limit"));
+}
