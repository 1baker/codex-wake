diff --git a/codex-rs/app-server/tests/suite/v2/thread_delete.rs b/codex-rs/app-server/tests/suite/v2/thread_delete.rs
index a29704d328930021fd5e5a0fb69cab072e73b925..d1b061eb298ae48bad46d60d9a223c45784c9212 100644
--- a/codex-rs/app-server/tests/suite/v2/thread_delete.rs
+++ b/codex-rs/app-server/tests/suite/v2/thread_delete.rs
@@ -643,0 +644,131 @@ async fn board_counts(pool: &sqlx::SqlitePool) -> Result<(i64, i64, i64)> {
+
+/// Exercise deletion and recovery through their supported requests: deliberately missing
+/// history must be distinguishable from unexplained data loss before cold restoration.
+#[tokio::test]
+async fn deleted_recovery_conversation_does_not_require_its_history() -> Result<()> {
+    use codex_app_server_protocol::DaemonUpgradeRecoveryAction;
+    use codex_app_server_protocol::DaemonUpgradeRecoveryParams;
+    use codex_app_server_protocol::DaemonUpgradeRecoveryResponse;
+    let home = TempDir::new()?;
+    let thread_id = create_delete_test_rollout(home.path(), 0, "finished recovered work")?;
+    let mut app = TestAppServer::builder()
+        .with_codex_home(home.path())
+        .without_auto_env()
+        .build_initialized()
+        .await?;
+    let operation = "upgrade-deleted-conversation";
+    seed_accepted_upgrade(home.path(), operation, &thread_id, "accepted-finished")?;
+    let _: ThreadDeleteResponse = app
+        .request(|request_id| ClientRequest::ThreadDelete {
+            request_id,
+            params: ThreadDeleteParams {
+                thread_id: thread_id.clone(),
+            },
+        })
+        .await?;
+    let recovered: DaemonUpgradeRecoveryResponse = app
+        .request(|request_id| ClientRequest::DaemonUpgradeRecovery {
+            request_id,
+            params: DaemonUpgradeRecoveryParams {
+                operation_id: operation.into(),
+                thread_id: thread_id.clone(),
+                action: DaemonUpgradeRecoveryAction::Resume,
+            },
+        })
+        .await?;
+    assert_eq!(recovered.status, "alreadyResumed");
+    assert_eq!(recovered.turn_id.as_deref(), Some("accepted-finished"));
+    assert!(
+        find_thread_path_by_id_str(home.path(), &thread_id, None)
+            .await?
+            .is_none()
+    );
+    app.shutdown_gracefully().await?;
+    let mut restarted = TestAppServer::builder()
+        .with_codex_home(home.path())
+        .build_initialized()
+        .await?;
+    restarted.start_thread(ThreadStartParams::default()).await?;
+    restarted.shutdown_gracefully().await?;
+    Ok(())
+}
+
+fn seed_accepted_upgrade(home: &Path, operation: &str, thread: &str, turn: &str) -> Result<()> {
+    let root = home.join("daemon-upgrades");
+    let directory = root.join(operation);
+    std::fs::create_dir_all(&directory)?;
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::PermissionsExt;
+        std::fs::set_permissions(&root, std::fs::Permissions::from_mode(0o700))?;
+        std::fs::set_permissions(&directory, std::fs::Permissions::from_mode(0o700))?;
+    }
+    for (name, value) in [
+        (
+            "state.json".to_string(),
+            json!({"schema_version":2,"recovery_enabled":true,"operation_id":operation,"phase":"recovered","threads":{thread.to_owned():{}}}),
+        ),
+        (
+            format!("{thread}.recovery.json"),
+            json!({"schema_version":2,"status":"resumed","turn_id":turn,"runtime_epoch":"prior-process"}),
+        ),
+    ] {
+        let path = directory.join(name);
+        std::fs::write(&path, serde_json::to_vec(&value)?)?;
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::PermissionsExt;
+            std::fs::set_permissions(&path, std::fs::Permissions::from_mode(0o600))?;
+        }
+    }
+    Ok(())
+}
+
+#[tokio::test]
+async fn terminal_recovery_is_settled_without_an_upgrade_replay() -> Result<()> {
+    let server = create_mock_responses_server_repeating_assistant("Done").await;
+    let home = TempDir::new()?;
+    MockResponsesConfig::new(&server.uri()).write(home.path())?;
+    let root = home.path().join("daemon-upgrades");
+    std::fs::create_dir(&root)?;
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::PermissionsExt;
+        std::fs::set_permissions(&root, std::fs::Permissions::from_mode(0o700))?;
+    }
+    let mut app = TestAppServer::builder()
+        .with_codex_home(home.path())
+        .build_initialized()
+        .await?;
+    let thread = app.start_thread(ThreadStartParams::default()).await?.thread;
+    let completed = app
+        .start_turn_and_wait_for_completion(TurnStartParams {
+            thread_id: thread.id.clone(),
+            input: vec![UserInput::Text {
+                text: "Finish this bounded task".into(),
+                text_elements: Vec::new(),
+            }],
+            ..Default::default()
+        })
+        .await?;
+    assert_eq!(completed.turn.status, TurnStatus::Completed);
+    // A fast completion may precede the acceptance journal write. The trusted
+    // terminal event must still settle the exact accepted turn without a replay.
+    seed_accepted_upgrade(
+        home.path(),
+        "upgrade-terminal-conversation",
+        &thread.id,
+        &completed.turn.id,
+    )?;
+    assert!(
+        codex_app_server_daemon::upgrade_recovery::pending_work_operations(home.path())?.is_empty()
+    );
+    app.shutdown_gracefully().await?;
+    let mut restarted = TestAppServer::builder()
+        .with_codex_home(home.path())
+        .build_initialized()
+        .await?;
+    restarted.start_thread(ThreadStartParams::default()).await?;
+    restarted.shutdown_gracefully().await?;
+    Ok(())
+}
