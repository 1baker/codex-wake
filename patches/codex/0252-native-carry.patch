diff --git a/codex-rs/tui/src/chatwidget/wake_governor.rs b/codex-rs/tui/src/chatwidget/wake_governor.rs
new file mode 100644
index 0000000000000000000000000000000000000000..50ed3c5db3e3e562b77d7cb1a591b5ab51220ce4
--- /dev/null
+++ b/codex-rs/tui/src/chatwidget/wake_governor.rs
@@ -0,0 +1,1173 @@
+//! Native presentation only. Wake's Python owner remains the accounting and effect authority.
+use super::*;
+use ratatui::text::Span;
+use serde_json::Value;
+
+#[derive(Default)]
+pub(super) struct GovernorUi {
+    snapshot: Option<Value>,
+    inspected: Option<Value>,
+    error: Option<String>,
+    selected: Option<String>,
+    selected_endpoint: Option<String>,
+    selected_home: Option<String>,
+    poll: Option<tokio::task::JoinHandle<()>>,
+    notice: Option<String>,
+    refresh: Arc<tokio::sync::Notify>,
+}
+impl Drop for GovernorUi {
+    fn drop(&mut self) {
+        if let Some(poll) = self.poll.take() {
+            poll.abort();
+        }
+    }
+}
+
+const USAGE: &str = "/wake governor [status|activate|extend|reset|disable|resume|advisory] [--token-limit N --time-limit-seconds N | --add-tokens N --add-seconds N] [--resume]";
+const VERBS: &[&str] = &[
+    "status", "activate", "extend", "reset", "disable", "resume", "advisory",
+];
+
+/// Accept only the published governor grammar. Never invoke a shell or forward model text.
+fn governor_argv(
+    input: &str,
+    selector: &str,
+    endpoint: &str,
+    revision: Option<u64>,
+) -> Result<Vec<String>, String> {
+    let words: Vec<_> = input.split_whitespace().collect();
+    let verb = words.first().copied().unwrap_or("status");
+    if !VERBS.contains(&verb) {
+        return Err(USAGE.into());
+    }
+    let mut argv = vec![
+        "governor".into(),
+        verb.into(),
+        selector.into(),
+        "--json".into(),
+        "--endpoint".into(),
+        endpoint.into(),
+    ];
+    let mut pos = 1;
+    let mut seen = std::collections::HashSet::new();
+    while pos < words.len() {
+        let flag = words[pos];
+        if !seen.insert(flag) {
+            return Err("Duplicate governor argument".into());
+        }
+        if flag == "--resume" && matches!(verb, "extend" | "reset" | "disable" | "advisory") {
+            argv.push(flag.into());
+            pos += 1;
+            continue;
+        }
+        let permitted = match verb {
+            "activate" | "reset" => matches!(flag, "--token-limit" | "--time-limit-seconds"),
+            "extend" => matches!(flag, "--add-tokens" | "--add-seconds"),
+            _ => false,
+        };
+        if !permitted
+            || pos + 1 >= words.len()
+            || words[pos + 1]
+                .parse::<u64>()
+                .ok()
+                .filter(|v| *v > 0)
+                .is_none()
+        {
+            return Err(USAGE.into());
+        }
+        argv.extend([flag.into(), words[pos + 1].into()]);
+        pos += 2;
+    }
+    if verb != "status" {
+        argv.extend(["--request-id".into(), uuid::Uuid::new_v4().to_string()]);
+        if let Some(revision) = revision {
+            argv.extend(["--expected-revision".into(), revision.to_string()]);
+        }
+    }
+    Ok(argv)
+}
+
+async fn invoke(argv: Vec<String>, thread_id: ThreadId) -> Result<Value, String> {
+    invoke_in_context(argv, thread_id, None).await
+}
+async fn invoke_in_context(
+    argv: Vec<String>,
+    thread_id: ThreadId,
+    home: Option<String>,
+) -> Result<Value, String> {
+    let recovery = argv
+        .windows(2)
+        .find(|pair| pair[0] == "--request-id")
+        .map(|pair| format!(" · reconcile request {} before retrying", pair[1]))
+        .unwrap_or_default();
+    let mut command = tokio::process::Command::new("codex-wake");
+    if let Some(home) = home {
+        command.env("CODEX_HOME", home);
+    }
+    command
+        .args(argv)
+        .env("CODEX_THREAD_ID", thread_id.to_string())
+        .kill_on_drop(true);
+    let output = tokio::time::timeout(Duration::from_secs(15), command.output())
+        .await
+        .map_err(|_| format!("Wake request timed out{recovery}"))?
+        .map_err(|error| format!("Wake disconnected: {error}{recovery}"))?;
+    let value: Value = serde_json::from_slice(&output.stdout).map_err(|_| {
+        format!("Wake returned no valid JSON; enforcement/accounting unknown{recovery}")
+    })?;
+    if !output.status.success() && value.get("state").is_none() {
+        return Err(format!(
+            "Wake request refused: {}{recovery}",
+            value
+                .pointer("/error/message")
+                .and_then(Value::as_str)
+                .or_else(|| value.pointer("/error/code").and_then(Value::as_str))
+                .unwrap_or("inspect the durable operation result")
+        ));
+    }
+    Ok(value)
+}
+
+// Bootstrap is pipe-only and validates same-user server process identity. Never log this token.
+async fn status_connection(thread_id: ThreadId) -> Result<(String, String), String> {
+    let value = invoke(vec!["control".into(), "connection".into()], thread_id)
+        .await
+        .map_err(|_| {
+            "Wake shared controller unavailable; connect it or inspect /wake governor".to_string()
+        })?;
+    let address = value
+        .get("url")
+        .and_then(Value::as_str)
+        .ok_or("Wake connection URL unavailable")?;
+    let parsed = url::Url::parse(address).map_err(|_| "Wake connection URL invalid")?;
+    if parsed.scheme() != "http"
+        || !matches!(parsed.host_str(), Some("127.0.0.1" | "::1"))
+        || parsed.port().is_none()
+        || !parsed.username().is_empty()
+        || parsed.password().is_some()
+        || parsed.query().is_some()
+        || parsed.fragment().is_some()
+        || parsed.path() != "/"
+    {
+        return Err("Wake status requires a qualified literal loopback connection".into());
+    }
+    #[cfg(unix)]
+    if value.get("uid").and_then(Value::as_u64) != Some(unsafe { libc::geteuid() } as u64) {
+        return Err("Wake status controller has a different owner".into());
+    }
+    let token = value
+        .get("token")
+        .and_then(Value::as_str)
+        .filter(|token| {
+            (32..=128).contains(&token.len())
+                && token
+                    .bytes()
+                    .all(|byte| byte.is_ascii_alphanumeric() || byte == b'_' || byte == b'-')
+        })
+        .ok_or("Wake connection credential invalid")?;
+    Ok((address.to_owned(), token.to_owned()))
+}
+async fn shared_status(
+    client: &reqwest::Client,
+    connection: &(String, String),
+    thread_id: ThreadId,
+    endpoint: &str,
+) -> Result<Value, String> {
+    let mut response = client.post(format!("{}/operations",connection.0)).bearer_auth(&connection.1)
+        .json(&serde_json::json!({"operation":"local.governor.status","arguments":{"selector":format!("thread:{thread_id}"),"endpoint":endpoint}}))
+        .send().await.map_err(|_|"Wake status connection lost; accounting unknown".to_string())?;
+    if !response.status().is_success() {
+        return Err("Wake status request refused; reconnect required".into());
+    }
+    let mut body = Vec::new();
+    while let Some(chunk) = response
+        .chunk()
+        .await
+        .map_err(|_| "Wake status response interrupted")?
+    {
+        if body.len() + chunk.len() > 1024 * 1024 {
+            return Err("Wake status response exceeds bound".into());
+        }
+        body.extend_from_slice(&chunk);
+    }
+    serde_json::from_slice(&body).map_err(|_| "Wake status JSON invalid; accounting unknown".into())
+}
+
+fn text(value: &Value, key: &str) -> String {
+    value
+        .get(key)
+        .filter(|v| !v.is_null())
+        .map(|v| {
+            v.as_str()
+                .map(str::to_owned)
+                .unwrap_or_else(|| v.to_string())
+        })
+        .unwrap_or_else(|| "unknown".into())
+}
+fn numeric(value: &Value, key: &str) -> Option<f64> {
+    value
+        .get(key)
+        .and_then(Value::as_f64)
+        .filter(|value| value.is_finite() && *value >= 0.0)
+}
+fn duration(seconds: Option<f64>) -> String {
+    match seconds {
+        Some(seconds) => {
+            let seconds = seconds.floor() as u64;
+            let hours = seconds / 3600;
+            let minutes = seconds / 60 % 60;
+            let tail = seconds % 60;
+            if hours > 0 {
+                format!("{hours}h {minutes:02}m")
+            } else if minutes > 0 {
+                format!("{minutes}m {tail:02}s")
+            } else {
+                format!("{tail}s")
+            }
+        }
+        None => "unknown".into(),
+    }
+}
+fn remaining_seconds(value: &Value) -> Option<f64> {
+    numeric(&value["usage"], "remaining_seconds").or_else(|| {
+        numeric(&value["limits"], "time_limit_seconds")
+            .zip(numeric(&value["usage"], "elapsed_seconds"))
+            .map(|(limit, elapsed)| (limit - elapsed).max(0.0))
+    })
+}
+fn deadline(value: &Value) -> String {
+    let basis = value
+        .get("deadline_basis")
+        .and_then(Value::as_str)
+        .or_else(|| {
+            value
+                .pointer("/owner_receipt/time_basis")
+                .and_then(Value::as_str)
+        })
+        .unwrap_or("unknown");
+    if basis.contains("counter") || basis.contains("elapsed") {
+        return "Wall deadline unavailable · authenticated host elapsed time".into();
+    }
+    if !basis.to_ascii_lowercase().contains("utc") {
+        return "Wall deadline unavailable · clock basis unqualified".into();
+    }
+    let instant = value
+        .get("deadline")
+        .and_then(Value::as_f64)
+        .filter(|seconds| seconds.is_finite() && *seconds >= 0.0 && *seconds < i64::MAX as f64)
+        .and_then(|seconds| {
+            chrono::DateTime::<chrono::Utc>::from_timestamp(seconds.floor() as i64, 0)
+        })
+        .or_else(|| {
+            value
+                .get("deadline")
+                .and_then(Value::as_str)
+                .and_then(|value| chrono::DateTime::parse_from_rfc3339(value).ok())
+                .map(|value| value.with_timezone(&chrono::Utc))
+        });
+    instant
+        .map(|instant| {
+            instant
+                .with_timezone(&chrono::Local)
+                .format("%a %b %d %H:%M:%S %Z")
+                .to_string()
+        })
+        .unwrap_or_else(|| "Wall deadline unavailable".into())
+}
+fn state_label(value: &Value) -> String {
+    text(value, "state").replace('_', " ").to_uppercase()
+}
+fn reason_label(value: &Value) -> String {
+    match value.get("reason").and_then(Value::as_str) {
+        Some("not_enrolled") => {
+            "No limits enrolled; activate when exact task work is running".into()
+        }
+        Some("watcher_stale" | "watcher_lost" | "watcher_unavailable") => {
+            "Enforcement watcher unavailable; task is held".into()
+        }
+        Some(reason) => reason.replace('_', " "),
+        None => "No additional reason reported".into(),
+    }
+}
+fn scope_label(value: &Value) -> String {
+    let scope = &value["scope"];
+    let id = scope
+        .get("thread_id")
+        .and_then(Value::as_str)
+        .unwrap_or("unknown");
+    let members = scope.get("members").and_then(Value::as_array).map(Vec::len);
+    let mut label = format!(
+        "{} {}{}",
+        text(scope, "kind"),
+        id.chars().take(8).collect::<String>(),
+        members
+            .map(|count| format!(" · {count} member{}", if count == 1 { "" } else { "s" }))
+            .unwrap_or_default()
+    );
+    if let Some(limiting) = scope.get("limiting_scope").and_then(Value::as_str) {
+        label.push_str(&format!(" · limiting {limiting}"));
+    }
+    label
+}
+fn watcher_label(value: &Value) -> &'static str {
+    match value.pointer("/watcher/fresh").and_then(Value::as_bool) {
+        Some(true) => "Healthy",
+        Some(false) => "Lost",
+        None => "Unknown",
+    }
+}
+fn meter(used: Option<u64>, limit: Option<u64>, remaining: Option<u64>) -> String {
+    match (used, limit) {
+        (Some(used), Some(limit)) if limit > 0 => {
+            let filled = ((used as u128 * 8 / limit as u128).min(8)) as usize;
+            format!(
+                "[{}{}] {used}/{limit} · {} left",
+                "━".repeat(filled),
+                "·".repeat(8 - filled),
+                remaining
+                    .map(|tokens| tokens.to_string())
+                    .unwrap_or_else(|| "unknown".into())
+            )
+        }
+        (Some(used), _) => format!("{used} used · limit unknown"),
+        _ => "usage unknown".into(),
+    }
+}
+
+impl ChatWidget {
+    fn wake_selector(&self) -> Option<String> {
+        self.wake_governor
+            .selected
+            .clone()
+            .or_else(|| self.thread_id.map(|id| format!("thread:{id}")))
+    }
+    fn wake_endpoint(&self) -> Result<String, String> {
+        let endpoint = if let Some(endpoint) = &self.wake_governor.selected_endpoint {
+            endpoint.as_str()
+        } else {
+            self.remote_connection
+                .as_ref()
+                .map(|remote| remote.address.as_str())
+                .ok_or("Governor requires a qualified local Unix daemon connection")?
+        };
+        let path = endpoint
+            .strip_prefix("unix://")
+            .ok_or("Governor unsupported for this remote transport; isolation unqualified")?;
+        // The account control address may be a symlink. Wake requires the
+        // physical socket and still validates its owner, peer and generation.
+        let path = std::fs::canonicalize(path)
+            .map_err(|_| "Governor local Unix daemon endpoint unavailable")?;
+        Ok(format!("unix://{}", path.display()))
+    }
+    pub(crate) fn start_wake_governor_poll(&mut self) {
+        if let Some(poll) = self.wake_governor.poll.take() {
+            poll.abort();
+        }
+        self.wake_governor.snapshot = None;
+        self.wake_governor.error = None;
+        self.wake_governor.selected = None;
+        self.wake_governor.selected_endpoint = None;
+        self.wake_governor.selected_home = None;
+        let Some(thread_id) = self.thread_id else {
+            return;
+        };
+        let endpoint = match self.wake_endpoint() {
+            Ok(endpoint) => endpoint,
+            Err(error) => {
+                self.wake_governor.error = Some(error);
+                return;
+            }
+        };
+        let tx = self.app_event_tx.clone();
+        let refresh = self.wake_governor.refresh.clone();
+        self.wake_governor.poll = Some(tokio::spawn(async move {
+            let client = match reqwest::Client::builder()
+                .no_proxy()
+                .redirect(reqwest::redirect::Policy::none())
+                .timeout(Duration::from_secs(15))
+                .connect_timeout(Duration::from_secs(2))
+                .build()
+            {
+                Ok(client) => client,
+                Err(_) => {
+                    tx.send(AppEvent::WakeResult {
+                        thread_id,
+                        result: Err("Wake status HTTP client unavailable".into()),
+                        operation: false,
+                    });
+                    return;
+                }
+            };
+            let mut connection = None;
+            loop {
+                if connection.is_none() {
+                    match status_connection(thread_id).await {
+                        Ok(value) => connection = Some(value),
+                        Err(error) => {
+                            tx.send(AppEvent::WakeResult {
+                                thread_id,
+                                result: Err(error),
+                                operation: false,
+                            });
+                            tokio::time::sleep(Duration::from_secs(30)).await;
+                            continue;
+                        }
+                    }
+                }
+                let result = shared_status(
+                    &client,
+                    connection.as_ref().expect("connection checked"),
+                    thread_id,
+                    &endpoint,
+                )
+                .await;
+                let slow = result.is_err()
+                    || result.as_ref().ok().is_some_and(|value| {
+                        value.get("state").and_then(Value::as_str) == Some("disabled")
+                    });
+                if result.is_err() {
+                    connection = None;
+                }
+                tx.send(AppEvent::WakeResult {
+                    thread_id,
+                    result,
+                    operation: false,
+                });
+                tokio::select! { _ = tokio::time::sleep(Duration::from_secs(if slow {30} else {3})) => {}, _ = refresh.notified() => {} }
+            }
+        }));
+    }
+    pub(super) fn refresh_wake_governor(&self) {
+        self.wake_governor.refresh.notify_one();
+    }
+    pub(crate) fn handle_wake_command(&mut self, arguments: &str) {
+        let Some(thread_id) = self.thread_id else {
+            self.add_error_message("Wake requires a current thread; no target was inferred".into());
+            return;
+        };
+        let input = arguments.trim();
+        if input.is_empty() || input == "governor" {
+            self.show_wake_menu();
+            return;
+        }
+        if let Some(verb) = input.strip_prefix("form ") {
+            self.show_wake_form(verb);
+            return;
+        }
+        let catalog = match input {
+            "list" => Some(vec!["list", "--json"]),
+            "tabs list" => Some(vec!["tabs", "list", "--json"]),
+            "tabs sessions list" => Some(vec!["tabs", "sessions", "list", "--json"]),
+            "accounts list" => Some(vec!["accounts", "list", "--json"]),
+            _ => None,
+        };
+        if let Some(argv) = catalog {
+            self.run_wake_catalog(argv.into_iter().map(str::to_owned).collect(), thread_id);
+            return;
+        }
+        if input == "targets" {
+            self.run_wake_catalog(
+                vec!["control".into(), "list".into(), "--json".into()],
+                thread_id,
+            );
+            return;
+        }
+        if let Some(target) = input.strip_prefix("select ") {
+            // Only picker-generated qualified selectors enter here; direct text cannot select an arbitrary target.
+            self.add_error_message(format!(
+                "Use /wake targets to select a qualified target ({target})"
+            ));
+            return;
+        }
+        let input = input.strip_prefix("governor ").unwrap_or(input);
+        let endpoint = match self.wake_endpoint() {
+            Ok(value) => value,
+            Err(error) => {
+                self.add_error_message(error);
+                return;
+            }
+        };
+        let selector = self.wake_selector().expect("thread exists");
+        let revision = self
+            .wake_governor
+            .inspected
+            .as_ref()
+            .or(self.wake_governor.snapshot.as_ref())
+            .filter(|v| {
+                v.pointer("/scope/thread_id")
+                    .and_then(Value::as_str)
+                    .map(|id| format!("thread:{id}"))
+                    == Some(selector.clone())
+            })
+            .and_then(|v| v.get("revision"))
+            .and_then(Value::as_u64);
+        match governor_argv(input, &selector, &endpoint, revision) {
+            Ok(argv) => {
+                let target = self
+                    .wake_governor
+                    .selected
+                    .as_deref()
+                    .and_then(|selector| selector.strip_prefix("thread:"))
+                    .and_then(|id| ThreadId::from_string(id).ok())
+                    .unwrap_or(thread_id);
+                let home = self.wake_governor.selected_home.clone();
+                let tx = self.app_event_tx.clone();
+                tokio::spawn(async move {
+                    tx.send(AppEvent::WakeResult {
+                        thread_id,
+                        result: invoke_in_context(argv, target, home).await,
+                        operation: true,
+                    });
+                });
+            }
+            Err(error) => self.add_error_message(error),
+        }
+    }
+    fn show_wake_catalog_result(&mut self, value: &Value) {
+        let value = value.get("result").unwrap_or(value);
+        let rows = value.as_array().or_else(|| {
+            ["tabs", "sessions", "accounts", "records", "wakes"]
+                .iter()
+                .find_map(|key| value.get(*key).and_then(Value::as_array))
+        });
+        let lines=rows.map(|rows|rows.iter().take(100).map(|row|Line::from(format!("{} · {}",row.get("name").or_else(||row.get("title")).or_else(||row.get("id")).or_else(||row.get("thread_id")).and_then(Value::as_str).unwrap_or("Wake record"),row.get("status").or_else(||row.get("state")).and_then(Value::as_str).unwrap_or("available")))).collect::<Vec<_>>()).filter(|lines|!lines.is_empty()).unwrap_or_else(||vec![Line::from("Wake catalog returned no displayable rows; use the matching CLI --json for complete machine details")]);
+        self.add_plain_history_lines(lines);
+    }
+    fn run_wake_catalog(&self, argv: Vec<String>, thread_id: ThreadId) {
+        let targets = argv.get(0).map(String::as_str) == Some("control")
+            && argv.get(1).map(String::as_str) == Some("list");
+        let tx = self.app_event_tx.clone();
+        tokio::spawn(async move {
+            tx.send(AppEvent::WakeResult {
+                thread_id,
+                result: invoke(argv, thread_id).await.map(|mut value| {
+                    if targets && let Some(object) = value.as_object_mut() {
+                        object.insert("_native_target_inventory".into(), Value::Bool(true));
+                    }
+                    value
+                }),
+                operation: true,
+            });
+        });
+    }
+    pub(crate) fn apply_wake_result(
+        &mut self,
+        thread_id: ThreadId,
+        result: Result<Value, String>,
+        operation: bool,
+    ) {
+        if self.thread_id != Some(thread_id) {
+            return;
+        }
+        match result {
+            Ok(value) => {
+                if value
+                    .get("_native_target_inventory")
+                    .and_then(Value::as_bool)
+                    == Some(true)
+                {
+                    self.show_wake_targets(&value);
+                    return;
+                }
+                if value.get("state").is_none() {
+                    if !operation {
+                        self.wake_governor.error =
+                            Some("Wake status schema unavailable; accounting unknown".into());
+                        self.request_redraw();
+                        return;
+                    }
+                    if operation {
+                        self.show_wake_catalog_result(&value);
+                    }
+                    return;
+                }
+                if !operation
+                    && self
+                        .wake_governor
+                        .snapshot
+                        .as_ref()
+                        .is_some_and(|previous| {
+                            previous.pointer("/scope/allocation_id")
+                                == value.pointer("/scope/allocation_id")
+                                && previous
+                                    .get("revision")
+                                    .and_then(Value::as_u64)
+                                    .zip(value.get("revision").and_then(Value::as_u64))
+                                    .is_some_and(|(old, new)| old > new)
+                        })
+                {
+                    return;
+                }
+                let current_scope = value.pointer("/scope/thread_id").and_then(Value::as_str)
+                    == Some(thread_id.to_string().as_str());
+                if !operation && !current_scope {
+                    self.wake_governor.error =
+                        Some("Wake status scope changed; accounting unknown".into());
+                    self.request_redraw();
+                    return;
+                }
+                let state = text(&value, "state");
+                let notice = matches!(state.as_str(),"limit_reached"|"disconnected").then(|| format!("Governor {state}: {}. /wake governor offers extend, reset, disable, explicit resume and checkpoint details.",text(&value,"reason")));
+                if current_scope && notice != self.wake_governor.notice {
+                    if let Some(notice) = &notice {
+                        self.add_info_message(notice.clone(), None);
+                    }
+                    self.wake_governor.notice = notice;
+                }
+                if current_scope {
+                    self.wake_governor.error = None;
+                }
+                if operation {
+                    self.add_info_message(
+                        format!(
+                            "Wake {} · {} · {}",
+                            if value.get("status").and_then(Value::as_str) == Some("held") {
+                                "HELD".into()
+                            } else {
+                                state_label(&value)
+                            },
+                            scope_label(&value),
+                            reason_label(&value)
+                        ),
+                        None,
+                    );
+                }
+                if operation {
+                    self.refresh_wake_governor();
+                    self.wake_governor.inspected = Some(value.clone());
+                    self.show_wake_details(&value);
+                }
+                if current_scope {
+                    self.wake_governor.snapshot = Some(value);
+                }
+            }
+            Err(error) => {
+                if operation {
+                    self.add_error_message(error.clone());
+                }
+                let current_scope =
+                    !operation || self.wake_selector() == Some(format!("thread:{thread_id}"));
+                if current_scope && self.wake_governor.error.as_ref() != Some(&error) {
+                    self.add_info_message(format!("Governor disconnected · accounting unknown: {error}. /wake governor to inspect or repair; no advisory fallback."),None);
+                }
+                if current_scope {
+                    self.wake_governor.error = Some(error);
+                }
+            }
+        }
+        self.request_redraw();
+    }
+    pub(super) fn wake_governor_lines(&self) -> Vec<Line<'static>> {
+        if self.thread_id.is_none() {
+            return Vec::new();
+        }
+        let slate = ratatui::style::Style::default().fg(ratatui::style::Color::Rgb(148, 163, 184));
+        if let Some(error) = &self.wake_governor.error {
+            return vec![Line::from(vec![
+                Span::styled(" Governor · DISCONNECTED", slate),
+                format!(" · accounting unknown · {error} · /wake").into(),
+            ])];
+        }
+        let Some(value) = &self.wake_governor.snapshot else {
+            return vec![Line::from(" Governor · CONNECTING · usage unknown · /wake")];
+        };
+        vec![
+            Line::from(vec![
+                Span::styled(format!(" Governor · {}", state_label(value)), slate),
+                format!(" · {} · /wake governor", scope_label(value)).into(),
+            ]),
+            Line::from(
+                format!(
+                    " Tokens {} · time {} used / {} left",
+                    meter(
+                        value.pointer("/usage/used_tokens").and_then(Value::as_u64),
+                        value.pointer("/limits/token_limit").and_then(Value::as_u64),
+                        value
+                            .pointer("/usage/remaining_tokens")
+                            .and_then(Value::as_u64)
+                    ),
+                    duration(numeric(&value["usage"], "elapsed_seconds")),
+                    duration(remaining_seconds(value))
+                )
+                .dim(),
+            ),
+        ]
+    }
+    fn show_wake_details(&mut self, value: &Value) {
+        let accounting = if value
+            .pointer("/usage/used_tokens")
+            .and_then(Value::as_u64)
+            .is_some()
+        {
+            "Known"
+        } else {
+            "Unknown"
+        };
+        let mut lines = vec![
+            Line::from(format!(
+                "Governor {} · {}",
+                state_label(value),
+                scope_label(value)
+            )),
+            Line::from(format!(
+                "Tokens: {} used · {} remaining · {} lifetime",
+                text(&value["usage"], "used_tokens"),
+                text(&value["usage"], "remaining_tokens"),
+                text(&value["usage"], "lifetime_used_tokens")
+            )),
+            Line::from(format!(
+                "Time: {} elapsed · {} remaining",
+                duration(numeric(&value["usage"], "elapsed_seconds")),
+                duration(remaining_seconds(value))
+            )),
+            Line::from(format!("Deadline: {}", deadline(value))),
+            Line::from(format!(
+                "Enforcement: watcher {} · accounting {accounting} · revision {}",
+                watcher_label(value),
+                text(value, "revision")
+            )),
+            Line::from(format!(
+                "Scope: {} · selected {}",
+                scope_label(value),
+                self.wake_selector().unwrap_or_else(|| "unknown".into())
+            )),
+            Line::from(format!("Reason: {}", reason_label(value))),
+        ];
+        if let Some(shared) = value
+            .pointer("/scope/shared")
+            .filter(|shared| shared.is_object())
+        {
+            lines.push(Line::from(format!(
+                "Shared allowance: {}",
+                text(&value["scope"], "allocation_id")
+            )));
+            lines.push(Line::from(format!(
+                "Shared tokens: {} used / {} limit",
+                text(shared, "used_tokens"),
+                text(shared, "token_limit")
+            )));
+            lines.push(Line::from(format!(
+                "Shared time: {} limit · deadline {}",
+                duration(numeric(shared, "time_limit_seconds")),
+                deadline(shared)
+            )));
+        }
+        if let Some(operation) = value.get("operation") {
+            lines.push(Line::from(format!(
+                "Continuation: {} · {}",
+                if operation.get("resumed").and_then(Value::as_bool) == Some(true) {
+                    "Submitted"
+                } else {
+                    "Not resumed"
+                },
+                operation
+                    .get("resume_state")
+                    .and_then(Value::as_str)
+                    .unwrap_or("no continuation requested")
+                    .replace('_', " ")
+            )));
+        }
+        if let Some(checkpoint) = value.get("checkpoint").and_then(Value::as_str).or_else(|| {
+            value
+                .pointer("/owner_receipt/checkpoint/path")
+                .and_then(Value::as_str)
+        }) {
+            lines.push(Line::from(format!("Retained checkpoint: {checkpoint}")));
+        }
+        lines.push(Line::from(
+            "/wake governor · extend, reset, disable, repair or explicitly resume",
+        ));
+        self.add_plain_history_lines(lines);
+    }
+    fn show_wake_menu(&mut self) {
