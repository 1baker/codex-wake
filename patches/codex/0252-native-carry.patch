+            let (accepted, provider) =
+                codex_core::inference_selection::resolve(&catalog, Some(selection))
+                    .map_err(|_| held())?
+                    .ok_or_else(held)?;
+            if current.model_provider_id != accepted.selection.provider_id
+                || current.model.as_deref() != Some(accepted.selection.model_id.as_str())
+                || current.model_provider != provider
+            {
+                return Err(held());
