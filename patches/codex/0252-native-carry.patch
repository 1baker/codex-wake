+#[tokio::test]
+async fn bounded_grok_rechecks_admission_after_async_authentication() -> Result<()> {
+    use std::sync::atomic::{AtomicBool, Ordering};
+    struct ExpiringAuth(Arc<AtomicBool>);
+    impl AuthProvider for ExpiringAuth {
+        fn add_auth_headers(&self, headers: &mut HeaderMap) -> Result<(), AuthError> {
+            headers.insert(http::header::AUTHORIZATION, HeaderValue::from_static("Bearer synthetic"));
+            Ok(())
+        }
+        fn apply_auth_headers<'a>(&'a self, headers: HeaderMap) -> codex_api::AuthHeadersFuture<'a> {
+            Box::pin(async move {
+                tokio::task::yield_now().await;
+                self.0.store(false, Ordering::SeqCst);
+                let mut headers = headers;
+                self.add_auth_headers(&mut headers)?;
+                Ok(headers)
+            })
+        }
+    }
+    let eligible = Arc::new(AtomicBool::new(true));
+    let clock = Arc::clone(&eligible);
+    let state = RecordingState::default();
+    let mut p = provider("grok");
+    p.base_url = "https://cli-chat-proxy.grok.com/v1".into();
+    let result = codex_api::GrokClient::new(
+        RecordingTransport::new(state.clone()), p, Arc::new(ExpiringAuth(eligible)),
+    ).with_request_admission(Some(Arc::new(move || {
+        let clock = Arc::clone(&clock);
+        Box::pin(async move { clock.load(Ordering::SeqCst) })
+    }))).stream_request(grok_request(vec![])).await;
+    assert!(matches!(result, Err(ApiError::RequestNotAdmitted)),
+        "Grok must hold expired bounded input after authentication");
+    assert!(state.take_stream_requests().is_empty(), "expired input reached Grok transport");
+    Ok(())
+}
