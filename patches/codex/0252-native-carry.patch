+/// A native host's one-use asynchronous queue admission check.
+/// Clones share consumption. The assigned turn ID is recorded by the host before
+/// input is accepted; refusal or timeout must leave model input untouched.
+#[derive(Clone)]
+pub struct QueueAdmissionGuard {
+    admission: std::sync::Arc<std::sync::Mutex<Option<QueueAdmissionCallback>>>,
+    recheck: Option<std::sync::Arc<QueueRetryCallback>>,
+}
+type QueueAdmissionFuture = std::pin::Pin<Box<dyn std::future::Future<Output = bool> + Send>>;
+type QueueAdmissionCallback = Box<dyn FnOnce(String) -> QueueAdmissionFuture + Send + Sync>;
+type QueueRetryCallback = dyn Fn(String) -> QueueAdmissionFuture + Send + Sync;
+
+impl std::fmt::Debug for QueueAdmissionGuard {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("QueueAdmissionGuard(..)")
+    }
+}
+
+impl QueueAdmissionGuard {
+    pub fn new(admit: impl FnOnce(String) -> QueueAdmissionFuture + Send + Sync + 'static) -> Self {
+        Self {
+            admission: std::sync::Arc::new(std::sync::Mutex::new(Some(Box::new(admit)))),
+            recheck: None,
+        }
+    }
+
+    /// A fresh host check for retries before a provider has accepted a stream.
+    /// Missing retry authority refuses another attempt rather than reusing admission.
+    pub fn with_recheck(
+        mut self,
+        check: impl Fn(String) -> QueueAdmissionFuture + Send + Sync + 'static,
+    ) -> Self {
+        self.recheck = Some(std::sync::Arc::new(check));
+        self
+    }
+
+    pub async fn recheck(&self, turn_id: String) -> bool {
+        match &self.recheck {
+            Some(check) => check(turn_id).await,
+            None => false,
+        }
+    }
+
+    pub async fn consume(self, turn_id: String) -> bool {
+        let admit = self
+            .admission
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .take();
+        match admit {
+            Some(admit) => admit(turn_id).await,
+            None => false,
+        }
+    }
+}
+
