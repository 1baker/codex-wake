+      "selections":[{"providerId":"grok__personal","accountId":"personal","accountRevision":"account-v1",
+        "modelId":"grok-build","catalogRevision":"catalog-v1","evidenceRevision":"unverified",
+        "selectionId":"selection-v1","accountLabel":"Personal Grok","displayName":"Grok Build",
+        "contextWindow":32000,"readiness":"unverified","reasons":["entitlement_and_inference_unverified"],
+        "capabilities":{"text":true,"streaming":true,"terminal":true,"file_editing":true,"mcp":true},
+        "disabledFeatures":["image_generation","web_search","reasoning_summary"],
+        "defaultForAccount":false,"source":"operator-model-metadata"}]});
+    std::fs::write(&source, serde_json::to_vec(&catalog)?)?;
+    std::fs::write(
+        home.path().join("config.toml"),
+        format!(
+            "openai_base_url = 'http://127.0.0.1:9/v1'\n[inference_catalog_command]\ncommand = '/bin/cat'\nargs = ['{}']\ncwd = '/'\ntimeoutMs = 1000\n",
+            source.display()
+        ),
+    )?;
+    let mut app = TestAppServer::builder()
+        .with_codex_home(home.path())
+        .with_env_overrides(&[("OPENAI_API_KEY", None), ("CODEX_API_KEY", None)])
+        .build_initialized()
+        .await?;
+    let held: ModelListResponse = app
+        .request(|request_id| ClientRequest::ModelList {
+            request_id,
+            params: ModelListParams {
+                include_hidden: Some(true),
+                ..Default::default()
+            },
+        })
+        .await?;
+    assert!(
+        held.data
+            .iter()
+            .any(|model| model.is_default && model.inference_selection.is_none())
+    );
+    let choice = held
+        .data
+        .iter()
+        .find(|m| m.inference_selection.is_some())
+        .expect("native Grok choice");
+    assert_eq!(choice.display_name, "Personal Grok · Grok Build");
+    let requested = serde_json::to_value(choice.inference_selection.as_ref().expect("snapshot"))?;
+    let start = |selection| ThreadStartParams {
+        config: Some(std::collections::HashMap::from([(
+            "inference_selection".into(),
+            selection,
+        )])),
+        ..Default::default()
+    };
+    let id = app.send_thread_start_request(start(requested)).await?;
+    let _: JSONRPCError = timeout(
+        DEFAULT_TIMEOUT,
+        app.read_stream_until_error_message(RequestId::Integer(id)),
+    )
+    .await??;
+    catalog["selections"][0]["readiness"] = json!("qualified");
+    catalog["selections"][0]["reasons"] = json!([]);
+    catalog["selections"][0]["evidenceRevision"] = json!("independent-coding-receipt-v1");
+    std::fs::write(&source, serde_json::to_vec(&catalog)?)?;
+    let qualified: ModelListResponse = app
+        .request(|request_id| ClientRequest::ModelList {
+            request_id,
+            params: ModelListParams {
+                include_hidden: Some(true),
+                ..Default::default()
+            },
+        })
+        .await?;
+    let snapshot = qualified
+        .data
+        .into_iter()
+        .find_map(|m| m.inference_selection)
+        .expect("qualified snapshot");
+    assert_eq!(snapshot.selection.readiness, "qualified");
+    catalog["selections"][0]["capabilities"]["terminal"] = json!(false);
+    std::fs::write(&source, serde_json::to_vec(&catalog)?)?;
+    let incomplete: ModelListResponse = app
+        .request(|request_id| ClientRequest::ModelList {
+            request_id,
+            params: ModelListParams {
+                include_hidden: Some(true),
+                ..Default::default()
+            },
+        })
+        .await?;
+    let incomplete = incomplete
+        .data
+        .into_iter()
+        .find_map(|m| m.inference_selection)
+        .expect("incomplete capability snapshot");
+    assert_eq!(incomplete.selection.readiness, "unavailable");
+    assert!(
+        incomplete
+            .selection
+            .reasons
+            .contains(&"required_capability_missing:terminal".to_string())
+    );
+    let id = app
+        .send_thread_start_request(start(serde_json::to_value(incomplete)?))
+        .await?;
+    let _: JSONRPCError = timeout(
+        DEFAULT_TIMEOUT,
+        app.read_stream_until_error_message(RequestId::Integer(id)),
+    )
+    .await??;
+    catalog["selections"][0]["capabilities"]["terminal"] = json!(true);
+    std::fs::write(&source, serde_json::to_vec(&catalog)?)?;
+    let started: ThreadStartResponse = app
+        .start_thread(start(serde_json::to_value(&snapshot)?))
+        .await?;
+    assert_eq!(started.model_provider, "grok__personal");
+    assert_eq!(started.model, "grok-build");
+    let unqualified_model = app
+        .send_turn_start_request(codex_app_server_protocol::TurnStartParams {
+            thread_id: started.thread.id.clone(),
+            model: Some("unqualified-other-model".into()),
+            input: vec![codex_app_server_protocol::UserInput::Text {
+                text: "Preserve the admitted model identity".into(),
+                text_elements: Vec::new(),
+            }],
+            ..Default::default()
+        })
+        .await?;
+    let unqualified_model: JSONRPCError = timeout(
+        DEFAULT_TIMEOUT,
+        app.read_stream_until_error_message(RequestId::Integer(unqualified_model)),
+    )
+    .await??;
+    assert!(
+        unqualified_model
+            .error
+            .message
+            .contains("qualified account/model selection")
+    );
+    // A cross-provider fork is a continuation of the same governed work, not
+    // a new allowance carrying the source provider's opaque state.
+    let _: codex_app_server_protocol::ThreadInjectItemsResponse = app.request(|request_id| {
+        ClientRequest::ThreadInjectItems { request_id, params: codex_app_server_protocol::ThreadInjectItemsParams {
+            thread_id: started.thread.id.clone(),
+            items: vec![
+                json!({"type":"message","role":"user","content":[{"type":"input_text","text":"Finish the parser; preserve public signatures."}]}),
+                json!({"type":"reasoning","summary":[],"encrypted_content":"SOURCE_PRIVATE_REASONING"}),
+                json!({"type":"function_call","name":"exec_command","arguments":"{}","call_id":"completed-tool"}),
+                json!({"type":"function_call_output","call_id":"completed-tool","output":"parser.rs updated; tests passed"}),
+            ],
+        }}
+    }).await?;
+    let fork: codex_app_server_protocol::ThreadForkResponse = app
+        .request(|request_id| ClientRequest::ThreadFork {
+            request_id,
+            params: codex_app_server_protocol::ThreadForkParams {
+                thread_id: started.thread.id.clone(),
+                model_provider: Some("openai".into()),
+                model: Some("gpt-5.1-codex".into()),
+                ..Default::default()
+            },
+        })
+        .await?;
+    let destination =
+        std::fs::read_to_string(fork.thread.path.as_ref().expect("persisted successor"))?;
+    let meta: serde_json::Value =
+        serde_json::from_str(destination.lines().next().expect("metadata"))?;
+    assert_eq!(meta["payload"]["parent_thread_id"], started.thread.id);
+    assert_eq!(meta["payload"]["session_id"], started.thread.id);
+    assert_eq!(meta["payload"]["forked_from_id"], started.thread.id);
+    assert!(destination.contains("Finish the parser; preserve public signatures."));
+    assert!(destination.contains("parser.rs updated; tests passed"));
+    assert!(!destination.contains("SOURCE_PRIVATE_REASONING"));
+    assert!(!destination.contains("\"type\":\"function_call\""));
+    let returned: codex_app_server_protocol::ThreadForkResponse = app
+        .request(|request_id| ClientRequest::ThreadFork {
+            request_id,
+            params: codex_app_server_protocol::ThreadForkParams {
+                thread_id: fork.thread.id.clone(),
+                model_provider: Some("grok__personal".into()),
+                model: Some("grok-build".into()),
+                config: Some(std::collections::HashMap::from([(
+                    "inference_selection".into(),
+                    json!(snapshot.clone()),
+                )])),
+                ..Default::default()
+            },
+        })
+        .await?;
+    assert_eq!(
+        returned.thread.parent_thread_id.as_deref(),
+        Some(fork.thread.id.as_str())
+    );
+    assert_eq!(returned.thread.session_id, started.thread.id);
+    let returned_history =
+        std::fs::read_to_string(returned.thread.path.as_ref().expect("return history"))?;
+    assert!(
+        returned_history.contains("parser.rs updated; tests passed"),
+        "completed results must survive another provider boundary"
+    );
+    assert!(
+        returned_history.contains("completed-tool"),
+        "original call identity must survive"
+    );
+    assert!(!returned_history.contains("SOURCE_PRIVATE_REASONING"));
+    assert!(!returned_history.contains("\"type\":\"function_call\""));
+    let source_history =
+        std::fs::read_to_string(started.thread.path.as_ref().expect("source history"))?;
+    assert!(source_history.contains("SOURCE_PRIVATE_REASONING"));
+    assert!(
+        meta["payload"]["history_base"].is_null(),
+        "portable successor must not reference opaque source context"
+    );
+    let rejected = app
+        .send_turn_start_request(codex_app_server_protocol::TurnStartParams {
+            thread_id: started.thread.id.clone(),
+            input: vec![codex_app_server_protocol::UserInput::Text {
+                text: "Do not start on the old provider".into(),
+                text_elements: Vec::new(),
+            }],
+            ..Default::default()
+        })
+        .await?;
+    let rejected: JSONRPCError = timeout(
+        DEFAULT_TIMEOUT,
+        app.read_stream_until_error_message(RequestId::Integer(rejected)),
+    )
+    .await??;
+    assert!(
+        rejected
+            .error
+            .message
+            .contains("Provider continuation held")
+    );
+    if let Some(destination) = std::env::var_os("P233_CANONICAL_EVIDENCE_DIR") {
+        let destination = std::path::PathBuf::from(destination).join("provider-continuation");
+        std::fs::create_dir_all(destination.join("sessions"))?;
+        std::fs::copy(
+            started.thread.path.as_ref().expect("source"),
+            destination.join("sessions/source.jsonl"),
+        )?;
+        std::fs::copy(
+            fork.thread.path.as_ref().expect("successor"),
+            destination.join("sessions/successor.jsonl"),
+        )?;
+        std::fs::write(destination.join("root-thread-id"), &started.thread.id)?;
+    }
+    let uncertain: ThreadStartResponse = app
+        .start_thread(start(serde_json::to_value(&snapshot)?))
+        .await?;
+    let _: codex_app_server_protocol::ThreadInjectItemsResponse = app.request(|request_id| ClientRequest::ThreadInjectItems {
+        request_id, params: codex_app_server_protocol::ThreadInjectItemsParams {
+            thread_id: uncertain.thread.id.clone(), items: vec![
+                json!({"type":"message","role":"user","content":[{"type":"input_text","text":"Preserve the uncertain action; never replay it."}]}),
+                json!({"type":"function_call","name":"exec_command","arguments":"{}","call_id":"uncertain-effect"}),
+            ],
+        },
+    }).await?;
+    let held = app
+        .send_thread_fork_request(codex_app_server_protocol::ThreadForkParams {
+            thread_id: uncertain.thread.id.clone(),
+            model_provider: Some("openai".into()),
+            model: Some("gpt-5.1-codex".into()),
+            ..Default::default()
+        })
+        .await?;
+    let held: JSONRPCError = timeout(
+        DEFAULT_TIMEOUT,
+        app.read_stream_until_error_message(RequestId::Integer(held)),
+    )
+    .await??;
+    assert!(held.error.message.contains("unfinished tool actions"));
+    let record: serde_json::Value = serde_json::from_slice(&std::fs::read(
+        home.path()
+            .join("provider_continuations")
+            .join(format!("{}.json", uncertain.thread.id)),
+    )?)?;
+    assert_eq!(record["state"], "held");
+    assert_eq!(record["held_reason"], "preparation_unverified");
+    // Omitting the explicit picker flag cannot turn a cold Grok transition
+    // into an independent fork with a fresh allowance.
+    let cold_grok = started.thread.id.clone();
+    let cold_openai = fork.thread.id.clone();
+    timeout(DEFAULT_TIMEOUT, app.shutdown_gracefully()).await??;
+    drop(app);
+    let mut app = TestAppServer::builder()
+        .with_codex_home(home.path())
+        .with_env_overrides(&[("OPENAI_API_KEY", None), ("CODEX_API_KEY", None)])
+        .build_initialized()
+        .await?;
+    for (thread_id, model_provider, model, selected) in [
+        (cold_grok, "openai", "gpt-5.1-codex", None),
+        (
+            cold_openai,
+            "grok__personal",
+            "grok-build",
+            Some(snapshot.clone()),
+        ),
+    ] {
+        let request = app
+            .send_thread_fork_request(codex_app_server_protocol::ThreadForkParams {
+                thread_id,
+                model_provider: Some(model_provider.into()),
+                model: Some(model.into()),
+                config: selected.map(|selection| {
+                    std::collections::HashMap::from([(
+                        "inference_selection".into(),
+                        json!(selection),
+                    )])
+                }),
+                ..Default::default()
+            })
+            .await?;
+        let held: JSONRPCError = timeout(
+            DEFAULT_TIMEOUT,
+            app.read_stream_until_error_message(RequestId::Integer(request)),
+        )
+        .await??;
+        assert!(held.error.message.contains("live source"));
+    }
+    // An explicitly qualified per-thread selection must admit ordinary input
+    // while OpenAI remains the default. The false auth command guarantees no
+    // real inference and keeps account access qualification separate.
+    let admitted: ThreadStartResponse = app.start_thread(start(json!(snapshot.clone()))).await?;
+    let request = app
+        .send_turn_start_request(codex_app_server_protocol::TurnStartParams {
+            thread_id: admitted.thread.id.clone(),
+            input: vec![codex_app_server_protocol::UserInput::Text {
+                text: "Use the explicitly admitted account and model.".into(),
+                text_elements: Vec::new(),
+            }],
+            ..Default::default()
+        })
+        .await?;
+    let _: codex_app_server_protocol::TurnStartResponse =
+        timeout(DEFAULT_TIMEOUT, app.read_response(request)).await??;
+    let _ = timeout(
+        DEFAULT_TIMEOUT,
+        app.read_stream_until_notification_message("turn/completed"),
+    )
+    .await??;
+    let route_source: ThreadStartResponse =
+        app.start_thread(start(json!(snapshot.clone()))).await?;
+    let openai_route: codex_app_server_protocol::ThreadForkResponse = app
+        .request(|request_id| ClientRequest::ThreadFork {
+            request_id,
+            params: codex_app_server_protocol::ThreadForkParams {
+                thread_id: route_source.thread.id,
+                model_provider: Some("openai".into()),
+                model: Some("gpt-5.1-codex".into()),
+                ..Default::default()
+            },
+        })
+        .await?;
+    let original_config = std::fs::read_to_string(home.path().join("config.toml"))?;
+    let selected_default = toml::to_string(&std::collections::HashMap::from([(
+        "inference_selection",
+        snapshot.clone(),
+    )]))?;
+    std::fs::write(
+        home.path().join("config.toml"),
+        format!("{original_config}\n{selected_default}"),
+    )?;
+    let request = app
+        .send_turn_start_request(codex_app_server_protocol::TurnStartParams {
+            thread_id: openai_route.thread.id,
+            input: vec![codex_app_server_protocol::UserInput::Text {
+                text: "Use the native-selected OpenAI continuation route.".into(),
+                text_elements: Vec::new(),
+            }],
+            ..Default::default()
+        })
+        .await?;
+    let _: codex_app_server_protocol::TurnStartResponse =
+        timeout(DEFAULT_TIMEOUT, app.read_response(request)).await??;
+    std::fs::write(home.path().join("config.toml"), original_config)?;
+    let defaults: ModelListResponse = app
+        .request(|request_id| ClientRequest::ModelList {
+            request_id,
+            params: ModelListParams {
+                include_hidden: Some(true),
+                ..Default::default()
+            },
+        })
+        .await?;
+    assert!(
+        defaults
+            .data
+            .iter()
+            .any(|model| model.is_default && model.inference_selection.is_none())
+    );
+    catalog["selections"][0]["evidenceRevision"] = json!("changed-evidence");
+    std::fs::write(&source, serde_json::to_vec(&catalog)?)?;
+    let id = app
+        .send_thread_start_request(start(serde_json::to_value(snapshot)?))
+        .await?;
+    let _: JSONRPCError = timeout(
+        DEFAULT_TIMEOUT,
+        app.read_stream_until_error_message(RequestId::Integer(id)),
+    )
+    .await??;
+    Ok(())
+}
