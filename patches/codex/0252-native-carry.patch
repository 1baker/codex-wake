+                active_guards.contains(&pending_guard.id),
+                "pending source lease must not be overwritten"
+            );
+            if let Some(destination) = std::env::var_os("P233_CANONICAL_EVIDENCE_DIR") {
+                let destination =
+                    std::path::PathBuf::from(destination).join("native-tool-continuation");
+                std::fs::create_dir_all(&destination)?;
+                std::fs::write(
+                    destination.join("guard-ids.json"),
+                    serde_json::to_vec_pretty(&json!({
+                        "source":fixture.session_configured.thread_id, "successor":successor.thread_id,
+                        "originalGuard":current_guard.id,"pendingGuard":pending_guard.id,"activeGuards":active_guards
