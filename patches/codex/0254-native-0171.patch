+            "providerId":format!("grok__{account}"),"accountId":account,
+            "accountRevision":if revoked {"revoked-v2"} else {"account-v1"},
+            "modelId":format!("grok-{account}"),"catalogRevision":"catalog-v1","evidenceRevision":"synthetic-proof",
+            "selectionId":format!("choice-{account}"),"accountLabel":account,"displayName":account,"contextWindow":32000,
+            "readiness":if revoked {"unavailable"} else {"qualified"},
+            "reasons":if revoked {vec!["authentication_revoked"]} else {vec![]},
+            "capabilities":{"text":true,"streaming":true,"terminal":true,"file_editing":true,"mcp":true},
+            "disabledFeatures":["image_generation","web_search","reasoning_summary"],
+            "defaultForAccount":true,"source":"synthetic-native-revocation-fixture"
+        })
+    };
+    let catalog = |revoked: bool| -> anyhow::Result<serde_json::Value> {
+        let mut providers = serde_json::Map::new();
+        let mut selections = Vec::new();
+        for account in ["personal", "work"] {
+            let row = selection(account, revoked && account == "personal");
+            let mut command = serde_json::to_value(&auth_info)?;
+            command["command"] = json!(
+                auth_info
+                    .cwd
+                    .as_path()
+                    .join(&auth_info.command)
+                    .to_string_lossy()
+                    .into_owned()
+            );
+            command["args"] = json!([
+                "grok",
+                "auth",
+                "token",
+                account,
+                "--expected-account-revision",
+                row["accountRevision"]
+            ]);
+            command["refresh_interval_ms"] = json!(0);
+            providers.insert(
+                format!("grok__{account}"),
+                json!({"name":"Grok",
+                "wire_api":"grok","base_url":"https://cli-chat-proxy.grok.com/v1",
+                "auth":command,"requires_openai_auth":false,"supports_websockets":false}),
+            );
+            selections.push(row);
+        }
+        Ok(
+            json!({"schemaVersion":1,"sourceRevision":if revoked {"peer-source-changed"} else {"before"},
+            "selections":selections,"providers":providers}),
+        )
+    };
+    std::fs::write(&catalog_path, serde_json::to_vec(&catalog(false)?)?)?;
+    let calls = Arc::new(Mutex::new(
+        std::collections::BTreeMap::<String, usize>::new(),
+    ));
+    let observed = calls.clone();
+    Mock::given(method("POST")).and(path("/v1/chat/completions"))
+        .respond_with(move |request: &wiremock::Request| {
+            let body: serde_json::Value = request.body_json().unwrap();
+            let model = body["model"].as_str().unwrap().to_owned();
+            *observed.lock().unwrap().entry(model.clone()).or_default() += 1;
+            let expected = if model == "grok-personal" {"Bearer personal-bearer"} else {"Bearer work-bearer"};
+            assert_eq!(request.headers.get("authorization").unwrap(), expected);
+            let response = format!("data: {}\n\ndata: [DONE]\n\n", json!({"id":format!("{model}-response"),"model":model,
+                "choices":[{"index":0,"delta":{"content":"unrelated work completes"},"finish_reason":"stop"}],
+                "usage":{"prompt_tokens":10,"completion_tokens":5,"total_tokens":15}}));
+            ResponseTemplate::new(200).insert_header("content-type","text/event-stream").set_body_string(response)
+                .set_delay(Duration::from_secs(if model == "grok-personal" {60} else {4}))
+        }).mount(&server).await;
+    let mut grok = Vec::new();
+    for account in ["personal", "work"] {
+        let model = format!("grok-{account}");
+        let model_override = model.clone();
+        let snapshot = json!({"providerRevision":"fixture-provider","sourceRevision":"fixture-source",
+            "revision":format!("fixture-{account}"),"selection":selection(account,false)});
+        let auth_info = auth_info.clone();
+        let base_url = format!("{}/v1", server.uri());
+        let path = catalog_path.clone();
+        let cwd = state.path().to_string_lossy().into_owned();
+        let fixture = test_codex()
+            .with_model_info_override("gpt-5.4", move |info| {
+                info.slug = model_override.clone();
+                info.use_responses_lite = false;
+                info.supports_search_tool = false;
+                info.tool_mode = Some(codex_protocol::openai_models::ToolMode::Direct);
+            })
+            .with_config(move |config| {
+                config.model = Some(model.clone());
+                config.model_provider_id = format!("grok__{account}");
+                config.model_provider = ModelProviderInfo {
+                    name: "Grok".into(),
+                    wire_api: WireApi::Grok,
+                    base_url: Some(base_url),
+                    auth: Some(auth_info),
+                    ..Default::default()
+                };
+                config.inference_selection = Some(serde_json::from_value(snapshot).unwrap());
+                config.inference_catalog_command = Some(
+                    codex_protocol::inference_selection::InferenceCatalogCommand {
+                        command: "/bin/cat".into(),
+                        args: vec![path.to_string_lossy().into_owned()],
+                        cwd,
+                        timeout_ms: 1000,
+                    },
+                );
+                config.rollout_budget = Some(codex_core::config::RolloutBudgetConfig {
+                    enforce_limit: true,
+                    limit_budget: 80.0,
+                    reminder_at_context_start: true,
+                    reminder_at_remaining_tokens: vec![],
+                    sampling_token_weight: 1.0,
+                    prefill_token_weight: 1.0,
+                });
+                for feature in [
+                    Feature::CodeMode,
+                    Feature::CodeModeOnly,
+                    Feature::CodeModeToolSearch,
+                    Feature::CodeModeHost,
+                    Feature::ToolSearch,
+                    Feature::ToolSearchAlwaysDeferMcpTools,
+                ] {
+                    config.features.disable(feature).unwrap();
+                }
+            })
+            .build(&server)
+            .await?;
+        fixture
+            .codex
+            .start_or_steer_turn(TurnInputRequest::user_input(vec![UserInput::Text {
+                text: "Owned disposable account work".into(),
+                text_elements: vec![],
+            }]))
+            .await?;
+        let key = format!("grok-{account}");
+        tokio::time::timeout(Duration::from_secs(5), async {
+            while calls.lock().unwrap().get(&key).copied().unwrap_or(0) == 0 {
+                tokio::time::sleep(Duration::from_millis(10)).await;
+            }
+        })
+        .await
+        .context("Grok request must be accepted before revocation")?;
+        grok.push(fixture);
+    }
+    let openai_calls = Arc::new(AtomicUsize::new(0));
+    let seen = openai_calls.clone();
+    let body = responses::sse(vec![
+        responses::ev_response_created("openai-response"),
+        responses::ev_assistant_message("openai-final", "OpenAI remains active"),
+        responses::ev_completed_with_tokens("openai-response", 15),
+    ]);
+    Mock::given(method("POST"))
+        .and(path("/v1/responses"))
+        .respond_with(move |_: &wiremock::Request| {
+            seen.fetch_add(1, Ordering::SeqCst);
+            responses::sse_response(body.clone()).set_delay(Duration::from_secs(3))
+        })
+        .mount(&server)
+        .await;
+    let openai = test_codex().with_model("gpt-5.4").build(&server).await?;
+    openai
+        .codex
+        .start_or_steer_turn(TurnInputRequest::user_input(vec![UserInput::Text {
+            text: "Unrelated OpenAI work".into(),
+            text_elements: vec![],
+        }]))
+        .await?;
+    tokio::time::timeout(Duration::from_secs(5), async {
+        while openai_calls.load(Ordering::SeqCst) == 0 {
+            tokio::time::sleep(Duration::from_millis(10)).await;
+        }
+    })
+    .await?;
+    let temporary = catalog_path.with_extension("tmp");
+    std::fs::write(&temporary, serde_json::to_vec(&catalog(true)?)?)?;
+    std::fs::rename(temporary, &catalog_path)?;
+    tokio::time::timeout(
+        Duration::from_secs(4),
+        wait_for_event(&grok[0].codex, |event| {
+            matches!(event, EventMsg::TurnAborted(_))
+        }),
+    )
+    .await
+    .context("revoked owned Grok turn must be interrupted")?;
+    let denied = grok[0]
+        .codex
+        .start_or_steer_turn(TurnInputRequest::user_input(vec![UserInput::Text {
+            text: "Revoked account cannot start another turn".into(),
+            text_elements: vec![],
+        }]))
+        .await;
+    assert!(denied.is_err());
+    for peer in [&grok[1].codex, &openai.codex] {
+        let result = tokio::time::timeout(
+            Duration::from_secs(6),
+            wait_for_event(peer, |event| {
+                matches!(
+                    event,
+                    EventMsg::TurnComplete(_) | EventMsg::TurnAborted(_) | EventMsg::Error(_)
+                )
+            }),
+        )
+        .await?;
+        assert!(
+            matches!(&result,EventMsg::TurnComplete(done) if done.error.is_none()),
+            "unrelated peer interrupted: {result:?}"
+        );
+    }
+    assert_eq!(calls.lock().unwrap().get("grok-personal"), Some(&1));
+    assert_eq!(calls.lock().unwrap().get("grok-work"), Some(&1));
+    assert_eq!(openai_calls.load(Ordering::SeqCst), 1);
+    Ok(())
+}
