+                std::fs::write(
+                    destination.join("guard-ids.json"),
+                    serde_json::to_vec_pretty(&json!({
+                        "source":fixture.session_configured.thread_id, "successor":successor.thread_id,
+                        "originalGuard":current_guard.id,"pendingGuard":pending_guard.id,"activeGuards":active_guards
+                    }))?,
+                )?;
+            }
+        }
+        let event = wait_for_event(&successor.thread, |event| {
+            matches!(event, EventMsg::TurnComplete(_) | EventMsg::Error(_))
+        })
+        .await;
+        if expect_budget_hold {
+            assert!(
+                matches!(event, EventMsg::Error(error) if error.codex_error_info == Some(codex_protocol::protocol::CodexErrorInfo::SessionBudgetExceeded))
