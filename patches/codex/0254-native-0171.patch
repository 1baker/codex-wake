+            }
+            return ResponseTemplate::new(200).insert_header("content-type","text/event-stream").set_body_string(format!("{}{}data: [DONE]\n\n",chunk(json!({"content":"Native tools completed."}),json!(null)),chunk(json!({}),json!("stop"))));
+        }
+        assert!(n<3,"unexpected inference replay");
+        let (tool_name,args)=match n {
