index 0000000000000000000000000000000000000000..b6d3110c70e5e5b2ab3c97c9658eeab85002af33
--- /dev/null
+++ b/codex-rs/core/src/governor_guard.rs
@@ -0,0 +1,328 @@
+//! Native task-family cancellation. This is an enforcement lease, never an accounting owner.
+use codex_protocol::ThreadId;
+use std::collections::HashMap;
+use std::collections::HashSet;
+use std::sync::Mutex;
+use std::sync::OnceLock;
+use tokio_util::sync::CancellationToken;
+
+#[derive(Clone, Debug)]
+pub struct GovernorTaskGuard {
+    pub scope: ThreadId,
+    pub id: String,
+    pub token: CancellationToken,
+    pub durable_directory: Option<std::path::PathBuf>,
+}
+impl GovernorTaskGuard {
+    pub fn new(scope: ThreadId) -> Self {
+        Self {
+            scope,
+            id: uuid::Uuid::new_v4().to_string(),
+            token: CancellationToken::new(),
+            durable_directory: None,
+        }
+    }
+}
+#[derive(Clone, Debug, Default)]
+pub struct NextGovernorTurnGuards(pub Vec<GovernorTaskGuard>);
+#[derive(Clone, Debug, Default)]
+pub struct GovernorTurnGuards {
+    pub turn_id: String,
+    pub guards: Vec<GovernorTaskGuard>,
+}
+#[derive(Default)]
+struct Registry {
+    parents: HashMap<ThreadId, Option<ThreadId>>,
+    turn_owners: HashMap<String, ThreadId>,
+    roots: HashMap<(ThreadId, String), GovernorTaskGuard>,
+    turn_guards: HashMap<String, (ThreadId, Vec<GovernorTaskGuard>)>,
+}
+fn registry() -> &'static Mutex<Registry> {
+    static VALUE: OnceLock<Mutex<Registry>> = OnceLock::new();
+    VALUE.get_or_init(|| Mutex::new(Registry::default()))
+}
+pub(crate) fn register_thread(id: ThreadId, parent: Option<ThreadId>) {
+    registry()
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+        .parents
+        .insert(id, parent);
+}
+
+pub(crate) fn ancestors(thread: ThreadId) -> Vec<ThreadId> {
+    let values = registry()
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    let mut result = Vec::new();
+    let mut next = Some(thread);
+    while let Some(id) = next {
+        if result.contains(&id) || result.len() >= 128 {
+            break;
+        }
+        result.push(id);
+        next = values.parents.get(&id).copied().flatten();
+    }
+    result
+}
+pub(crate) fn register_turn(id: ThreadId, turn: &str, parent_turn: Option<&str>) {
+    let mut values = registry()
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    if let Some(parent) = parent_turn
+        .and_then(|turn| values.turn_owners.get(turn))
+        .copied()
+        && parent != id
+        && values.parents.get(&id).is_none_or(Option::is_none)
+    {
+        values.parents.insert(id, Some(parent));
+    }
+    values.turn_owners.insert(turn.to_owned(), id);
+}
+pub fn existing_guard(scope: ThreadId, root: &str) -> Option<GovernorTaskGuard> {
+    registry()
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+        .roots
+        .get(&(scope, root.to_owned()))
+        .cloned()
+}
+pub fn bind_root(root: &str, guard: &GovernorTaskGuard) -> Result<(), String> {
+    let mut values = registry()
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    let key = (guard.scope, root.to_owned());
+    if let Some(existing) = values.roots.get(&key) {
+        if existing.id != guard.id {
+            return Err("Governor task root already belongs to another lease token".into());
+        }
+        return Ok(());
+    }
+    if values.roots.len() >= 8192 {
+        return Err("Governor task root capacity reached".into());
+    }
+    values.roots.insert(key, guard.clone());
+    Ok(())
+}
+pub fn guards_for_root(thread: ThreadId, root: &str) -> Vec<GovernorTaskGuard> {
+    let values = registry()
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    let mut scopes = HashSet::new();
+    let mut next = Some(thread);
+    while let Some(id) = next {
+        if !scopes.insert(id) || scopes.len() > 128 {
+            break;
+        }
+        next = values.parents.get(&id).copied().flatten();
+    }
+    values
+        .roots
+        .iter()
+        .filter(|((scope, key), _)| key == root && scopes.contains(scope))
+        .map(|(_, guard)| guard.clone())
+        .collect()
+}
+pub fn combine(guards: impl IntoIterator<Item = GovernorTaskGuard>) -> Vec<GovernorTaskGuard> {
+    let mut seen = HashSet::new();
+    guards
+        .into_iter()
+        .filter(|guard| seen.insert(guard.id.clone()))
+        .collect()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn governor_guard_causal_root_inherits_to_late_child_but_preserves_operator_and_sibling() {
+        let parent = ThreadId::new();
+        let child = ThreadId::new();
+        let peer = ThreadId::new();
+        register_thread(parent, None);
+        register_thread(child, Some(parent));
+        register_thread(peer, None);
+        let root = uuid::Uuid::new_v4().to_string();
+        let guard = GovernorTaskGuard::new(parent);
+        bind_root(&root, &guard).unwrap();
+        guard.token.cancel();
+        assert!(
+            guards_for_root(child, &root)
+                .iter()
+                .any(|guard| guard.token.is_cancelled())
+        );
+        assert!(guards_for_root(parent, "fresh-operator-turn").is_empty());
+        assert!(guards_for_root(peer, &root).is_empty());
+        let child_limit = GovernorTaskGuard::new(child);
+        let other_child = ThreadId::new();
+        register_thread(other_child, Some(parent));
+        bind_root(&root, &child_limit).unwrap();
+        assert!(
+            !guards_for_root(other_child, &root)
+                .iter()
+                .any(|guard| guard.id == child_limit.id)
+        );
+    }
+}
+
+pub fn is_descendant(thread: ThreadId, scope: ThreadId) -> bool {
+    let values = registry()
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    let mut next = Some(thread);
+    let mut seen = HashSet::new();
+    while let Some(id) = next {
+        if id == scope {
+            return true;
+        }
+        if !seen.insert(id) || seen.len() > 128 {
+            return false;
+        }
+        next = values.parents.get(&id).copied().flatten();
+    }
+    false
+}
+
+#[derive(Clone, Debug, serde::Serialize, serde::Deserialize)]
+pub struct GovernorMembership {
+    pub root: ThreadId,
+    pub goal_id: Option<String>,
+    pub turn_ids: Vec<String>,
+}
+pub fn read_memberships(
+    directory: &std::path::Path,
+    id: ThreadId,
+) -> Result<Vec<GovernorMembership>, String> {
+    let path = directory.join(format!("{id}.members.json"));
+    match std::fs::symlink_metadata(&path) {
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => return Ok(Vec::new()),
+        Err(_) => return Err("Cannot inspect native task membership".into()),
+        Ok(meta)
+            if !meta.is_file() || meta.file_type().is_symlink() || meta.len() > 1024 * 1024 =>
+        {
+            return Err("Invalid native task membership".into());
+        }
+        Ok(_) => {}
+    }
+    let values: Vec<GovernorMembership> = serde_json::from_slice(
+        &std::fs::read(path).map_err(|_| "Cannot read native task membership")?,
+    )
+    .map_err(|_| "Malformed native task membership")?;
+    if values.len() > 128 {
+        return Err("Native task membership scope capacity reached".into());
+    }
+    Ok(values)
+}
+pub fn persist_membership(
+    directory: &std::path::Path,
+    id: ThreadId,
+    root: ThreadId,
+    turn: Option<&str>,
+    goal: Option<&str>,
+    replace_goal: bool,
+) -> Result<(), String> {
+    use std::io::Write;
+    let _serialized = registry()
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    let mut values = read_memberships(directory, id)?;
+    let index = match values.iter().position(|member| member.root == root) {
+        Some(index) => index,
+        None => {
+            if values.len() >= 128 {
+                return Err("Native task membership scope capacity reached".into());
+            }
+            values.push(GovernorMembership {
+                root,
+                goal_id: None,
+                turn_ids: Vec::new(),
+            });
+            values.len() - 1
+        }
+    };
+    let entry = &mut values[index];
+    let mut changed = false;
+    if replace_goal && entry.goal_id.as_deref() != goal {
+        entry.goal_id = goal.map(str::to_owned);
+        changed = true;
+    }
+    if let Some(turn) = turn
+        && !entry.turn_ids.iter().any(|id| id == turn)
+    {
+        if entry.turn_ids.len() >= 8192 {
+            return Err("Native task membership turn capacity reached".into());
+        }
+        entry.turn_ids.push(turn.to_owned());
+        changed = true;
+    }
+    if !changed {
+        return Ok(());
+    }
+    std::fs::create_dir_all(directory)
+        .map_err(|_| "Cannot create native task membership directory")?;
+    if std::fs::symlink_metadata(directory)
+        .map_err(|_| "Cannot inspect native task membership directory")?
+        .file_type()
+        .is_symlink()
+    {
+        return Err("Native task membership directory cannot be a symlink".into());
+    }
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::PermissionsExt;
+        std::fs::set_permissions(directory, std::fs::Permissions::from_mode(0o700))
+            .map_err(|_| "Cannot protect native task membership")?;
+    }
+    let mut file = tempfile::NamedTempFile::new_in(directory)
+        .map_err(|_| "Cannot stage native task membership")?;
+    serde_json::to_writer(file.as_file_mut(), &values)
+        .map_err(|_| "Cannot encode native task membership")?;
+    file.flush()
+        .map_err(|_| "Cannot flush native task membership")?;
+    file.as_file()
+        .sync_all()
+        .map_err(|_| "Cannot sync native task membership")?;
+    file.persist(directory.join(format!("{id}.members.json")))
+        .map_err(|_| "Cannot publish native task membership")?;
+    #[cfg(unix)]
+    std::fs::File::open(directory)
+        .and_then(|directory| directory.sync_all())
+        .map_err(|_| "Cannot sync native task membership directory")?;
+    Ok(())
+}
+
+pub(crate) fn remember_turn_guards(
+    thread: ThreadId,
+    turn: &str,
+    guards: Vec<GovernorTaskGuard>,
+) -> Result<(), String> {
+    let mut state = registry()
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    if !state.turn_guards.contains_key(turn) && state.turn_guards.len() >= 65536 {
+        return Err("Native governed turn capacity reached".into());
+    }
+    state.turn_guards.insert(turn.to_owned(), (thread, guards));
+    Ok(())
+}
+pub fn persist_goal_for_turn(thread: ThreadId, turn: &str, goal: &str) -> Result<(), String> {
+    let guards = registry()
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+        .turn_guards
+        .get(turn)
+        .filter(|(owner, _)| *owner == thread)
+        .map(|(_, guards)| guards.clone())
+        .unwrap_or_default();
+    for guard in &guards {
+        if let Some(directory) = &guard.durable_directory
+            && let Err(error) =
+                persist_membership(directory, thread, guard.scope, Some(turn), Some(goal), true)
+        {
+            for guard in &guards {
+                guard.token.cancel();
+            }
+            return Err(error);
+        }
+    }
+    Ok(())
+}
diff --git a/codex-rs/core/src/inference_selection.rs b/codex-rs/core/src/inference_selection.rs
new file mode 100644
index 0000000000000000000000000000000000000000..66f58fac5c832b643ee485114380d1d73dfcea40
--- /dev/null
+++ b/codex-rs/core/src/inference_selection.rs
@@ -0,0 +1,372 @@
+//! Native admission of independently qualified account/model selections.
+use codex_model_provider_info::ModelProviderInfo;
+use codex_model_provider_info::WireApi;
+use codex_protocol::inference_selection::InferenceCatalogCommand;
+use codex_protocol::inference_selection::InferenceSelection;
+use codex_protocol::inference_selection::InferenceSelectionSnapshot;
+use codex_protocol::openai_models::ModelInfo;
+use codex_protocol::openai_models::ModelPreset;
+use serde::Deserialize;
+use sha2::Digest;
+use sha2::Sha256;
+use std::collections::BTreeMap;
+use std::io;
+use std::process::Stdio;
+use std::time::Duration;
+use tokio::io::AsyncReadExt;
+
+const REQUIRED: [&str; 5] = ["text", "streaming", "terminal", "file_editing", "mcp"];
+
+#[derive(Default, Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct InferenceCatalog {
+    schema_version: u32,
+    source_revision: String,
+    #[serde(skip)]
+    command_revision: String,
+    selections: Vec<InferenceSelection>,
+    providers: BTreeMap<String, ModelProviderInfo>,
+}
+
+fn held() -> io::Error {
+    io::Error::new(
+        io::ErrorKind::InvalidData,
+        "inference selection unavailable, stale or unqualified",
+    )
+}
+fn revision(value: &impl serde::Serialize) -> io::Result<String> {
+    fn canonical(value: serde_json::Value) -> serde_json::Value {
+        match value {
+            serde_json::Value::Object(values) => {
+                let sorted: BTreeMap<_, _> = values
+                    .into_iter()
+                    .map(|(key, value)| (key, canonical(value)))
+                    .collect();
+                serde_json::Value::Object(sorted.into_iter().collect())
+            }
+            serde_json::Value::Array(values) => {
+                serde_json::Value::Array(values.into_iter().map(canonical).collect())
+            }
+            value => value,
+        }
+    }
+    let bytes = serde_json::to_vec(&canonical(serde_json::to_value(value).map_err(|_| held())?))
+        .map_err(|_| held())?;
+    Ok(format!("{:x}", Sha256::digest(bytes)))
+}
+
+/// Only this explicitly configured local command can supply a catalog. Its private
+/// auth command is a different protocol. Arbitrary diagnostics are discarded.
+pub async fn load_catalog(
+    command: Option<&InferenceCatalogCommand>,
+) -> io::Result<InferenceCatalog> {
+    let Some(command) = command else {
+        return Ok(InferenceCatalog::default());
+    };
+    if !std::path::Path::new(&command.command).is_absolute()
+        || !std::path::Path::new(&command.cwd).is_absolute()
+        || !(1..=5000).contains(&command.timeout_ms)
+    {
+        return Err(held());
+    }
+    let mut process = tokio::process::Command::new(&command.command);
+    process
+        .args(&command.args)
+        .current_dir(&command.cwd)
+        .env_clear();
+    for key in [
+        "HOME",
+        "PATH",
+        "XDG_CONFIG_HOME",
+        "XDG_STATE_HOME",
+        "XDG_DATA_HOME",
+    ] {
+        if let Some(value) = std::env::var_os(key) {
+            process.env(key, value);
+        }
+    }
+    let mut child = process
+        .stdin(Stdio::null())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::null())
+        .kill_on_drop(true)
+        .spawn()
+        .map_err(|_| held())?;
+    let stdout = child.stdout.take().ok_or_else(held)?;
+    let work = async {
+        let mut bytes = Vec::new();
+        stdout
+            .take(1024 * 1024 + 1)
+            .read_to_end(&mut bytes)
+            .await
+            .map_err(|_| held())?;
+        if bytes.len() > 1024 * 1024 {
+            return Err(held());
+        }
+        if !child.wait().await.map_err(|_| held())?.success() {
+            return Err(held());
+        }
+        let mut catalog: InferenceCatalog = serde_json::from_slice(&bytes).map_err(|_| held())?;
+        if catalog.schema_version != 1
+            || catalog.selections.len() > 200
+            || catalog.source_revision.is_empty()
+        {
+            return Err(held());
+        }
+        catalog.command_revision = revision(command)?;
+        Ok(catalog)
+    };
+    tokio::time::timeout(Duration::from_millis(command.timeout_ms), work)
+        .await
+        .map_err(|_| held())?
+}
+
+pub fn snapshots(catalog: &InferenceCatalog) -> io::Result<Vec<InferenceSelectionSnapshot>> {
+    let mut seen = std::collections::HashSet::new();
+    catalog
+        .selections
+        .iter()
+        .map(|selection| {
+            if !seen.insert(&selection.selection_id)
+                || selection.provider_id != format!("grok__{}", selection.account_id)
+                || selection.account_id.len() > 64
+                || selection.account_id.is_empty()
+                || !selection
+                    .account_id
+                    .bytes()
+                    .all(|c| c.is_ascii_lowercase() || c.is_ascii_digit() || c == b'_' || c == b'-')
+                || [
+                    &selection.account_label,
+                    &selection.display_name,
+                    &selection.model_id,
+                ]
+                .iter()
+                .any(|s| s.is_empty() || s.len() > 256 || s.chars().any(char::is_control))
+                || selection.account_label.is_empty()
+                || selection.model_id.is_empty()
+                || !(8192..=2_000_000).contains(&selection.context_window)
+            {
+                return Err(held());
+            }
+            let provider = catalog
+                .providers
+                .get(&selection.provider_id)
+                .ok_or_else(held)?;
+            provider.validate().map_err(|_| held())?;
+            if provider.wire_api != WireApi::Grok
+                || provider.base_url.as_ref().map(|url| url.as_str())
+                    != Some("https://cli-chat-proxy.grok.com/v1")
+                || provider
+                    .env_http_headers
+                    .as_ref()
+                    .is_some_and(|headers| !headers.is_empty())
+                || provider
+                    .http_headers
+                    .as_ref()
+                    .is_some_and(|headers| !headers.is_empty())
+                || provider
+                    .query_params
+                    .as_ref()
+                    .is_some_and(|params| !params.is_empty())
+                || !matches!(
+                    selection.readiness.as_str(),
+                    "qualified" | "unverified" | "unavailable" | "stale"
+                )
+            {
+                return Err(held());
+            }
+            let auth = provider.auth.as_ref().ok_or_else(held)?;
+            let tail: Vec<_> = auth
+                .args
+                .iter()
+                .rev()
+                .take(6)
+                .map(|arg| arg.as_str())
+                .collect();
+            if tail
+                != [
+                    selection.account_revision.as_str(),
+                    "--expected-account-revision",
+                    selection.account_id.as_str(),
+                    "token",
+                    "auth",
+                    "grok",
+                ]
+                || auth.refresh_interval_ms != 0
+                || !std::path::Path::new(&auth.command).is_absolute()
+                || !auth.cwd.as_path().is_absolute()
+            {
+                return Err(held());
+            }
+            // Public readiness is an upper bound: a source cannot advertise ready
+            // while omitting a required capability or independent evidence.
+            let mut normalized = selection.clone();
+            if normalized.readiness == "qualified" {
+                let missing: Vec<_> = REQUIRED
+                    .iter()
+                    .filter(|key| normalized.capabilities.get(**key) != Some(&true))
+                    .map(|key| format!("required_capability_missing:{key}"))
+                    .collect();
+                if !missing.is_empty() {
+                    normalized.readiness = "unavailable".into();
+                    normalized.reasons = missing;
+                } else if normalized.evidence_revision.is_empty()
+                    || normalized.evidence_revision == "unverified"
+                {
+                    normalized.readiness = "unverified".into();
+                    normalized.reasons = vec!["entitlement_and_inference_unverified".into()];
+                }
+            }
+            let provider_revision = revision(provider)?;
+            let source_revision = revision(&(&catalog.source_revision, &catalog.command_revision))?;
+            let revision = revision(&(&normalized, &provider_revision, &source_revision))?;
+            Ok(InferenceSelectionSnapshot {
+                selection: normalized,
+                provider_revision,
+                source_revision,
+                revision,
+            })
+        })
+        .collect()
+}
+
+/// A semantic account generation event is separate from unrelated catalog
+/// updates and from unconfirmed credential-file absence.
+pub(crate) fn account_revoked(
+    catalog: &InferenceCatalog,
+    accepted: &InferenceSelectionSnapshot,
+) -> io::Result<bool> {
+    let provider = catalog
+        .providers
+        .get(&accepted.selection.provider_id)
+        .ok_or_else(held)?;
+    provider.validate().map_err(|_| held())?;
+    if provider.wire_api != WireApi::Grok
+        || provider.base_url.as_deref() != Some("https://cli-chat-proxy.grok.com/v1")
+    {
+        return Err(held());
+    }
+    let auth = provider.auth.as_ref().ok_or_else(held)?;
+    let tail: Vec<_> = auth
+        .args
+        .iter()
+        .rev()
+        .take(6)
+        .map(|argument| argument.as_str())
+        .collect();
+    if tail.len() != 6
+        || tail[1..]
+            != [
+                "--expected-account-revision",
+                accepted.selection.account_id.as_str(),
+                "token",
+                "auth",
+                "grok",
+            ]
+        || auth.refresh_interval_ms != 0
+        || !std::path::Path::new(&auth.command).is_absolute()
+    {
+        return Err(held());
+    }
+    if tail[0] != accepted.selection.account_revision.as_str() {
+        return Ok(true);
+    }
+    Ok(catalog.selections.iter().any(|row| {
+        row.provider_id == accepted.selection.provider_id
+            && row.account_id == accepted.selection.account_id
+            && row
+                .reasons
+                .iter()
+                .any(|reason| reason == "authentication_revoked")
+    }))
+}
+
+pub fn resolve(
+    catalog: &InferenceCatalog,
+    requested: Option<&InferenceSelectionSnapshot>,
+) -> io::Result<Option<(InferenceSelectionSnapshot, ModelProviderInfo)>> {
+    let Some(requested) = requested else {
+        return Ok(None);
+    };
+    let current = snapshots(catalog)?
+        .into_iter()
+        .find(|s| s == requested)
+        .ok_or_else(held)?;
+    if current.selection.readiness != "qualified"
+        || current.selection.evidence_revision == "unverified"
+        || !REQUIRED
+            .iter()
+            .all(|key| current.selection.capabilities.get(*key) == Some(&true))
+    {
+        return Err(held());
+    }
+    let provider = catalog
+        .providers
+        .get(&current.selection.provider_id)
+        .ok_or_else(held)?
+        .clone();
+    Ok(Some((current, provider)))
+}
+
+pub fn model_info(snapshot: &InferenceSelectionSnapshot) -> io::Result<ModelInfo> {
+    let mut info = codex_models_manager::bundled_models_response()
+        .map_err(|_| held())?
+        .models
+        .into_iter()
+        .next()
+        .ok_or_else(held)?;
+    info.shell_type = codex_protocol::openai_models::ConfigShellToolType::UnifiedExec;
+    info.apply_patch_tool_type = Some(codex_protocol::openai_models::ApplyPatchToolType::Freeform);
+    info.tool_mode = Some(codex_protocol::openai_models::ToolMode::Direct);
+    info.slug = snapshot.selection.model_id.clone();
+    info.display_name = format!(
+        "{} · {}",
+        snapshot.selection.account_label, snapshot.selection.display_name
+    );
+    info.description = Some(format!(
+        "{}: {}",
+        snapshot.selection.readiness,
+        snapshot.selection.reasons.join(", ")
+    ));
+    info.inference_selection = Some(snapshot.clone());
+    info.context_window = Some(snapshot.selection.context_window);
+    info.max_context_window = info.context_window;
+    info.auto_compact_token_limit = None;
+    info.default_reasoning_level = None;
+    info.supported_reasoning_levels.clear();
+    info.guardian = None;
+    info.supports_image_detail_original = false;
+    info.supports_reasoning_summary_parameter = false;
+    info.supports_reasoning_effort_updates = false;
+    info.supports_search_tool = false;
+    info.supports_experimental_context = false;
+    info.use_responses_lite = false;
+    info.support_verbosity = false;
+    info.input_modalities = vec![codex_protocol::openai_models::InputModality::Text];
+    info.service_tiers.clear();
+    info.additional_speed_tiers.clear();
+    info.default_service_tier = None;
+    info.available_access_programs = None;
+    info.upgrade = None;
+    info.availability_nux = None;
+    info.model_specialty = None;
+    info.auto_review_model_override = None;
+    info.experimental_supported_tools.clear();
+    Ok(info)
+}
+
+pub async fn list_models(
+    command: Option<&InferenceCatalogCommand>,
+) -> io::Result<Vec<ModelPreset>> {
+    let catalog = load_catalog(command).await?;
+    snapshots(&catalog)?
+        .iter()
+        .map(|snapshot| {
+            let mut preset: ModelPreset = model_info(snapshot)?.into();
+            preset.id = snapshot.selection.selection_id.clone();
+            preset.is_default = false; // Per-account preference never replaces the OpenAI default.
+            preset.show_in_picker = true;
+            Ok(preset)
+        })
+        .collect()
+}
