+            1=>("apply_patch",json!({"input":"*** Begin Patch\n*** Add File: grok-native.txt\n+native patch\n*** End Patch\n"})),
+            _=>("echo",json!({"message":"hello-from-grok"})),
+        };
+        let function=body["tools"].as_array().unwrap().iter().map(|t| &t["function"]).find(|f| {
+            let description=f["description"].as_str().unwrap_or_default();
+            if n==2 {description.starts_with("mcp__grok_fixture.echo:")} else {description.starts_with(&format!("{tool_name}:")) || description.starts_with(&format!("functions.{tool_name}:"))}
+        }).expect("existing native tool is advertised");
+        let args=args.to_string();let split=args.len()/2;
+        let first=json!({"tool_calls":[{"index":0,"id":format!("grok-native-{n}"),"type":"function","function":{"name":function["name"],"arguments":&args[..split]}}]});
+        let second=json!({"tool_calls":[{"index":0,"function":{"arguments":&args[split..]}}]});
+        ResponseTemplate::new(200).insert_header("content-type","text/event-stream").set_body_string(format!("{}{}{}{}data: [DONE]\n\n",chunk(json!({"content":"Working."}),json!(null)),chunk(first,json!(null)),chunk(second,json!(null)),chunk(json!({}),json!("tool_calls"))))
