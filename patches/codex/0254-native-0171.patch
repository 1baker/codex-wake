+// Usage belongs to the coding harness, independently of Governor enrollment.
+#[tokio::test]
+async fn wake_usage_footer_is_visible_without_governor_or_custom_configuration() {
+    let (mut widget, _events, _operations) =
+        crate::chatwidget::tests::helpers::make_chatwidget_manual(Some("grok-4.7")).await;
+    widget.thread_id = Some(ThreadId::new());
+    widget.local_settings.tui.status_line = None;
+    widget.config.model_provider.wire_api = codex_model_provider_info::WireApi::Grok;
+    let usage = TokenUsage {
+        input_tokens: 64_079,
+        cached_input_tokens: 52_352,
+        cache_write_input_tokens: 0,
+        output_tokens: 281,
+        reasoning_output_tokens: 119,
+        total_tokens: 64_360,
+    };
+    widget.set_token_info(Some(TokenUsageInfo {
+        total_token_usage: usage.clone(),
+        last_token_usage: usage,
+        model_context_window: Some(2_000_000),
+    }));
+    widget.refresh_status_line();
+    let frame = render_frame(&widget, 100);
+    assert!(contains_text(&frame, "Wake"));
+    assert!(contains_text(&frame, "grok-4.7"));
+    assert!(contains_text(&frame, "64.1K in"));
