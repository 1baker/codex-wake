+#[tokio::test]
+async fn workspace_pause_and_upgrade_cannot_take_each_others_custody() {
+    use crate::outgoing_message::ConnectionId;
+    let admission = TurnAdmission::default();
+    let owner = ConnectionId(167);
+    let pause = admission.pause().await.expect("workspace owns admission");
+    assert!(
+        admission
+            .prepare_upgrade(owner, "upgrade-167")
+            .await
+            .is_err()
+    );
+    admission.release_upgrade(owner);
+    assert!(
+        admission.admit().is_err(),
+        "upgrade release cannot release workspace pause"
+    );
+    drop(pause);
+    admission
+        .prepare_upgrade(owner, "upgrade-167")
+        .await
+        .expect("upgrade owns admission");
+    assert!(admission.pause().await.is_err());
+    assert!(
+        admission.admit().is_err(),
+        "failed pause cannot release upgrade"
+    );
+    drop(
+        admission
+            .admit_steer(owner)
+            .expect("upgrade owner can checkpoint"),
+    );
+    admission.release_upgrade(owner);
+    drop(admission.admit().expect("owner release restores admission"));
+}
