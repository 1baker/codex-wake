+/// Provider switching uses the ordinary worker tool and existing loopback transports.
+#[cfg(unix)]
+#[test_case(Some(REQUESTED_MODEL), false; "explicit OpenAI override")]
+#[test_case(None, false; "inherits pinned Grok selection")]
+#[test_case(Some(REQUESTED_MODEL), true; "v2 plaintext OpenAI task")]
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn grok_parent_can_select_openai_worker(
+    requested_model: Option<&'static str>,
+    multi_agent_v2: bool,
+) -> Result<()> {
+    use codex_model_provider_info::ModelProviderInfo;
+    use codex_model_provider_info::WireApi;
+    use std::sync::atomic::AtomicUsize;
+    use std::sync::atomic::Ordering;
+    use wiremock::Mock;
+    use wiremock::ResponseTemplate;
+    use wiremock::matchers::method;
+    use wiremock::matchers::path;
+    let server = start_mock_server().await;
+    let auth = crate::suite::client::ProviderAuthCommandFixture::new(&[
+        "synthetic-grok-session",
+        "synthetic-grok-session",
+    ])?;
+    let auth_info = auth.auth();
+    let step = Arc::new(AtomicUsize::new(0));
+    let calls = step.clone();
+    Mock::given(method("POST")).and(path("/v1/chat/completions"))
+        .respond_with(move |request: &wiremock::Request| {
+            let body: serde_json::Value = request.body_json().unwrap();
+            let n = calls.fetch_add(1, Ordering::SeqCst);
+            let delta = if n == 0 {
+                let function = body["tools"].as_array().unwrap().iter()
+                    .map(|tool| &tool["function"])
+                    .find(|function| function["description"].as_str().unwrap_or_default().contains("spawn_agent:"))
+                    .expect("ordinary worker tool advertised");
+                let mut arguments = json!({"message":CHILD_PROMPT,"model":requested_model});
+                if multi_agent_v2 {
+                    arguments["task_name"] = json!("openai_probe");
+                    arguments["fork_turns"] = json!("none");
+                }
+                json!({"tool_calls": [{"index": 0, "id": SPAWN_CALL_ID, "type": "function",
+                    "function": {"name": function["name"], "arguments": arguments.to_string()}}]})
+            } else { json!({"content": "parent done"}) };
+            let chunk = |delta, finish: serde_json::Value| {
+                let mut value = json!({"id":format!("grok-parent-{n}"), "model":"grok-parent-build",
+                    "choices":[{"index":0,"delta":delta,"finish_reason":finish}]});
+                if !finish.is_null() {
+                    value["usage"] = json!({"prompt_tokens":32,"completion_tokens":9,"total_tokens":135,
+                        "prompt_tokens_details":{"cached_tokens":6},
+                        "completion_tokens_details":{"reasoning_tokens":94}});
+                }
+                format!("data: {value}\n\n")
+            };
+            ResponseTemplate::new(200).insert_header("content-type", "text/event-stream")
+                .set_body_string(format!("{}{}data: [DONE]\n\n", chunk(delta, json!(null)),
+                    chunk(json!({}), json!(if n == 0 { "tool_calls" } else { "stop" }))))
+        }).mount(&server).await;
+    let _child = mount_sse_once_match(
+        &server,
+        |request: &wiremock::Request| body_contains(request, CHILD_PROMPT),
+        sse(vec![
+            ev_response_created("openai-child"),
+            ev_assistant_message("child-message", "child done"),
+            ev_completed_with_tokens("openai-child", 15),
+        ]),
+    )
+    .await;
+    let base_url = format!("{}/v1", server.uri());
+    // Core's admitted selection is synthetic here; only provider transport is mocked.
+    let accepted: codex_protocol::inference_selection::InferenceSelectionSnapshot =
+        serde_json::from_value(json!({
+            "selection": {"providerId":"grok__personal", "accountId":"personal", "accountRevision":"account-v1",
+                "modelId":"grok-parent", "catalogRevision":"catalog-v1", "evidenceRevision":"coding-v1",
+                "selectionId":"parent-selection-v1", "accountLabel":"Personal Grok", "displayName":"Grok parent",
+                "contextWindow":32000, "readiness":"qualified", "reasons":[],
+                "capabilities":{"text":true,"streaming":true,"terminal":true,"file_editing":true,"mcp":true},
+                "disabledFeatures":[], "defaultForAccount":false, "source":"synthetic-admitted-selection"},
+            "providerRevision":"fixture-provider", "sourceRevision":"fixture-source", "revision":"fixture-selection"
+        }))?;
+    let inherited = accepted.clone();
+    let mut builder = test_codex()
+        .with_model_info_override(INHERITED_MODEL, |info| {
+            info.slug = "grok-parent".into();
+            info.use_responses_lite = false;
+            info.supports_search_tool = false;
+            info.tool_mode = Some(codex_protocol::openai_models::ToolMode::Direct);
+        })
+        .with_config(move |config| {
+            config.features.enable(Feature::Collab).unwrap();
+            if multi_agent_v2 {
+                config.features.enable(Feature::MultiAgentV2).unwrap();
+            }
+            for feature in [
+                Feature::CodeMode,
+                Feature::CodeModeOnly,
+                Feature::CodeModeToolSearch,
+                Feature::CodeModeHost,
+                Feature::ToolSearch,
+                Feature::ToolSearchAlwaysDeferMcpTools,
+            ] {
+                config.features.disable(feature).unwrap();
+            }
+            config.model = Some("grok-parent".into());
+            config.inference_selection = Some(accepted);
+            config
+                .model_providers
+                .insert("openai".into(), config.model_provider.clone());
+            config.model_provider_id = "grok__personal".into();
+            config.model_provider = ModelProviderInfo {
+                name: "Grok fixture".into(),
+                wire_api: WireApi::Grok,
+                base_url: Some(base_url),
+                auth: Some(auth_info),
+                ..Default::default()
+            };
+        });
+    let test = builder.build_with_auto_env(&server).await?;
+    test.codex
+        .start_or_steer_turn(TurnInputRequest::user_input(vec![UserInput::Text {
+            text: TURN_1_PROMPT.into(),
+            text_elements: Vec::new(),
+        }]))
+        .await?;
+    let provider_model_warning = std::sync::atomic::AtomicBool::new(false);
+    let completed = wait_for_event(&test.codex, |event| {
+        assert!(
+            !matches!(event, EventMsg::ModelReroute(_)),
+            "Grok model labels do not attest OpenAI cyber moderation"
+        );
+        if let EventMsg::Warning(warning) = event {
+            assert!(!warning.message.contains("account was flagged"));
+            if warning.message.contains("Grok reported model") {
+                provider_model_warning.store(true, std::sync::atomic::Ordering::Relaxed);
+            }
+        }
+        matches!(event, EventMsg::TurnComplete(_) | EventMsg::Error(_))
+    })
+    .await;
+    assert!(provider_model_warning.load(std::sync::atomic::Ordering::Relaxed));
+    if let EventMsg::Error(error) = completed {
+        anyhow::bail!("Grok parent failed before delegation: {}", error.message);
+    }
+    test.codex.flush_rollout().await?;
+    let rollout =
+        tokio::fs::read_to_string(test.codex.rollout_path().expect("parent rollout")).await?;
+    let records: Vec<serde_json::Value> = rollout
+        .lines()
+        .map(serde_json::from_str)
+        .collect::<Result<_, _>>()?;
+    let expected_selection = serde_json::to_value(&inherited)?;
+    let completions: Vec<_> = records
+        .iter()
+        .filter(|record| {
+            record["type"] == "event_msg" && record["payload"]["type"] == "raw_response_completed"
+        })
+        .collect();
+    assert!(
+        !completions.is_empty(),
+        "completed Grok responses are durable"
+    );
+    assert!(
+        completions
+            .iter()
+            .all(|record| record["payload"]["inference_selection"] == expected_selection),
+        "canonical response observations retain the accepted provider/account/model selection"
+    );
+    let usage_records: Vec<_> = records
+        .iter()
+        .filter(|record| record["type"] == "token_usage_record")
+        .collect();
+    assert!(
+        !usage_records.is_empty(),
+        "reported provider usage is durable"
+    );
+    assert!(
+        usage_records
+            .iter()
+            .all(|record| record["payload"]["inference_selection"] == expected_selection),
+        "numeric usage retains the accepted selection"
+    );
+    for record in &usage_records {
+        let usage = &record["payload"]["usage"];
+        assert_eq!(usage["input_tokens"], 32);
+        assert_eq!(usage["cached_input_tokens"], 6);
+        assert_eq!(usage["output_tokens"], 103);
+        assert_eq!(usage["reasoning_output_tokens"], 94);
+        assert_eq!(usage["total_tokens"], 135);
+    }
+    let requests = server.received_requests().await.unwrap_or_default();
+    let tool_results: Vec<_> = requests
+        .iter()
+        .filter_map(|request| request.body_json::<serde_json::Value>().ok())
+        .filter_map(|body| body.get("messages").cloned())
+        .filter_map(|messages| messages.as_array().cloned())
+        .flatten()
+        .filter(|message| message["role"] == "tool")
+        .collect();
+    let child_id = wait_for_spawned_thread_id(&test).await.map_err(|error| {
+        anyhow::anyhow!(
+            "{error}; parent tool results: {tool_results:?}; Grok requests: {}",
+            step.load(Ordering::SeqCst)
+        )
+    })?;
+    let child = test
+        .thread_manager
+        .get_thread(ThreadId::from_string(&child_id)?)
+        .await?;
+    let snapshot = child.config_snapshot().await;
+    assert_eq!(
+        snapshot.model_provider_id,
+        if requested_model.is_some() {
+            "openai"
+        } else {
+            "grok__personal"
+        }
+    );
+    assert_eq!(snapshot.model, requested_model.unwrap_or("grok-parent"));
+    assert_eq!(
+        child.config().await.inference_selection,
+        if requested_model.is_some() {
+            None
+        } else {
+            Some(inherited)
+        }
+    );
+    assert_eq!(
+        snapshot.parent_thread_id,
+        Some(test.session_configured.thread_id)
+    );
+    let completed = wait_for_event(&child, |event| {
+        matches!(event, EventMsg::TurnComplete(_) | EventMsg::Error(_))
+    })
+    .await;
+    match completed {
+        EventMsg::TurnComplete(completion) => {
+            assert!(
+                completion.error.is_none(),
+                "child failed: {:?}",
+                completion.error
+            );
+            assert!(
+                completion.last_agent_message.is_some(),
+                "child completed inference"
+            );
+        }
+        EventMsg::Error(error) => anyhow::bail!("Worker failed: {}", error.message),
+        _ => unreachable!(),
+    }
+    if multi_agent_v2 {
+        let requests = server.received_requests().await.unwrap_or_default();
+        let child_body = requests
+            .iter()
+            .filter_map(|request| request.body_json::<serde_json::Value>().ok())
+            .find(|body| {
+                body["input"]
+                    .as_array()
+                    .is_some_and(|items| items.iter().any(|item| item["type"] == "agent_message"))
+            })
+            .expect("actual OpenAI worker request");
+        let message = child_body["input"]
+            .as_array()
+            .unwrap()
+            .iter()
+            .find(|item| item["type"] == "agent_message")
+            .unwrap();
+        assert!(message["content"].as_array().unwrap().iter().any(|item| item["type"] == "input_text" && item["text"] == format!("Message Type: NEW_TASK\nTask name: /root/openai_probe\nSender: /root\nPayload:\n{CHILD_PROMPT}")),
+            "Grok task text must reach OpenAI as plaintext, never opaque ciphertext");
+        assert!(
+            message["content"]
+                .as_array()
+                .unwrap()
+                .iter()
+                .all(|item| item["type"] != "encrypted_content")
+        );
+    }
+    if let Some(destination) = std::env::var_os("P233_CANONICAL_EVIDENCE_DIR") {
+        // Export only this disposable test's canonical histories for Wake consumer acceptance.
+        child.flush_rollout().await?;
+        test.codex.flush_rollout().await?;
+        let destination = std::path::PathBuf::from(destination).join(if multi_agent_v2 {
+            "openai-v2-plaintext"
+        } else if requested_model.is_some() {
+            "openai-override"
+        } else {
+            "grok-inherited"
+        });
+        std::fs::create_dir_all(destination.join("sessions"))?;
+        std::fs::copy(
+            test.codex.rollout_path().expect("root rollout"),
+            destination.join("sessions/root.jsonl"),
+        )?;
+        std::fs::copy(
+            child.rollout_path().expect("child rollout"),
+            destination.join("sessions/child.jsonl"),
+        )?;
+        std::fs::write(
+            destination.join("root-thread-id"),
+            test.session_configured.thread_id.to_string(),
+        )?;
+    }
+    Ok(())
+}
