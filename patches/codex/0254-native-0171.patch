+                json!({"type":"message","role":"user","content":[{"type":"input_text","text":"Preserve the uncertain action; never replay it."}]}),
+                json!({"type":"function_call","name":"exec_command","arguments":"{}","call_id":"uncertain-effect"}),
+            ],
+        },
+    }).await?;
+    let held = app
+        .send_thread_fork_request(codex_app_server_protocol::ThreadForkParams {
+            thread_id: uncertain.thread.id.clone(),
+            model_provider: Some("openai".into()),
+            model: Some("gpt-5.1-codex".into()),
+            ..Default::default()
+        })
+        .await?;
+    let held: JSONRPCError = timeout(
+        DEFAULT_TIMEOUT,
+        app.read_stream_until_error_message(RequestId::Integer(held)),
+    )
+    .await??;
+    assert!(held.error.message.contains("unfinished tool actions"));
+    let record: serde_json::Value = serde_json::from_slice(&std::fs::read(
+        home.path()
+            .join("provider_continuations")
+            .join(format!("{}.json", uncertain.thread.id)),
+    )?)?;
+    assert_eq!(record["state"], "held");
+    assert_eq!(record["held_reason"], "preparation_unverified");
+    // Omitting the explicit picker flag cannot turn a cold Grok transition
+    // into an independent fork with a fresh allowance.
+    let cold_grok = started.thread.id.clone();
+    let cold_openai = fork.thread.id.clone();
+    timeout(DEFAULT_TIMEOUT, app.shutdown_gracefully()).await??;
+    drop(app);
+    let mut app = TestAppServer::builder()
+        .with_codex_home(home.path())
+        .with_env_overrides(&[("OPENAI_API_KEY", None), ("CODEX_API_KEY", None)])
+        .build_initialized()
+        .await?;
+    for (thread_id, model_provider, model, selected) in [
+        (cold_grok, "openai", "gpt-5.1-codex", None),
+        (
+            cold_openai,
+            "grok__personal",
+            "grok-build",
+            Some(snapshot.clone()),
+        ),
+    ] {
+        let request = app
+            .send_thread_fork_request(codex_app_server_protocol::ThreadForkParams {
+                thread_id,
+                model_provider: Some(model_provider.into()),
+                model: Some(model.into()),
+                config: selected.map(|selection| {
+                    std::collections::HashMap::from([(
+                        "inference_selection".into(),
+                        json!(selection),
+                    )])
+                }),
+                ..Default::default()
+            })
+            .await?;
+        let held: JSONRPCError = timeout(
+            DEFAULT_TIMEOUT,
+            app.read_stream_until_error_message(RequestId::Integer(request)),
+        )
+        .await??;
+        assert!(held.error.message.contains("live source"));
+    }
+    // An explicitly qualified per-thread selection must admit ordinary input
+    // while OpenAI remains the default. The false auth command guarantees no
+    // real inference and keeps account access qualification separate.
+    let admitted: ThreadStartResponse = app.start_thread(start(json!(snapshot.clone()))).await?;
+    let request = app
+        .send_turn_start_request(codex_app_server_protocol::TurnStartParams {
+            thread_id: admitted.thread.id.clone(),
+            input: vec![codex_app_server_protocol::UserInput::Text {
+                text: "Use the explicitly admitted account and model.".into(),
+                text_elements: Vec::new(),
+            }],
+            ..Default::default()
+        })
+        .await?;
+    let _: codex_app_server_protocol::TurnStartResponse =
+        timeout(DEFAULT_TIMEOUT, app.read_response(request)).await??;
+    let _ = timeout(
+        DEFAULT_TIMEOUT,
+        app.read_stream_until_notification_message("turn/completed"),
+    )
+    .await??;
+    let route_source: ThreadStartResponse =
+        app.start_thread(start(json!(snapshot.clone()))).await?;
+    let openai_route: codex_app_server_protocol::ThreadForkResponse = app
+        .request(|request_id| ClientRequest::ThreadFork {
+            request_id,
+            params: codex_app_server_protocol::ThreadForkParams {
+                thread_id: route_source.thread.id,
+                model_provider: Some("openai".into()),
+                model: Some("gpt-5.1-codex".into()),
+                ..Default::default()
+            },
+        })
+        .await?;
+    let original_config = std::fs::read_to_string(home.path().join("config.toml"))?;
+    let selected_default = toml::to_string(&std::collections::HashMap::from([(
+        "inference_selection",
+        snapshot.clone(),
+    )]))?;
+    std::fs::write(
+        home.path().join("config.toml"),
+        format!("{original_config}\n{selected_default}"),
+    )?;
+    let request = app
+        .send_turn_start_request(codex_app_server_protocol::TurnStartParams {
+            thread_id: openai_route.thread.id,
+            input: vec![codex_app_server_protocol::UserInput::Text {
+                text: "Use the native-selected OpenAI continuation route.".into(),
+                text_elements: Vec::new(),
+            }],
+            ..Default::default()
+        })
+        .await?;
+    let _: codex_app_server_protocol::TurnStartResponse =
+        timeout(DEFAULT_TIMEOUT, app.read_response(request)).await??;
+    std::fs::write(home.path().join("config.toml"), original_config)?;
+    let defaults: ModelListResponse = app
+        .request(|request_id| ClientRequest::ModelList {
+            request_id,
+            params: ModelListParams {
+                include_hidden: Some(true),
+                ..Default::default()
+            },
+        })
+        .await?;
+    assert!(
+        defaults
+            .data
+            .iter()
+            .any(|model| model.is_default && model.inference_selection.is_none())
+    );
+    catalog["selections"][0]["evidenceRevision"] = json!("changed-evidence");
+    std::fs::write(&source, serde_json::to_vec(&catalog)?)?;
+    let id = app
+        .send_thread_start_request(start(serde_json::to_value(snapshot)?))
+        .await?;
+    let _: JSONRPCError = timeout(
+        DEFAULT_TIMEOUT,
+        app.read_stream_until_error_message(RequestId::Integer(id)),
+    )
+    .await??;
+    Ok(())
+}
