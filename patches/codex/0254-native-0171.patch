+#[tokio::test]
+async fn bounded_websocket_waits_for_sender_then_rechecks_before_publication() -> anyhow::Result<()>
+{
+    use codex_api::ResponseCreateWsRequest;
+    use codex_api::ResponsesApiRequest;
+    use codex_api::ResponsesWsRequest;
+    use futures::SinkExt;
+    use futures::StreamExt;
+    use std::sync::atomic::AtomicBool;
+    use std::sync::atomic::Ordering;
+    use tokio_tungstenite::tungstenite::Message;
+    fn request(model: &str) -> ResponsesApiRequest {
+        ResponsesApiRequest {
+            model: model.into(),
+            input: vec![],
+            tools: None,
+            tool_choice: "auto".into(),
+            parallel_tool_calls: false,
+            reasoning: None,
+            store: false,
+            stream: true,
+            stream_options: None,
+            include: vec![],
+            service_tier: None,
+            prompt_cache_key: None,
+            prompt_cache_options: None,
+            text: None,
+            access_programs: None,
+            client_metadata: None,
+            request_country: Default::default(),
+        }
+    }
+    let listener = TcpListener::bind("127.0.0.1:0").await?;
+    let address = listener.local_addr()?;
+    let (entered_tx, entered_rx) = tokio::sync::oneshot::channel();
+    let (release_tx, release_rx) = tokio::sync::oneshot::channel();
+    let server = tokio::spawn(async move {
+        let (socket, _) = listener.accept().await?;
+        let mut socket = tokio_tungstenite::accept_async(socket).await?;
+        let first = socket.next().await.expect("initial request")?;
+        assert!(first.to_text()?.contains("first-control"));
+        entered_tx.send(()).unwrap();
+        release_rx.await?;
+        socket.send(Message::text(r#"{"type":"response.completed","response":{"id":"first","usage":{"input_tokens":1,"output_tokens":1,"total_tokens":2}}}"#)).await?;
+        let control = socket.next().await.expect("eligible control")?;
+        assert!(
+            control.to_text()?.contains("eligible-control"),
+            "expired bounded request reached provider: {control}"
+        );
+        socket.send(Message::text(r#"{"type":"response.completed","response":{"id":"control","usage":{"input_tokens":1,"output_tokens":1,"total_tokens":2}}}"#)).await?;
+        Ok::<_, anyhow::Error>(())
+    });
+    let client = probe_client(format!("http://{address}"));
+    let connection = Arc::new(
+        client
+            .connect(
+                &HttpClientFactory::new(OutboundProxyPolicy::ReqwestDefault),
+                HeaderMap::new(),
+                HeaderMap::new(),
+                None,
+                None,
+            )
+            .await?,
+    );
+    let first = request("first-control");
+    let _first_stream = connection
+        .stream_request(
+            ResponsesWsRequest::ResponseCreate(ResponseCreateWsRequest::from(&first)),
+            false,
+            None,
+        )
+        .await?;
+    entered_rx.await?;
+    let eligible = Arc::new(AtomicBool::new(true));
+    let clock = Arc::clone(&eligible);
+    let bounded_connection = Arc::clone(&connection);
+    let (started_tx, started_rx) = tokio::sync::oneshot::channel();
+    let bounded = tokio::spawn(async move {
+        let expired = request("expired-bounded");
+        started_tx.send(()).unwrap();
+        bounded_connection
+            .stream_request_with_admission(
+                ResponsesWsRequest::ResponseCreate(ResponseCreateWsRequest::from(&expired)),
+                true,
+                None,
+                Some(Arc::new(move || {
+                    let clock = Arc::clone(&clock);
+                    Box::pin(async move { clock.load(Ordering::SeqCst) })
+                })),
+            )
+            .await
+    });
+    started_rx.await?;
+    tokio::task::yield_now().await;
+    assert!(
+        !bounded.is_finished(),
+        "bounded stream was published before sender admission"
+    );
+    eligible.store(false, Ordering::SeqCst);
