+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn held_queue_admission_never_becomes_input_and_leaves_thread_available() -> anyhow::Result<()>
+{
+    let server = start_mock_server().await;
+    let response =
+        responses::mount_sse_once(&server, responses::sse_completed("control-turn")).await;
+    let (installed, extensions) = registered_queue_extensions();
+    let test = test_codex()
+        .with_extensions(extensions)
+        .build_with_auto_env(&server)
+        .await?;
+    let queue = install_registered_queue(&test, installed.as_ref())?;
+    let (checking, checked) = oneshot::channel();
+    let (release, released) = oneshot::channel();
+    let guard = codex_protocol::turn_input::QueueAdmissionGuard::new(move |_turn_id| {
+        Box::pin(async move {
+            let _ = checking.send(());
+            let _ = released.await;
+            false
+        })
+    });
+    let held = test
+        .codex
+        .start_turn_if_idle(
+            codex_core::TurnInputRequest::new(user_input("held prompt must never reach model"))
+                .with_queue_admission(guard),
+        )
+        .await?;
+    // Turn preparation starts before the final model-request admission check.
+    assert!(matches!(held, StartIfIdleSubmission::Started { .. }));
+    checked.await?;
+    let pending_recovery = test.codex.interrupted_turn().await;
+    let _ = release.send(());
+    wait_for_event_match(test.codex.as_ref(), |event| {
+        matches!(event, EventMsg::TurnComplete(_)).then_some(())
+    })
+    .await;
+    assert!(
+        pending_recovery.is_none(),
+        "unrecorded bounded input must not become daemon recovery work"
+    );
+    assert!(response.requests().is_empty());
+    // Completion notification precedes idle cleanup. The registered queue
+    // lifecycle starts this control only after the real idle transition.
+    queue
+        .enqueue(
+            test.session_configured.thread_id,
+            user_input("unbounded control"),
+        )
+        .await?;
+    wait_for_event_match(test.codex.as_ref(), |event| {
+        matches!(event, EventMsg::TurnComplete(_)).then_some(())
+    })
+    .await;
+    assert_eq!(response.requests().len(), 1);
+    let body = response.requests()[0].body_json().to_string();
+    assert!(!body.contains("held prompt must never reach model"));
+    assert!(body.contains("unbounded control"));
+    Ok(())
