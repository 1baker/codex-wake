+        vec![bounded]
+    );
+}
+
+#[tokio::test]
+async fn native_deadline_selection_uses_qualified_bounds_inside_the_queue_transaction() {
+    let (runtime, thread_id) = runtime_with_thread().await;
+    let queue = runtime.thread_queue();
+    let expired = queue
+        .enqueue_bounded(thread_id, "expired", 100_000_000)
+        .await
+        .unwrap();
+    let result = queue
+        .admit_bounded(&expired, "never-started".to_string(), || async {
+            Some(crate::BoundedQueueClockSample {
+                lower: 100.0,
+                upper: 101.0,
+                evidence: r#"{"source":"controlled-unit-clock"}"#.to_string(),
+            })
+        })
+        .await
+        .unwrap();
+    assert_eq!(result, Some(crate::BoundedQueueStatus::Expired));
+    let outcome = queue
+        .bounded_outcome(thread_id, &expired.id)
+        .await
+        .unwrap()
+        .unwrap();
+    assert_eq!(outcome.status, crate::BoundedQueueStatus::Expired);
+    assert!(
+        queue
+            .list_bounded_page(thread_id, /*offset*/ 0, /*limit*/ 10)
+            .await
+            .unwrap()
+            .is_empty()
+    );
+}
+
+#[tokio::test]
+async fn unknown_or_straddling_time_holds_until_a_fresh_unexpired_observation() {
+    let (runtime, thread_id) = runtime_with_thread().await;
+    let queue = runtime.thread_queue();
+    let item = queue
+        .enqueue_bounded(thread_id, "original", 100_000_000)
+        .await
+        .unwrap();
+    assert_eq!(
+        queue
+            .admit_bounded(&item, "unknown".to_string(), || async { None })
+            .await
+            .unwrap(),
+        None
+    );
+    assert_eq!(
+        queue
+            .admit_bounded(&item, "straddle".to_string(), || async {
+                Some(crate::BoundedQueueClockSample {
+                    lower: 99.0,
+                    upper: 101.0,
+                    evidence: r#"{"source":"controlled-unit-clock"}"#.to_string(),
+                })
+            })
+            .await
+            .unwrap(),
+        None
+    );
+    assert_eq!(
+        queue
+            .list_bounded_page(thread_id, /*offset*/ 0, /*limit*/ 10)
+            .await
+            .unwrap(),
+        vec![item.clone()]
+    );
+    assert_eq!(
+        queue.bounded_outcome(thread_id, &item.id).await.unwrap(),
+        None
+    );
+    assert_eq!(
+        queue
+            .admit_bounded(&item, "control-turn".to_string(), || async {
+                Some(crate::BoundedQueueClockSample {
+                    lower: 98.0,
+                    upper: 99.0,
+                    evidence: r#"{"source":"controlled-unit-clock"}"#.to_string(),
+                })
+            })
+            .await
+            .unwrap(),
+        Some(crate::BoundedQueueStatus::Admitted {
+            turn_id: "control-turn".to_string()
+        })
+    );
+    let outcome = queue
+        .bounded_outcome(thread_id, &item.id)
+        .await
+        .unwrap()
+        .unwrap();
+    assert_eq!(outcome.record, item);
+    let evidence: serde_json::Value =
+        serde_json::from_str(outcome.clock_evidence.as_ref().unwrap()).unwrap();
+    assert_eq!(evidence["lower"], 98.0);
+    assert_eq!(evidence["upper"], 99.0);
+}
+
+#[tokio::test]
+async fn bounded_client_identity_reconciles_pending_and_terminal_without_resubmission() {
+    let (runtime, thread_id) = runtime_with_thread().await;
+    let queue = runtime.thread_queue();
+    let item = queue
+        .enqueue_bounded(
+            thread_id,
+            r#"{"UserInput":{"client_id":"original-client"}}"#,
+            100,
+        )
+        .await
+        .unwrap();
+    assert_eq!(
+        queue
+            .lookup_bounded(
+                thread_id,
+                crate::BoundedQueueSelector::ClientUserMessageId("original-client".to_string())
+            )
+            .await
+            .unwrap(),
+        crate::BoundedQueueLookup::Pending(item.clone())
+    );
+    queue.delete(thread_id, &item.id).await.unwrap();
+    let terminal = queue
+        .bounded_outcome(thread_id, &item.id)
+        .await
+        .unwrap()
+        .unwrap();
+    assert_eq!(
+        queue
+            .lookup_bounded(
+                thread_id,
+                crate::BoundedQueueSelector::ClientUserMessageId("original-client".to_string())
+            )
+            .await
+            .unwrap(),
+        crate::BoundedQueueLookup::Terminal(terminal)
+    );
+    assert_eq!(
+        queue
+            .lookup_bounded(
+                thread_id,
+                crate::BoundedQueueSelector::Id("unknown".to_string())
+            )
+            .await
+            .unwrap(),
+        crate::BoundedQueueLookup::Missing
+    );
+}
